@inject ILogger<Statistics> Logger
@inject AuthenticationStateProvider AuthProvider
@inject HttpClient Http
@attribute [Authorize]

@using System.Security.Claims
@using System.Globalization

@namespace Shared.Dashboard

<div class="statistics-card">
    <p class="statistics-title">@Title</p>

    @if (Data is not null)
    {
        <p class="statistics-value">@Data.Value</p>
        <p class="statistics-description @(Data.Description?.Contains("↓") == true ? "savings-positive" : "")">@(Data.Description ?? "\u00A0")</p>
    }
</div>

@code {

    [Parameter] public DateTime? From { get; set; }
    [Parameter] public DateTime? To { get; set; }
    [Parameter] public StatisticsType Type { get; set; }
    [Parameter] public int? PlanID { get; set; }
    public StatisticsDto? Data { get; set;}

    private DateTime? loadedFrom, loadedTo;
    private bool hasLoaded;
    private StatisticsType loadedType;
    private int? loadedPlanId;
    private int loadVersion;

    private string Title => Type switch
    {
        StatisticsType.PlannedCost => "Planned cost today",                         //Dashboard
        StatisticsType.ScheduleSavingsCost => "Saved cost vs unscheduled",          //Dashboard
        StatisticsType.PlannedCo2 => "Planned Co2 today",                           //Dashboard
        StatisticsType.ScheduleSavingsCo2 => "Saved co2 vs unscheduled",            //Dashboard
        StatisticsType.EstimatedCost => "Estimated cost",                           //Optimized
        StatisticsType.MoneySaved => "You save",                                    //Optimized
        StatisticsType.LoadDuration => "Load Duration",                             //Optimized
        StatisticsType.LoadFinish => "Load finished",                               //Optimized
        _ => "Statistics"
    };

    private bool IsPeriodType => Type is
           StatisticsType.PlannedCost
        or StatisticsType.ScheduleSavingsCost
        or StatisticsType.PlannedCo2
        or StatisticsType.ScheduleSavingsCo2;

    protected override async Task OnParametersSetAsync()
    {
        bool isPeriodType = IsPeriodType;
        if (hasLoaded && loadedType == Type &&
            (isPeriodType ? loadedFrom == From && loadedTo == To : loadedPlanId == PlanID))
            return;

        hasLoaded = true;
        loadedType = Type;
        loadedPlanId = PlanID;
        loadedFrom = From;
        loadedTo = To;
        int version = ++loadVersion;

        StatisticsType type = Type;
        int? planId = PlanID;
        DateTime? from = From;
        DateTime? to = To;

        if (!isPeriodType && planId is null)
        {
            Data = new StatisticsDto { Value = "--", Description = "No plan selected" };
            return;
        }

        Data = null;
        try
        {
            StatisticsDto data = type switch
            {
                StatisticsType.PlannedCost => await GetPeriodStatistic("planned-cost", from, to),
                StatisticsType.ScheduleSavingsCost => await GetPeriodStatistic("schedule-savings-cost", from, to),
                StatisticsType.PlannedCo2 => await GetPeriodStatistic("planned-co2", from, to),
                StatisticsType.ScheduleSavingsCo2 => await GetPeriodStatistic("schedule-savings-c02", from, to),
                StatisticsType.EstimatedCost => await GetStatistic("estimated-cost", planId),
                StatisticsType.MoneySaved => await GetStatistic("money-saved", planId),
                StatisticsType.LoadDuration => await GetStatistic("load-duration", planId),
                StatisticsType.LoadFinish => await GetStatistic("load-finish", planId),
                _ => new StatisticsDto { Value = "--" }
            };

            if (version == loadVersion)
                Data = data;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load statistic {Type} for plan {PlanId}", type, planId);
            if (version == loadVersion)
                Data = new StatisticsDto { Value = "--", Description = "Statistic unavailable" };
        }
    }

    private Task<StatisticsDto> GetPeriodStatistic(string uri, DateTime? from, DateTime? to)
    {
        if (from is null || to is null)
            throw new InvalidOperationException($"{Type} requires From and To.");

        var query = string.Create(CultureInfo.InvariantCulture,
            $"?from={from.Value:yyyy-MM-dd}&to={to.Value:yyyy-MM-dd}");

        return GetStatistic(uri + query, null);
    }

    private async Task<StatisticsDto> GetStatistic(string uri, int? planId)
    {
        AuthenticationState? state = await AuthProvider.GetAuthenticationStateAsync();
        string? userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId))
            throw new InvalidOperationException("The current user could not be identified.");

        using HttpRequestMessage request = new(HttpMethod.Get, "api/statistics-controller/" + uri);
        request.Headers.Add("UserId", userId);
        if (planId.HasValue)
        {
            request.Headers.Add("PlanId", planId.Value.ToString());
        }

        using HttpResponseMessage response = await Http.SendAsync(request);
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<StatisticsDto>() ?? new StatisticsDto();
    }
}

<style>
    .statistics-card {
        background-color: #fff;
        border: 1px solid #e5e2dc;
        border-radius: 12px;
        padding: 20px;

        width: 100%;
        box-sizing: border-box;
        aspect-ratio: 3 / 1;

        display: flex;
        flex-direction: column;
        grid-template-rows: auto 1fr auto;
    }

    .statistics-title {
        margin: 0;
        color: #999;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .statistics-value {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
    }

    .statistics-description {
        margin: 0;
        min-height: 1.2em;
        color: #888;
        font-size: 0.8rem;
    }

    .statistics-value {
        margin: 0;
        font-size: clamp(1.5rem, 2vw, 2rem);
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
        overflow: visible;
    }
    
    .statistics-description,
    .statistics-title {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .savings-positive {
        color: green;
    }
</style>
