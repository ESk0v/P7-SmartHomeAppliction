@inject ILogger<Statistics> Logger
@inject AuthenticationStateProvider AuthProvider
@inject HttpClient Http
@attribute [Authorize]

@using Utilities.Models
@using System.Globalization
@using System.Security.Claims

@namespace Shared.Dashboard

<div class="statistics-card">
    <p class="statistics-title">@Title</p>

    @if (Data is not null)
    {
        <p class="statistics-value">@Data.Value</p>

        @if (Data.Description is not null)
        {
            <p class="statistics-description @DescriptionClass">@Data.Description</p>
        }
    }
</div>

@code {

    [Parameter]
    public StatisticsType Type { get; set; }
    [Parameter]
    public StatisticsDto? OverrideData { get; set; }
    [Parameter]
    public string DescriptionClass { get; set; } = string.Empty;
    public StatisticsDto? Data { get; set;}

    private string Title => Type switch
    {
        StatisticsType.PlannedCost => "Planned cost today",
        StatisticsType.CheapestPeriod => "Cheapest Window",
        StatisticsType.ScheduleSavings => "Saved vs unscheduled",
        StatisticsType.PeakShift => "Load moved off peak",
        StatisticsType.EstimatedCost => "Estimated cost",
        StatisticsType.MoneySaved => "You save",
        StatisticsType.LoadDuration => "Load Duration",
        StatisticsType.LoadFinish => "Load finished",
        _ => "Statistics"
    };

    protected override async Task OnInitializedAsync()
    {
        if (OverrideData is not null)
        {
            Data = OverrideData;
            return;
        }

        Data = Type switch
        {
            StatisticsType.PlannedCost => await GetPlannedCost(),
            StatisticsType.CheapestPeriod => await GetCheapestPeriod(),
            StatisticsType.ScheduleSavings => await GetScheduleSavings(),
            StatisticsType.PeakShift => await GetPeakShift(),
            StatisticsType.EstimatedCost => await GetStatistic("estimated-cost"),
            StatisticsType.MoneySaved => await GetStatistic("money-saved"),
            StatisticsType.LoadDuration => await GetStatistic("load-duration"),
            StatisticsType.LoadFinish => await GetStatistic("load-finish"),
            _ => new StatisticsDto { Value = "Error: No known statistic type given" }
        };
    }

    private async Task<StatisticsDto> GetPlannedCost()
    {
        return await GetUserStatistic("planned-cost");
    }

    private async Task<StatisticsDto> GetCheapestPeriod()
    {
        return await Http.GetFromJsonAsync<StatisticsDto>(
            "api/statistics-controller/cheapest-period"
        ) ?? new StatisticsDto();
    }

    private async Task<StatisticsDto> GetScheduleSavings()
    {
        return await GetUserStatistic("schedule-savings");
    }

    private async Task<StatisticsDto> GetPeakShift()
    {
        return await Http.GetFromJsonAsync<StatisticsDto>(
            "api/statistics-controller/peak-shift"
        ) ?? new StatisticsDto();
    }

    private async Task<StatisticsDto> GetStatistic(string uri)
    {
        return await Http.GetFromJsonAsync<StatisticsDto>("api/statistics-controller/" + uri) ?? new StatisticsDto();
    }

    private async Task<StatisticsDto> GetUserStatistic(string uri)
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(userId))
        {
            Logger.LogWarning("Cannot load statistic '{Statistic}': authenticated user has no name identifier.", uri);
            return new StatisticsDto();
        }

        using var request = new HttpRequestMessage(HttpMethod.Get, "api/statistics-controller/" + uri);
        request.Headers.Add("UserId", userId);

        using var response = await Http.SendAsync(request);
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<StatisticsDto>() ?? new StatisticsDto();
    }

}

<style>
    .statistics-card {
        background-color: #fff;
        border: 1px solid #e5e2dc;
        border-radius: 12px;
        padding: 20px;

        width: 100%;
        box-sizing: border-box;
        aspect-ratio: 3 / 1;

        display: flex;
        flex-direction: column;
        grid-template-rows: auto 1fr auto;
    }

    .statistics-title {
        margin: 0;
        color: #999;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .statistics-value {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
    }

    .statistics-description {
        margin: 0;
        min-height: 1.2em;
        color: #888;
        font-size: 0.8rem;
    }

    .statistics-value,
    .statistics-description,
    .statistics-title {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .statistics-description.positive {
        color: #159447;
    }
</style>