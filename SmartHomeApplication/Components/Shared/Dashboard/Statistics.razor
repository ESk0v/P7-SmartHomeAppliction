@inject ILogger<Statistics> Logger
@inject HttpClient Http

@using Utilities.Models
@using System.Globalization

@namespace Shared.Dashboard

<div class="statistics-card">
    <p class="statistics-title">@Title</p>

    @if (Data is not null)
    {
        <p class="statistics-value">@Data.Value</p>

        @if (Data.Description is not null)
        {
            <p class="statistics-description">@Data.Description</p>
        }
    }
</div>

@code {

    [Parameter]
    public StatisticsType Type { get; set; }
    [Parameter]
    public StatisticsDto? OverrideData { get; set; }
    public StatisticsDto? Data { get; set;}

    private string Title => Type switch
    {
        StatisticsType.PlannedCost => "Planned cost today",
        StatisticsType.CheapestPeriod => "Cheapest Window",
        StatisticsType.ScheduleSavings => "Saved vs unscheduled",
        StatisticsType.PeakShift => "Load moved off peak",
        StatisticsType.EstimatedCost => "Estimated cost",
        StatisticsType.MoneySaved => "You save",
        StatisticsType.LoadDuration => "Load Duration",
        StatisticsType.LoadFinish => "Load finished",
        _ => "Statistics"
    };

    protected override async Task OnInitializedAsync()
    {
        if (OverrideData is not null)
        {
            Data = OverrideData;
            return;
        }

        Data = Type switch
        {
            StatisticsType.PlannedCost => await GetStatistic("planned-cost"),
            StatisticsType.CheapestPeriod => await GetStatistic("cheapest-period"),
            StatisticsType.ScheduleSavings => await GetStatistic("schedule-savings"),
            StatisticsType.PeakShift => await GetStatistic("peak-shift"),
            StatisticsType.EstimatedCost => await GetStatistic("estimated-cost"),
            StatisticsType.MoneySaved => await GetStatistic("money-saved"),
            StatisticsType.LoadDuration => await GetStatistic("load-duration"),
            StatisticsType.LoadFinish => await GetStatistic("load-finish"),
            _ => new StatisticsDto {Value = "Error: No known statistic type given"}

        };
    }

    protected override void OnParametersSet()
    {
        if (OverrideData is not null)
        {
            Data = OverrideData;
        }
    }

    private async Task<StatisticsDto> GetStatistic(string uri)
    {
        return await Http.GetFromJsonAsync<StatisticsDto>("api/statistics-controller/" + uri) ?? new StatisticsDto();
    }
}

<style>
    .statistics-card {
        background-color: #fff;
        border: 1px solid #e5e2dc;
        border-radius: 12px;
        padding: 20px;

        width: 100%;
        box-sizing: border-box;
        aspect-ratio: 3 / 1;

        display: flex;
        flex-direction: column;
        grid-template-rows: auto 1fr auto;
    }

    .statistics-title {
        margin: 0;
        color: #999;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .statistics-value {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
    }

    .statistics-description {
        margin: 0;
        min-height: 1.2em;
        color: #888;
        font-size: 0.8rem;
    }

    .statistics-value,
    .statistics-description,
    .statistics-title {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>