@inject ILogger<Statistics> Logger
@inject AuthenticationStateProvider AuthProvider
@inject HttpClient Http
@attribute [Authorize]

@using System.Security.Claims
@using System.Globalization

@namespace Shared.Dashboard

<div class="statistics-card">
    <p class="statistics-title">@Title</p>

    @if (Data is not null)
    {
        <p class="statistics-value">@Data.Value</p>
        <p class="statistics-description @(Data.Description?.Contains("↓") == true ? "savings-positive" : "")">@(Data.Description ?? "\u00A0")</p>
    }
</div>

@code {

    [Parameter] public DateTime? From { get; set; }
    [Parameter] public DateTime? To { get; set; }
    [Parameter] public StatisticsType Type { get; set; }
    public StatisticsDto? Data { get; set;}

    private DateTime? loadedFrom, loadedTo;

    private string Title => Type switch
    {
        StatisticsType.PlannedCost => "Planned cost today",                         //Dashboard
        StatisticsType.ScheduleSavingsCost => "Saved cost vs unscheduled",          //Dashboard
        StatisticsType.PlannedCo2 => "Planned Co2 today",                           //Dashboard
        StatisticsType.ScheduleSavingsCo2 => "Saved co2 vs unscheduled",            //Dashboard
        StatisticsType.EstimatedCost => "Estimated cost",                           //Optimized
        StatisticsType.MoneySaved => "You save",                                    //Optimized
        StatisticsType.LoadDuration => "Load Duration",                             //Optimized
        StatisticsType.LoadFinish => "Load finished",                               //Optimized
        _ => "Statistics"
    };

    private bool IsPeriodType => Type is 
           StatisticsType.PlannedCost
        or StatisticsType.ScheduleSavingsCost
        or StatisticsType.PlannedCo2
        or StatisticsType.ScheduleSavingsCo2;

    protected override async Task OnInitializedAsync()
    {
        if (IsPeriodType) return;

        Data = Type switch
        {
            StatisticsType.EstimatedCost => await GetStatistic("estimated-cost"),
            StatisticsType.MoneySaved => await GetStatistic("money-saved"),
            StatisticsType.LoadDuration => await GetStatistic("load-duration"),
            StatisticsType.LoadFinish => await GetStatistic("load-finish"),
            _ => null
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsPeriodType) return;
        if (loadedFrom == From && loadedTo == To) return;   // period unchanged

        loadedFrom = From;
        loadedTo = To;

        Data = Type switch
        {
            StatisticsType.PlannedCost => await GetPeriodStatistic("planned-cost"),
            StatisticsType.ScheduleSavingsCost => await GetPeriodStatistic("schedule-savings-cost"),
            StatisticsType.PlannedCo2 => await GetPeriodStatistic("planned-co2"),
            StatisticsType.ScheduleSavingsCo2 => await GetPeriodStatistic("schedule-savings-c02"),
            _ => null
        };
    }

    private Task<StatisticsDto> GetPeriodStatistic(string uri)
    {
        if (From is null || To is null)
            throw new InvalidOperationException($"{Type} requires From and To.");

        var query = string.Create(CultureInfo.InvariantCulture,
            $"?from={From.Value:yyyy-MM-dd}&to={To.Value:yyyy-MM-dd}");

        return GetStatistic(uri + query);
    }

    private async Task<StatisticsDto> GetStatistic(string uri)
    {
        AuthenticationState? state = await AuthProvider.GetAuthenticationStateAsync();
        string? userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);

        HttpRequestMessage? request = new HttpRequestMessage(HttpMethod.Get, "api/statistics-controller/" + uri);
        request.Headers.Add("UserId", userId);

        HttpResponseMessage? response = await Http.SendAsync(request);
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<StatisticsDto>() ?? new StatisticsDto();
    }
}

<style>
    .statistics-card {
        background-color: #fff;
        border: 1px solid #e5e2dc;
        border-radius: 12px;
        padding: 20px;

        width: 100%;
        box-sizing: border-box;
        aspect-ratio: 3 / 1;

        display: flex;
        flex-direction: column;
        grid-template-rows: auto 1fr auto;
    }

    .statistics-title {
        margin: 0;
        color: #999;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .statistics-value {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
    }

    .statistics-description {
        margin: 0;
        min-height: 1.2em;
        color: #888;
        font-size: 0.8rem;
    }

    .statistics-value {
        margin: 0;
        font-size: clamp(1.5rem, 2vw, 2rem);
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
        overflow: visible;
    }
    
    .statistics-description,
    .statistics-title {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .savings-positive {
        color: green;
    }
</style>