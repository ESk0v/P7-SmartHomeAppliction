@inject ILogger<PriceChart> Logger
@inject HttpClient Http
@inject AuthenticationStateProvider AuthProvider
@inject SmartHomeApplication.State.ChartMetricPreference MetricPreference

@using Utilities.Models
@using System.Globalization
@using System.Security.Claims
@using Utilities.Security

@namespace Shared.Dashboard
<section class="chart-card" style="@ZeroLineStyle" aria-label="@ChartTitle">
    <div class="chart-content">
        <div class="chart-header">
            <div class="chart-title-group">
                <h2 class="chart-title">@ChartTitle</h2>
                <button type="button" class="chart-metric-toggle" role="switch"
                        aria-label="Show CO₂ emissions instead of electricity prices" aria-checked="@(showCo2 ? "true" : "false")"
                        title="@(showCo2 ? "Switch to electricity prices" : "Switch to CO₂ emissions")"
                        @onclick="ToggleMetric">
                    <span class="chart-metric-indicator" aria-hidden="true"></span>
                    <span class="chart-metric-icon chart-metric-price" aria-hidden="true"><i class="bi @ScheduleIcons.Price"></i></span>
                    <span class="chart-metric-icon chart-metric-co2" aria-hidden="true"><i class="bi @ScheduleIcons.Co2"></i></span>
                </button>
                <span class="chart-unit">@Unit</span>
            </div>
            <div class="legend-container" @onkeydown="@(e => { if (e.Key == "Escape") isLegendExpanded = false; })">
                <div class="legend">
                    @if (!showCo2 && prices.Any(p => p.IsPredicted))
                    {
                        <span class="predicted-price-key">
                            <span class="predicted-price-marker" aria-hidden="true"></span>
                            Predicted price
                        </span>
                    }
                    @foreach (PlanRow row in VisibleLegendRows)
                    {
                        <span class="schedulename-overview" title="@row.Head.planName">
                            <span class="legend-dot" style="background-color:@row.Head.colorCode"></span>
                            <span class="legend-name">@row.Head.planName</span>
                        </span>
                    }
                    @if (HiddenLegendCount > 0)
                    {
                        <button type="button" class="legend-more" aria-expanded="@(isLegendExpanded ? "true" : "false")" @onclick="ToggleLegend">
                            @(isLegendExpanded ? "Close plans" : $"+ {HiddenLegendCount} more")
                        </button>
                    }
                </div>
                @if (isLegendExpanded && HiddenLegendCount > 0)
                {
                    <div class="legend-popover">
                        @foreach (PlanRow row in rows)
                        {
                            <span class="legend-popover-item" title="@row.Head.planName">
                                <span class="legend-dot" style="background-color:@row.Head.colorCode"></span>
                                <span class="legend-name">@row.Head.planName</span>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        @if (error is not null)
        {
            <p role="alert">Chart data could not be loaded. Please reload to try again.</p>
        }
        else if (isLoading)
        {
            <p role="status">Loading chart data…</p>
        }
        else if (prices.Count == 0)
        {
            <p role="status">No electricity prices are available.</p>
        }
        else if (showCo2 && prices.All(p => p.Co2EmissionGramsPerKwh is null))
        {
            <p class="chart-data-message" role="status">CO₂ data is unavailable for the displayed hours.</p>
        }
        <div class="chart-uppersection" data-chart role="group" aria-label="@($"{ChartTitle}, {Unit}. Use arrow keys to move between hours.")">
            @foreach (HourPriceDto p in prices)
            {
                <div class="price-column" data-chart-point role="img" tabindex="@(p == prices[0] ? 0 : -1)" aria-label="@PointDescription(p)">
                    <div class="price-tooltip" aria-hidden="true">
                        @{
                            List<PlanDto> overlappingSchedules = GetSchedulesForHour(p.Hour);
                        }
                        <div class="price-tooltip-content">
                            <span>@p.Hour.Hour:00 - @ValueDescription(p)</span>
                            @if (overlappingSchedules.Count > 1)
                            {
                                <span class="price-tooltip-overlap">
                                    @foreach (PlanDto schedule in overlappingSchedules)
                                    {
                                        <span class="legend-dot tooltip-plan-dot"
                                              title="@schedule.planName"
                                              style="background-color:@schedule.colorCode"></span>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                    <div class="price-bar-area">
                        @foreach (decimal tick in Ticks.Where(tick => tick >= MinValue))
                        {
                            <span class="price-gridline @(tick == 0 ? "price-gridline-zero" : tick == MaxValue || tick == MinValue ? "price-gridline-edge" : null)" style="@GridLineStyle(tick)" aria-hidden="true">
                                @if (p == prices[0])
                                {
                                    <span class="price-axis-label">@tick</span>
                                }
                            </span>
                        }
                        @if (GetValue(p) is decimal value)
                        {
                            <div class="price-bar @(value < 0 ? "price-bar-negative" : null) @(!showCo2 && p.IsPredicted ? "price-bar-predicted" : null)" style="@BarStyle(p)">
                                @if (value > MaxValue || value < MinValue)
                                {
                                    <span class="price-overflow-marker @(value > MaxValue ? "price-overflow-high" : "price-overflow-low")" aria-hidden="true">@(value > MaxValue ? "↑" : "↓")</span>
                                }
                            </div>
                        }
                    </div>

                    <span class="price-label">@p.Hour.Hour</span>
                </div>
            }
        </div>

        <div class="chart-card-divider"></div>

        <div class="chart-lowersection" tabindex="0" role="region" aria-label="Schedule timeline">
            @foreach (PlanRow row in rows)
            {
                <div class="plan-row">
                    <span class="plan-name" title="@row.Head.planName">@row.Head.planName</span>
                    <div class="plan-track" aria-hidden="true">
                        @foreach (PlanDto seg in row.Segments)
                        {
                            <div class="plan-fill" style="@FillStyle(seg)"></div>
                        }
                    </div>
                    <span class="plan-time">
                        @row.Segments.Min(s => s.startTime).ToString("HH:mm") - @row.Segments.Max(s => s.endTime).ToString("HH:mm")
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public List<PlanDto> activeSchedules { get; set; } = new List<PlanDto>();
    [Parameter] public int MaxDisplayedPrices { get; set; } = 0;
    [Parameter] public PlanDto? SelectedPlan { get; set; }

    private List<HourPriceDto> prices = new List<HourPriceDto>();
    private bool showCo2;
    private bool preferredShowCo2;
    private string userId = "anonymous";
    private int? metricPlanId;

    private async Task ToggleMetric()
    {
        preferredShowCo2 = showCo2 = !showCo2;
        await MetricPreference.SetAsync(userId, showCo2);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        preferredShowCo2 = await MetricPreference.GetAsync(userId);
        if (SelectedPlan is null)
        {
            showCo2 = preferredShowCo2;
            StateHasChanged();
        }
    }
    private string ChartTitle => showCo2 ? "CO₂ forecast and schedule" : "Price forecast and schedule";
    private string Unit => showCo2 ? "g CO₂/kWh" : "kr/kWh";
    private decimal? GetValue(HourPriceDto point) => showCo2 ? point.Co2EmissionGramsPerKwh : point.Price;
    private decimal MinValue => !showCo2 && prices.Any(p => p.Price < 0) ? -1m : 0m;
    private decimal MaxValue => showCo2 ? 400m : 7m; // Fixed scales keep days comparable.
    private static readonly decimal[] PriceTicks = [-1m, 0m, 2m, 4m, 6m];
    private static readonly decimal[] Co2Ticks = [0m, 100m, 200m, 300m];
    private IEnumerable<decimal> Ticks => showCo2 ? Co2Ticks : PriceTicks;
    private string ZeroLineStyle => string.Create(CultureInfo.InvariantCulture,
        $"--price-zero:{MaxValue / (MaxValue - MinValue) * 100:0.##}%");
    private string GridLineStyle(decimal value) => string.Create(CultureInfo.InvariantCulture,
        $"top:{(MaxValue - value) / (MaxValue - MinValue) * 100:0.##}%");
    private bool isLoading = true;
    private string? error;
    private string ValueDescription(HourPriceDto point)
    {
        if (GetValue(point) is not decimal value) return "CO₂ data unavailable";
        string source = showCo2 ? "CO₂ forecast" : point.IsPredicted ? "Predicted price" : "Published price";
        string clipped = value > MaxValue ? " · Above chart maximum" : value < MinValue ? " · Below chart minimum" : "";
        return $"{value.ToString("0.####", CultureInfo.CurrentCulture)} {Unit} · {source}{clipped}";
    }
    private string PointDescription(HourPriceDto point)
    {
        string schedules = string.Join(", ", GetSchedulesForHour(point.Hour).Select(plan => plan.planName).Distinct());
        return $"{point.Hour:ddd d MMM yyyy HH:mm}, {ValueDescription(point)}{(schedules.Length > 0 ? $", schedules: {schedules}" : "")}";
    }

    private record PlanRow(PlanDto Head, List<PlanDto> Segments);
    private List<PlanRow> rows = new List<PlanRow>();
    private bool isLegendExpanded;

    private IEnumerable<PlanRow> VisibleLegendRows => rows.Take(3);

    private int HiddenLegendCount => Math.Max(0, rows.Count - 3);

    private void ToggleLegend()
    {
        isLegendExpanded = !isLegendExpanded;
    }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState? state = await AuthProvider.GetAuthenticationStateAsync();
            userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "anonymous";
            string area = state.User.FindFirstValue(CustomClaimTypes.PriceArea) ?? "DK1";
            prices = await Http.GetFromJsonAsync<List<HourPriceDto>>(
                $"api/electricity-price-controller/dashboard-showcase?areaCode={area}") ?? new List<HourPriceDto>();
            if (MaxDisplayedPrices > 0)
            {
                prices = prices.Take(MaxDisplayedPrices).ToList();
            }
            if (prices.Count > 0)
            {
                Logger.LogInformation("Prices from {First} to {Last}, count {Count}",
                    prices.Min(p => p.Hour), prices.Max(p => p.Hour), prices.Count);
            }
        }

        catch (Exception ex)
        {
            error = $"{ex.GetType().Name}: {ex.Message} (base address: {Http.BaseAddress})";
            Logger.LogError(ex, "Failed to load electricity prices");
        }
        finally { isLoading = false; }
    }

protected override void OnParametersSet()
{
    // Reapply the objective only when selecting another plan, allowing manual overrides.
    if (SelectedPlan?.planId != metricPlanId)
    {
        metricPlanId = SelectedPlan?.planId;
        showCo2 = SelectedPlan is null ? preferredShowCo2
            : string.Equals(SelectedPlan.optimizationObjective, "Greenest", StringComparison.OrdinalIgnoreCase);
    }

    Dictionary<int, PlanDto>? byId = activeSchedules.ToDictionary(p => p.planId);
    HashSet<int>? followers = activeSchedules
        .Where(p => p.nextPlanId.HasValue)
        .Select(p => p.nextPlanId!.Value)
        .ToHashSet();

    rows = activeSchedules
        .Where(p => !followers.Contains(p.planId))
        .Select(head =>
        {
            List<PlanDto>? segments = new List<PlanDto>();
            HashSet<int>? visited = new HashSet<int>();
            PlanDto? current = head;

            while (current != null && visited.Add(current.planId))
            {
                segments.Add(current);
                current = current.nextPlanId is int id && byId.TryGetValue(id, out PlanDto? next)
                    ? next : null;
            }

            return new PlanRow(head, segments);
        })
        .ToList();
}
    private string FillStyle(PlanDto schedule)
    {
        if (prices.Count == 0)
        {
            return "display:none";
        }

        DateTime now = DateTime.Now;

        DateTime first = prices.Min(p => p.Hour);
        DateTime last = prices.Max(p => p.Hour);
        DateTime firstStart = first.Date.AddHours(first.Hour);
        DateTime chartEnd = last.Date.AddHours(last.Hour).AddHours(1);

        DateTime origin = now > firstStart ? now : firstStart;

        double totalHours = (chartEnd - origin).TotalHours;

        if (schedule.endTime <= origin || totalHours <= 0)
        {
            return "display:none";
        }

        DateTime start = schedule.startTime > origin ? schedule.startTime : origin;
        DateTime end = schedule.endTime < chartEnd ? schedule.endTime : chartEnd;

        if (end <= start)
        {
            return "display:none";
        }

        double left = (start - origin).TotalHours / totalHours * 100;
        double width = (end - start).TotalHours / totalHours * 100;

        left = Math.Clamp(left, 0, 100);
        width = Math.Clamp(width, 0, 100 - left);

        return string.Create(CultureInfo.InvariantCulture,
            $"left:{left:0.##}%;width:{width:0.##}%;background-color:{schedule.colorCode}");
    }

    private string BarStyle(HourPriceDto p)
    {
        if (GetValue(p) is not decimal value) return "display:none";
        decimal height = Math.Abs(Math.Clamp(value, MinValue, MaxValue)) / (MaxValue - MinValue) * 100;
        string? style = string.Create(CultureInfo.InvariantCulture, $"height:{height:0.##}%");
        if (value == 0)
            style += ";min-height:0";

        List<PlanDto>? schedules = GetSchedulesForHour(p.Hour);
        string? color = schedules.FirstOrDefault()?.colorCode;
        if (!string.IsNullOrWhiteSpace(color))
        {
            style += $";background-color:{color}";
        }

        if (schedules.Count > 1)
        {
            style += ";background-image:repeating-linear-gradient(135deg, rgba(255,255,255,0.3) 0, rgba(255,255,255,0.3) 3px, transparent 3px, transparent 7px)";
        }

        return style;
    }

    private List<PlanDto> GetSchedulesForHour(DateTime hour)
    {
        DateTime hourStart = hour.Date.AddHours(hour.Hour);
        DateTime hourEnd = hourStart.AddHours(1);

        return activeSchedules
            .Where(s => s.startTime < hourEnd && s.endTime > hourStart)
            .ToList();
    }

}

<style>
    .chart-card {
        --name-col: 140px;
        --time-col: 110px;
        --col-gap: 1rem;

        --scrollbar-w: 6px;
        --scrollbar-gap: 6px;

        height: 100%;
        max-width: 100%;
        min-width: 0;
        width: 100%;
        box-sizing: border-box;

        background-color: #fff;
        border: 1px solid #e5e2dc;
        border-radius: 12px;
        padding: 20px;
    }

    .chart-content {
        height: 100%;
        display: flex;
        flex-direction: column;
        min-width: 0;
        width: 100%;
    }

    .chart-header {
        flex: 0 0 12%;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        min-width: 0;
    }

    .chart-title-group {
        min-width: 0;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.35rem 0.65rem;
    }

    .chart-metric-toggle {
        position: relative;
        display: inline-grid;
        grid-template-columns: repeat(2, 1fr);
        flex-shrink: 0;
        width: 5.5rem;
        height: 36px;
        padding: 3px;
        border: 1px solid #d7e4f2;
        border-radius: 999px;
        background: #eef4fa;
        color: #465a70;
        font: inherit;
        cursor: pointer;
        transition: background-color 180ms ease;
    }

    .chart-metric-indicator {
        position: absolute;
        top: 3px;
        bottom: 3px;
        left: 3px;
        width: calc(50% - 3px);
        border-radius: 999px;
        background: #0a66c3;
        box-shadow: 0 2px 5px rgba(10, 102, 195, 0.2);
        transition: transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
        pointer-events: none;
    }

    .chart-metric-icon {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        transition: color 180ms ease;
        pointer-events: none;
    }

    .chart-metric-toggle[aria-checked="true"] .chart-metric-indicator { transform: translateX(100%); }
    .chart-metric-toggle[aria-checked="false"] .chart-metric-price,
    .chart-metric-toggle[aria-checked="true"] .chart-metric-co2 { color: #fff; }
    .chart-metric-toggle:hover { background: #dae9f7; }
    .chart-metric-toggle:focus-visible { outline: 2px solid #0a66c3; outline-offset: 3px; }
    .chart-unit, .chart-data-message { color: #6b6761; font-size: 0.75rem; }
    .chart-data-message { margin: 0; }

    .chart-title {
        font-size: inherit;
        font-weight: inherit;
        margin: 0;
        flex: 0 1 auto;
        min-width: 0;
        white-space: nowrap;
    }

    .legend-container {
        flex: 0 1 65%;
        min-width: 0;
        position: relative;
    }

    .legend {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem 1.5vw;
        justify-content: flex-end;
        min-width: 0;
        overflow: hidden;
    }

    .schedulename-overview {
        display: inline-flex;
        align-items: center;
        gap: 0.3vw;
        font-size: 12px;
        max-width: 11rem;
        white-space: nowrap;
    }

    .legend-name {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .predicted-price-key {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 12px;
        white-space: nowrap;
    }

    .predicted-price-marker {
        width: 12px;
        height: 12px;
        border: 1px dashed #746f68;
        border-radius: 2px;
        flex-shrink: 0;
    }

    .legend-more {
        background: transparent;
        border: 0;
        color: #0a66c3;
        cursor: pointer;
        font: inherit;
        font-size: 12px;
        padding: 0;
        white-space: nowrap;
    }

    .legend-popover {
        background: #fff;
        border: 1px solid #e5e2dc;
        border-radius: 8px;
        box-shadow: 0 8px 20px rgba(34, 34, 34, 0.14);
        display: grid;
        gap: 0.55rem;
        max-width: min(22rem, 80vw);
        padding: 0.75rem;
        position: absolute;
        right: 0;
        top: calc(100% + 0.5rem);
        width: max-content;
        z-index: 20;
    }

    .legend-popover-item {
        align-items: center;
        display: inline-flex;
        gap: 0.4rem;
        max-width: 20rem;
        min-width: 0;
        white-space: nowrap;
    }

    .legend-more:hover,
    .legend-more:focus-visible {
        color: #084f98;
        text-decoration: underline;
    }

    .legend-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .chart-uppersection {
        --price-gap: 10px;
        flex: 3.5 1 0;
        min-height: 0;
        min-width: 0;
        width: 100%;
        margin: 0;
        display: flex;
        align-items: stretch;
        justify-content: space-between;
        gap: var(--price-gap);
        padding-left: 1.25rem;
    }

    .chart-card-divider {
        flex: 0 0 auto;
        width: 100%;
        border: 1px solid #e5e2dc;
        border-radius: 12px;
        margin: 1.5vh 0;
    }

    .chart-lowersection {
        flex: 1.5 1 0;
        min-height: 0;
        min-width: 0;
        overflow-y: auto;
        overflow-x: hidden;
        margin-right: calc(-1 * (var(--scrollbar-w) + var(--scrollbar-gap)));
        padding-right: var(--scrollbar-gap);
        scrollbar-width: thin;
        scrollbar-color: #cfcbc3 transparent;
    }

    .chart-lowersection::-webkit-scrollbar {
        width: var(--scrollbar-w);
    }

    .chart-lowersection::-webkit-scrollbar-thumb {
        background-color: #cfcbc3;
        border-radius: 3px;
    }

    .chart-lowersection::-webkit-scrollbar-track {
        background: transparent;
    }

    .plan-row {
        display: flex;
        align-items: center;
        gap: var(--col-gap);
        min-width: 0;
        padding: 0.5vh 0;
    }

    .plan-name {
        flex: 0 0 var(--name-col);
        font-size: 12px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .plan-track {
        position: relative;
        overflow: hidden;
        flex: 1 1 0;
        min-width: 0;
        height: 10px;
        background-color: #e5e2dc;
        border-radius: 6px;
    }

    .plan-fill {
        position: absolute;
        top: 0;
        bottom: 0;
        min-width: 4px;
        border-radius: 6px;
    }

    .plan-time {
        flex: 0 0 var(--time-col);
        text-align: right;
        font-size: 12px;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .price-column {
        flex: 1;
        min-width: 0;
        height: auto;
        display: flex;
        flex-direction: column;
        align-items: stretch;
    }

    .price-bar-area {
        position: relative;
        flex: 1 1 0;
        min-height: 0;
        width: 100%;
        height: auto;
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    .price-gridline {
        position: absolute;
        left: calc(var(--price-gap) / -2);
        right: calc(var(--price-gap) / -2);
        border-top: 1px solid #f3f1ee;
        pointer-events: none;
        z-index: 0;
    }

    .price-gridline-zero { border-color: #9a9691; z-index: 1; }
    .price-gridline-edge { border: 0; }

    .price-column:first-child .price-gridline { left: 0; }
    .price-column:last-child .price-gridline { right: 0; }

    .price-axis-label {
        position: absolute;
        top: 0;
        right: calc(100% + 0.5rem);
        transform: translateY(-50%);
        color: #6b6761;
        font-size: 0.65rem;
        line-height: 1;
    }

    .price-bar {
        position: absolute;
        bottom: calc(100% - var(--price-zero));
        width: 100%;
        background-color: #e5e2dc;
        border-radius: 6px 6px 0 0;
        min-height: 2px;
    }

    .price-bar-negative {
        top: var(--price-zero);
        bottom: auto;
        border-radius: 0 0 6px 6px;
    }

    .price-overflow-marker {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        color: #242321;
        font-size: 14px;
        font-weight: 700;
        line-height: 1;
        text-shadow: 0 0 2px #fff;
    }

    .price-overflow-high { top: 0; }
    .price-overflow-low { bottom: 0; }

    .price-bar-predicted {
        outline: 1px dashed #746f68;
        outline-offset: -1px;
    }

    .price-label {
        flex: 0 0 auto;
        text-align: center;
        margin-top: 8px;
        font-size: 12px;
    }

    .price-column {
        position: relative;
    }

    .price-tooltip {
        display: none;
        width: max-content;
        max-width: calc(100vw - 2rem);
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);

        background-color: #373737;
        color: white;
        padding: 6px 10px;
        border-radius: 6px;

        font-size: 12px;
        white-space: normal;

        opacity: 0;
        visibility: hidden;
        transition: opacity 0.4s ease;

        z-index: 10;
    }

    .price-tooltip-content,
    .price-tooltip-overlap {
        align-items: center;
        display: flex;
        gap: 0.35rem;
    }

    .tooltip-plan-dot {
        height: 7px;
        width: 7px;
    }

    .price-column:not(.tooltip-dismissed):is(:hover, :focus) .price-tooltip {
        display: block;
        opacity: 1;
        visibility: visible;
    }

    @@media (min-width: 961px) {
        .chart-card {
            --name-col: clamp(8rem, 12vw, 12rem);
            container-type: inline-size;
