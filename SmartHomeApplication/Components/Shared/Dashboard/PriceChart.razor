@inject ILogger<PriceChart> Logger
@inject HttpClient Http

@using Utilities.Models
@using System.Globalization

@namespace Shared.Dashboard
<div class="chart-card">
    <div class="chart-content">
        <div class="chart-header">
            <span class="chart-title">Price forecast and schedule</span>
            <div class="legend-container">
                <div class="legend">
                    @foreach (PlanRow row in VisibleLegendRows)
                    {
                        <span class="schedulename-overview" title="@row.Head.planName">
                            <span class="legend-dot" style="background-color:@row.Head.colorCode"></span>
                            <span class="legend-name">@row.Head.planName</span>
                        </span>
                    }
                    @if (HiddenLegendCount > 0)
                    {
                        <button type="button" class="legend-more" @onclick="ToggleLegend">
                            @(isLegendExpanded ? "Close plans" : $"+ {HiddenLegendCount} more")
                        </button>
                    }
                </div>
                @if (isLegendExpanded && HiddenLegendCount > 0)
                {
                    <div class="legend-popover">
                        @foreach (PlanRow row in rows)
                        {
                            <span class="legend-popover-item" title="@row.Head.planName">
                                <span class="legend-dot" style="background-color:@row.Head.colorCode"></span>
                                <span class="legend-name">@row.Head.planName</span>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="chart-uppersection">
            @foreach (HourPriceDto p in prices)
            {
                <div class="price-column">
                    <div class="price-tooltip">
                        @{
                            List<PlanDto> overlappingSchedules = GetSchedulesForHour(p.Hour);
                        }
                        <div class="price-tooltip-content">
                            <span>@p.Hour.Hour:00 - @p.Price.ToString("0.00", CultureInfo.CurrentCulture)</span>
                            @if (overlappingSchedules.Count > 1)
                            {
                                <span class="price-tooltip-overlap">
                                    @foreach (PlanDto schedule in overlappingSchedules)
                                    {
                                        <span class="legend-dot tooltip-plan-dot"
                                              title="@schedule.planName"
                                              style="background-color:@schedule.colorCode"></span>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                    <div class="price-bar-area">
                        <div class="price-bar" style="@BarStyle(p)">
                        </div>
                    </div>

                    <span class="price-label">@p.Hour.Hour</span>
                </div>
            }
        </div>

        <div class="chart-card-divider"></div>

        <div class="chart-lowersection">
            @foreach (PlanRow row in rows)
            {
                <div class="plan-row">
                    <span class="plan-name" title="@row.Head.planName">@row.Head.planName</span>
                    <div class="plan-track">
                        @foreach (PlanDto seg in row.Segments)
                        {
                            <div class="plan-fill" style="@FillStyle(seg)"></div>
                        }
                    </div>
                    <span class="plan-time">
                        @row.Segments.Min(s => s.startTime).ToString("HH:mm") - @row.Segments.Max(s => s.endTime).ToString("HH:mm")
                    </span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public List<PlanDto> activeSchedules { get; set; } = new List<PlanDto>();
    [Parameter] public int MaxDisplayedPrices { get; set; } = 0;

    private List<HourPriceDto> prices = new List<HourPriceDto>();
    private decimal maxPrice;
    private string? error;

    private record PlanRow(PlanDto Head, List<PlanDto> Segments);
    private List<PlanRow> rows = new List<PlanRow>();
    private bool isLegendExpanded;

    private IEnumerable<PlanRow> VisibleLegendRows => rows.Take(3);

    private int HiddenLegendCount => Math.Max(0, rows.Count - 3);

    private void ToggleLegend()
    {
        isLegendExpanded = !isLegendExpanded;
    }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            prices = await Http.GetFromJsonAsync<List<HourPriceDto>>(
                "api/electricity-price-controller/dashboard-showcase?areaCode=DK1") ?? new List<HourPriceDto>();
            if (MaxDisplayedPrices > 0)
            {
                prices = prices.Take(MaxDisplayedPrices).ToList();
            }
            maxPrice = prices.Count > 0 ? prices.Max(p => p.Price) : 0;

            if (prices.Count > 0)
            {
                Logger.LogInformation("Prices from {First} to {Last}, count {Count}",
                    prices.Min(p => p.Hour), prices.Max(p => p.Hour), prices.Count);
            }
        }

        catch (Exception ex)
        {
            error = $"{ex.GetType().Name}: {ex.Message} (base address: {Http.BaseAddress})";
            Logger.LogError(ex, "Failed to load electricity prices");
        }
    }

protected override void OnParametersSet()
{
    Dictionary<int, PlanDto>? byId = activeSchedules.ToDictionary(p => p.planId);
    HashSet<int>? followers = activeSchedules
        .Where(p => p.nextPlanId.HasValue)
        .Select(p => p.nextPlanId!.Value)
        .ToHashSet();

    rows = activeSchedules
        .Where(p => !followers.Contains(p.planId))
        .Select(head =>
        {
            List<PlanDto>? segments = new List<PlanDto>();
            HashSet<int>? visited = new HashSet<int>();
            PlanDto? current = head;

            while (current != null && visited.Add(current.planId))
            {
                segments.Add(current);
                current = current.nextPlanId is int id && byId.TryGetValue(id, out PlanDto? next)
                    ? next : null;
            }

            return new PlanRow(head, segments);
        })
        .ToList();
}
    private string FillStyle(PlanDto schedule)
    {
        if (prices.Count == 0)
        {
            return "display:none";
        }

        DateTime now = DateTime.Now;

        DateTime first = prices.Min(p => p.Hour);
        DateTime last = prices.Max(p => p.Hour);
        DateTime firstStart = first.Date.AddHours(first.Hour);
        DateTime chartEnd = last.Date.AddHours(last.Hour).AddHours(1);

        DateTime origin = now > firstStart ? now : firstStart;

        double totalHours = (chartEnd - origin).TotalHours;

        if (schedule.endTime <= origin || totalHours <= 0)
        {
            return "display:none";
        }

        DateTime start = schedule.startTime > origin ? schedule.startTime : origin;
        DateTime end = schedule.endTime < chartEnd ? schedule.endTime : chartEnd;

        if (end <= start)
        {
            return "display:none";
        }

        double left = (start - origin).TotalHours / totalHours * 100;
        double width = (end - start).TotalHours / totalHours * 100;

        left = Math.Clamp(left, 0, 100);
        width = Math.Clamp(width, 0, 100 - left);

        return string.Create(CultureInfo.InvariantCulture,
            $"left:{left:0.##}%;width:{width:0.##}%;background-color:{schedule.colorCode}");
    }

    private string BarStyle(HourPriceDto p)
    {
        double height = maxPrice > 0 ? (double)(p.Price / maxPrice * 100) : 0;
        string? style = string.Create(CultureInfo.InvariantCulture, $"height:{height:0.##}%");

        List<PlanDto>? schedules = GetSchedulesForHour(p.Hour);
        string? color = schedules.FirstOrDefault()?.colorCode;
        if (!string.IsNullOrWhiteSpace(color))
        {
            style += $";background-color:{color}";
        }

        if (schedules.Count > 1)
        {
            style += ";background-image:repeating-linear-gradient(135deg, rgba(255,255,255,0.3) 0, rgba(255,255,255,0.3) 3px, transparent 3px, transparent 7px)";
        }

        return style;
    }

    private List<PlanDto> GetSchedulesForHour(DateTime hour)
    {
        DateTime hourStart = hour.Date.AddHours(hour.Hour);
        DateTime hourEnd = hourStart.AddHours(1);

        return activeSchedules
            .Where(s => s.startTime < hourEnd && s.endTime > hourStart)
            .ToList();
    }

}

<style>
    .chart-card {
        --name-col: 140px;
        --time-col: 110px;
        --col-gap: 1rem;

        --scrollbar-w: 6px;
        --scrollbar-gap: 6px;

        height: 100%;
        max-width: 100%;
        min-width: 0;
        width: 100%;
        box-sizing: border-box;

        background-color: #fff;
        border: 1px solid #e5e2dc;
        border-radius: 12px;
        padding: 20px;
    }

    .chart-content {
        height: 100%;
        display: flex;
        flex-direction: column;
        min-width: 0;
        width: 100%;
    }

    .chart-header {
        flex: 0 0 12%;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        min-width: 0;
    }

    .chart-title {
        flex: 0 1 auto;
        min-width: 0;
        white-space: nowrap;
    }

    .legend-container {
        flex: 0 1 65%;
        min-width: 0;
        position: relative;
    }

    .legend {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem 1.5vw;
        justify-content: flex-end;
        min-width: 0;
        overflow: hidden;
    }

    .schedulename-overview {
        display: inline-flex;
        align-items: center;
        gap: 0.3vw;
        font-size: 12px;
        max-width: 11rem;
        white-space: nowrap;
    }

    .legend-name {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .legend-more {
        background: transparent;
        border: 0;
        color: #7569e8;
        cursor: pointer;
        font: inherit;
        font-size: 12px;
        padding: 0;
        white-space: nowrap;
    }

    .legend-popover {
        background: #fff;
        border: 1px solid #e5e2dc;
        border-radius: 8px;
        box-shadow: 0 8px 20px rgba(34, 34, 34, 0.14);
        display: grid;
        gap: 0.55rem;
        max-width: min(22rem, 80vw);
        padding: 0.75rem;
        position: absolute;
        right: 0;
        top: calc(100% + 0.5rem);
        width: max-content;
        z-index: 20;
    }

    .legend-popover-item {
        align-items: center;
        display: inline-flex;
        gap: 0.4rem;
        max-width: 20rem;
        min-width: 0;
        white-space: nowrap;
    }

    .legend-more:hover,
    .legend-more:focus-visible {
        color: #5f54c9;
        text-decoration: underline;
    }

    .legend-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .chart-uppersection {
        flex: 3.5 1 0;
        min-height: 0;
        min-width: 0;
        width: 100%;
        margin: 0;
        display: flex;
        align-items: stretch;
        justify-content: space-between;
        gap: 10px;
    }

    .chart-card-divider {
        flex: 0 0 auto;
        width: 100%;
        border: 1px solid #e5e2dc;
        border-radius: 12px;
        margin: 1.5vh 0;
    }

    .chart-lowersection {
        flex: 1.5 1 0;
        min-height: 0;
        min-width: 0;
        overflow-y: auto;
        overflow-x: hidden;
        margin-right: calc(-1 * (var(--scrollbar-w) + var(--scrollbar-gap)));
        padding-right: var(--scrollbar-gap);
        scrollbar-width: thin;
        scrollbar-color: #cfcbc3 transparent;
    }

    .chart-lowersection::-webkit-scrollbar {
        width: var(--scrollbar-w);
    }

    .chart-lowersection::-webkit-scrollbar-thumb {
        background-color: #cfcbc3;
        border-radius: 3px;
    }

    .chart-lowersection::-webkit-scrollbar-track {
        background: transparent;
    }

    .plan-row {
        display: flex;
        align-items: center;
        gap: var(--col-gap);
        min-width: 0;
        padding: 0.5vh 0;
    }

    .plan-name {
        flex: 0 0 var(--name-col);
        font-size: 12px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .plan-track {
        position: relative;
        overflow: hidden;
        flex: 1 1 0;
        min-width: 0;
        height: 10px;
        background-color: #e5e2dc;
        border-radius: 6px;
    }

    .plan-fill {
        position: absolute;
        top: 0;
        bottom: 0;
        min-width: 4px;
        border-radius: 6px;
    }

    .plan-time {
        flex: 0 0 var(--time-col);
        text-align: right;
        font-size: 12px;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .price-column {
        flex: 1;
        min-width: 0;
        height: auto;
        display: flex;
        flex-direction: column;
        align-items: stretch;
    }

    .price-bar-area {
        flex: 1 1 0;
        min-height: 0;
        width: 100%;
        height: auto;
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    .price-bar {
        position: relative;
        width: 100%;
        background-color: #e5e2dc;
        border-radius: 6px 6px 0 0;
        min-height: 2px;
    }

    .price-label {
        flex: 0 0 auto;
        text-align: center;
        margin-top: 8px;
        font-size: 12px;
    }

    .price-column {
        position: relative;
    }

    .price-tooltip {
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);

        background-color: #373737;
        color: white;
        padding: 6px 10px;
        border-radius: 6px;

        font-size: 12px;
        white-space: nowrap;

        opacity: 0;
        visibility: hidden;
        transition: opacity 0.4s ease;

        z-index: 10;
    }

    .price-tooltip-content,
    .price-tooltip-overlap {
        align-items: center;
        display: flex;
        gap: 0.35rem;
    }

    .tooltip-plan-dot {
        height: 7px;
        width: 7px;
    }

    .price-column:hover .price-tooltip {
        opacity: 1;
        visibility: visible;
    }

    @@media (max-width: 640.98px), (max-width: 960px) and (max-height: 500px) and (pointer: coarse) {
        .chart-card {
            height: auto;
            padding: 1rem;
        }

        .chart-card .chart-content {
            height: auto;
            gap: 0.75rem;
        }

        .chart-card .chart-header {
            flex: none;
            flex-direction: column;
            gap: 0.5rem;
        }

        .chart-card .chart-title {
            white-space: normal;
        }

        .chart-card .legend-container {
            flex: none;
            width: 100%;
        }

        .chart-card .legend {
            justify-content: flex-start;
            gap: 0.5rem 0.75rem;
        }

        .chart-card .schedulename-overview {
            max-width: 100%;
            gap: 0.35rem;
        }

        .chart-card .legend-more {
            min-height: 44px;
            padding: 0.5rem;
        }

        .chart-card .legend-popover {
            left: 0;
            right: 0;
            width: auto;
            max-width: 100%;
        }

        .chart-card .legend-popover-item {
            max-width: 100%;
        }

        .chart-card .chart-uppersection {
            flex: none;
            height: 12rem;
            gap: 2px;
        }

        /* Keep every price bar and its original scale; space out hour labels. */
        .chart-card .price-label {
            font-size: 10px;
            visibility: hidden;
        }

        .chart-card .price-column:nth-child(6n + 1) .price-label {
            visibility: visible;
        }

        .chart-card .chart-card-divider {
            margin: 0;
        }

        .chart-card .chart-lowersection {
            flex: none;
            overflow: visible;
            margin: 0;
            padding: 0;
        }

        .chart-card .plan-row {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 0.4rem 0.75rem;
            padding: 0.5rem 0;
        }

        .chart-card .plan-name {
            white-space: normal;
            overflow-wrap: anywhere;
        }

        .chart-card .plan-track {
            grid-column: 1 / -1;
            grid-row: 2;
        }

        .chart-card .price-column:nth-child(-n + 8) .price-tooltip {
            left: 0;
            transform: none;
        }

        .chart-card .price-column:nth-last-child(-n + 8) .price-tooltip {
            left: auto;
            right: 0;
            transform: none;
        }

    }
</style>
