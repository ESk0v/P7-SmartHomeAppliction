@inject ILogger<Schedules> Logger
@inject HttpClient Http

@using System.Globalization
@using Utilities.Models

@namespace Shared.Dashboard

<div class="schedules-card">
    <div class="schedule-top">
        <div class="schedule-title">
            <span aria-hidden="true" class="schedule-icon" style="color: @activeSchedule.colorCode"><i aria-hidden="true" class="bi @ScheduleIcons.Get(activeSchedule.icon)"></i></span>
            <span class="schedule-name">@activeSchedule.planName</span>
        </div>

        <div class="schedule-status @StatusClass">
            <span class="schedule-status-text">@StatusText @activeSchedule.startTime.ToString("HH:mm")</span>
        </div>
    </div>

    <p class="schedule-details">
        @activeSchedule.deviceName
        @if (string.Equals(activeSchedule.deviceCategory, "Interruptible", StringComparison.OrdinalIgnoreCase))
        {
            @if (activeSchedule.chargeStopPercentage is int target)
            {
                <span> · Target @target%</span>
            }
        }
        else if (activeSchedule.presetDurationInMinutes is int duration)
        {
            <span> · @duration min cycle</span>
        }
    </p>

    <div class="schedule-bottom">
        <div class="schedule-progress" role="progressbar" aria-label="@($"{activeSchedule.planName} progress")" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Percent.ToString("0", CultureInfo.InvariantCulture)">
            <div class="schedule-progress-fill" style="@FillStyle()"></div>
        </div>
        <span class="schedule-percent">@Percent.ToString("0", CultureInfo.InvariantCulture)%</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PlanDto activeSchedule { get; set; } = default!;

    private double Percent
    {
        get
        {
            double total = (activeSchedule.endTime - activeSchedule.startTime).TotalSeconds;
            double elapsed = (DateTime.Now - activeSchedule.startTime).TotalSeconds;

            return total > 0 ? Math.Clamp(elapsed / total * 100, 0, 100) : 0;
        }
    }

    private string FillStyle()
    {
        return string.Create(CultureInfo.InvariantCulture,
            $"width:{Percent:0.##}%;background-color:{activeSchedule.colorCode}");
    }

    private enum ScheduleState { Queued, Running }

    private ScheduleState State
    {
        get
        {
            DateTime now = DateTime.Now;

            if (now < activeSchedule.startTime) return ScheduleState.Queued;
            return ScheduleState.Running;
        }
    }

    private string StatusText => State switch
    {
        ScheduleState.Queued => "Queued",
        ScheduleState.Running => "Running",
        _ => ""
    };

    private string StatusTime => State switch
    {
        ScheduleState.Queued => $"at {activeSchedule.startTime:HH:mm}",
        ScheduleState.Running => $"until {activeSchedule.endTime:HH:mm}",
        _ => ""
    };

    private string StatusClass => State.ToString().ToLowerInvariant();
}

<style>
    .schedules-card {
        background-color: #fff;
        border: 1px solid #e5e2dc;
        border-radius: 12px;
        padding: 8px 15px;
        box-sizing: border-box;

        aspect-ratio: 3 / 1;

        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .schedule-details {
        margin: 0;
        color: var(--smarthome-muted);
        font-size: 0.8125rem;
        overflow-wrap: anywhere;
    }

    .schedule-progress {
        position: relative;
        overflow: hidden;
        flex: 1 1 0;      /* takes whatever space the label leaves */
        min-width: 0;
        height: 10px;
        background-color: #e5e2dc;
        border-radius: 6px;
    }

    .schedule-progress-fill {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        border-radius: 6px;
        transition: width 0.3s ease;
    }

    .schedule-percent {
        flex: 0 0 0;   /* fixed width so the bar doesn't jump between 0% and 100% */
        text-align: right;
        font-size: 12px;
        font-variant-numeric: tabular-nums;
    }

    .schedule-bottom {
        display: flex;
        align-items: center;
        gap: 0.8vw;
    }

    .schedule-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .schedule-title {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .schedule-status {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        padding: 1px 10px;
        background-color: #e5e2dc;
        border-radius: 999px;

        &.running {
            background-color: #d6f0dc;
            color: #1f6b35;
        }

        &.queued {
            background-color: #e6dcf5;
            color: #5b3a99;
        }
    }

    .schedule-status-text {
        font-size: 10px;
        white-space: nowrap;
    }

    @@media (min-width: 961px) {
        .schedules-card {
            aspect-ratio: auto;
            min-width: 0;
            min-height: 136px;
            padding: 1.25rem;
            gap: 0.5rem;
            box-shadow: var(--smarthome-card-shadow);
        }

        .schedules-card .schedule-top {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: flex-start;
            gap: 0.75rem;
        }

        .schedules-card .schedule-title {
            min-width: 0;
            font-size: 0.9375rem;
            font-weight: 500;
            overflow-wrap: anywhere;
        }

        .schedules-card .schedule-icon {
            color: inherit;
            flex-shrink: 0;
        }

        .schedules-card .schedule-name {
            min-width: 0;
        }

        .schedules-card .schedule-status {
            padding: 0.25rem 0.6rem;
        }

        .schedules-card .schedule-status-text {
            font-size: 0.7rem;
        }

        .schedules-card .schedule-bottom {
            gap: 0.75rem;
        }

        .schedules-card .schedule-progress {
            height: 6px;
        }

        .schedules-card .schedule-percent {
            flex: 0 0 auto;
            color: var(--smarthome-muted);
        }
    }

    @@media (min-width: 961px) and (max-height: 720px) {
        .schedules-card {
            min-height: 112px;
            padding: 1rem;
            gap: 0.5rem;
        }
    }

    @@media (max-width: 640.98px), (max-width: 960px) and (max-height: 500px) and (pointer: coarse) {
        .schedules-card {
            aspect-ratio: auto;
            min-width: 0;
            gap: 0.75rem;
            padding: 1rem;
        }

        .schedules-card .schedule-top {
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .schedules-card .schedule-title {
            min-width: 0;
            overflow-wrap: anywhere;
        }

        .schedules-card .schedule-bottom {
            gap: 0.75rem;
        }

        .schedules-card .schedule-percent {
            flex: 0 0 auto;
        }

    }
</style>
