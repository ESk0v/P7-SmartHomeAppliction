@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthProvider
@inject OptimizedPlanState PlanState
@inject ILogger<PlanForm> Logger
@inject INotificationService NotificationService

@using System.Globalization
@using System.Security.Claims
@using Utilities.Models
@using global::Shared.Dashboard

@if (loadError is not null)
{
    <div class="alert alert-danger" role="alert">
        @loadError
        @if (IsEditMode)
        {
            <a href="/optimized">Select a plan</a>
        }
    </div>
}
else if (isLoading)
{
    <p role="status">Loading plan details...</p>
}

@if (!isLoading && loadError is null)
{
<div class="row plan-form">
    <div class="col-sm-7">
        <EditForm Method="post" Model="ScheduleForm" OnValidSubmit="GenerateScheduling" FormName="AddSchedulingForm">
            <div class="mb-4 boxes device-settings">
                
                <DataAnnotationsValidator />
                <FormErrors FieldIds='@(new Dictionary<string, string> { [nameof(ScheduleForm.DeviceName)] = "deviceName", [nameof(ScheduleForm.Preset)] = "devicePreset", [nameof(ScheduleForm.PlanName)] = "planName", [nameof(ScheduleForm.Priority)] = "priority-cheapest", [nameof(ScheduleForm.Start)] = "startMinute", [nameof(ScheduleForm.End)] = "endMinute" })' />
                <div class="inboxes">
                    <label for="deviceName" class="form-label form-label-down">Device</label>
                    <ButtonSelectDevice Id="deviceName" Label="Device" FieldName="DeviceName" DescribedBy="deviceName-error" Options="@(userDevices.Select(d => (d.id.ToString(), d.deviceNickname, d.icon, d.color)))"
                        @bind-Value="selectedDeviceId" @bind-Value:after="OnDeviceSelected" Placeholder="Select device" />
                    <ValidationMessage For="() => ScheduleForm.DeviceName" class="text-danger" id="deviceName-error" />
                </div>

                @if (isInterruptible)
                {
                    <div class="charge-settings mt-2 mb-4">
                        <div class="charge-slider">
                            <div class="charge-slider-header">
                                <label id="chargeStop-label" for="chargeStop">Charge to</label>
                                <span id="chargeStop-value">@ScheduleForm.ChargeStopPercentage%</span>
                            </div>
                            <input id="chargeStop" class="charge-range" @bind="ScheduleForm.ChargeStopPercentage" @bind:event="oninput"
                                        aria-labelledby="chargeStop-label chargeStop-value" aria-valuetext="@($"{ScheduleForm.ChargeStopPercentage} percent")" min="5" max="100" step="5" type="range" />
                        </div>
                    </div>
                }

                @if (isNonInterruptible)
                {
                    <div class="inboxes">
                        <label for="devicePreset" class="form-label form-label-down">Device Preset</label>
                        <ButtonSelect Id="devicePreset" Label="Preset" FieldName="Preset" DescribedBy="devicePreset-error" Options="@(filteredPresets.Select(p => (Value: p.id.ToString(), Text: p.presetName)))"
                            @bind-Value="selectedPresetId"
                            @bind-Value:after="UpdateSelectedPreset"
                            Placeholder="Select preset" />
                        <ValidationMessage For="() => ScheduleForm.Preset" class="text-danger" id="devicePreset-error" />
                    </div>
                }
                <div class="mb-3 mt-2 plan-name-field">
                    <label for="planName" class="form-label form-label-input">Name the plan</label>
                    <InputText maxlength="100" id="planName" aria-describedby="planName-error" class="form-control" @bind-Value="ScheduleForm.PlanName" />
                    <ValidationMessage For="() => ScheduleForm.PlanName" id="planName-error" class="text-danger" />
                </div>
            </div>
            <div class="boxes scheduling-settings" role="group" aria-labelledby="scheduling-label">
                <div class ="row">
                    <div class="choices mt-2">
                        <span id="scheduling-label" class="form-label form-label-down">Scheduling window</span>
                    </div>
                    <div class="inboxes">
                        <div class="charge-settings">
                            <div class="charge-slider">
                                <div class="charge-slider-header">
                                    <label id="startMinute-label" for="startMinute">Start  <i class="bi bi-clock" aria-hidden="true"/></label>
                                    <span id="startMinute-value">@Format(ScheduleForm.Start)</span>
                                </div>
                                <input id="startMinute" class="charge-range" @bind="ScheduleForm.Start"
                                    @bind:event="oninput" @bind:after="OnStartChanged" aria-labelledby="startMinute-label startMinute-value" aria-valuetext="@Format(ScheduleForm.Start)" aria-describedby="window-duration scheduling-error" min="@MinMinutes" max="@MaxMinutes" step="@TimeStep" type="range" />
                            </div>

                            <div class="charge-slider mt-3">
                                <div class="charge-slider-header">
                                    <label id="endMinute-label" for="endMinute">End  <i class="bi bi-clock" aria-hidden="true"/></label>
                                    <span id="endMinute-value">@Format(ScheduleForm.End)</span>
                                </div>
                                <input id="endMinute" class="charge-range" @bind="ScheduleForm.End"
                                    @bind:event="oninput" @bind:after="OnEndChanged" aria-labelledby="endMinute-label endMinute-value" aria-valuetext="@Format(ScheduleForm.End)" aria-describedby="window-duration scheduling-error" min="@MinMinutes" max="@MaxMinutes" step="@TimeStep" type="range" />

                            </div>

                            <span id="window-duration" class="charge-slider-duration">Window: @Duration</span>

                            @if (!string.IsNullOrEmpty(schedulingError))
                            {
                                <div id="scheduling-error" class="alert alert-danger mt-2" role="alert">
                                    @schedulingError
                                </div>
                            }
                        </div>
                    </div>
                </div> 
                <div class="row priority-settings">
                    <div class="col-sm-6 choices mt-3">
                        <span id="priority-label" class="form-label1">Choose an option for optimization</span>
                    </div>

                    <div class="col-sm-6 priority-toggle @(ScheduleForm.Priority == "Greenest" ? "is-right" : "is-left")"
                        role="radiogroup" aria-labelledby="priority-label">
                        <span class="priority-thumb" aria-hidden="true"></span>

                        <button type="button" role="radio"
                                class="priority-option @(ScheduleForm.Priority == "Cheapest" ? "active" : "")"
                                id="priority-cheapest" aria-describedby="priority-cheapest-error"
                                tabindex="@(ScheduleForm.Priority == "Cheapest" ? 0 : -1)"
                                aria-checked="@(ScheduleForm.Priority == "Cheapest" ? "true" : "false")"
                                @onclick='() => SetPriority("Cheapest")'>
                            Cheapest
                        </button>

                        <button type="button" role="radio"
                                class="priority-option @(ScheduleForm.Priority == "Greenest" ? "active" : "")"
                                id="priority-greenest" aria-describedby="priority-cheapest-error"
                                tabindex="@(ScheduleForm.Priority == "Greenest" ? 0 : -1)"
                                aria-checked="@(ScheduleForm.Priority == "Greenest" ? "true" : "false")"
                                @onclick='() => SetPriority("Greenest")'>
                            Greenest
                        </button>
                    </div>

                    <ValidationMessage For="() => ScheduleForm.Priority" class="text-danger" id="priority-cheapest-error" />
                </div>
                <div class="mt-4 mb-2 d-flex justify-content-end generate-plan-button">
                    <button type="submit" class="btn btn-primary" disabled="@IsEditMode" aria-describedby="@(IsEditMode ? "regeneration-hint" : null)">Generate Plan</button>
                    @if (IsEditMode) { <span id="regeneration-hint" class="visually-hidden">Plan regeneration will be available later.</span> }
                </div>
            </div>
        </EditForm>
    </div>
    <div class="col-sm-5">
        <div class="priceoverview">
            @if (activeSchedules is not null)
            {
                <PriceChart activeSchedules="ChartSchedules" MaxDisplayedPrices="36"/>
            }
        </div>
        <div class="optimized-side-column">
            <section class="optimized-card plan-summary-card" aria-label="Plan overview" aria-live="polite" aria-atomic="true">
                @{
                    bool hasPlan = displayPlan && optimizedIntervals.Count > 0;
                    string overviewName = string.IsNullOrWhiteSpace(ScheduleForm.PlanName)
                        ? ScheduleForm.DeviceName : ScheduleForm.PlanName;
                }
                <div class="card-heading plan-summary-heading">
                    <div>
                        <h2>Plan overview</h2>
                        <p title="@overviewName">@(string.IsNullOrWhiteSpace(overviewName) ? "Generate a plan to see estimates" : overviewName)</p>
                    </div>
                </div>
                <div class="summary-row">
                    <div>
                        <span>@(IsEditMode ? "Scheduled start time" : "Start time")</span>
                        <small>@(hasPlan ? $"Duration: {DisplayedDuration} min" : "Duration: —")</small>
                    </div>
                    <strong class="@(hasPlan ? null : "summary-placeholder")">@(hasPlan
                        ? TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(optimizedIntervals[0].StartTime, DateTimeKind.Utc), CopenhagenTimeZone).ToString("HH:mm")
                        : "—")</strong>
                </div>
                <div class="summary-row">
                    <div><span>Estimated cost</span></div>
                    <strong class="@(hasPlan ? "summary-cost" : "summary-placeholder")">@(hasPlan
                        ? $"{optimizedIntervals.Sum(x => x.EstimatedPrice):0.00} kr" : "—")</strong>
                </div>
                <div class="summary-row">
                    <div><span>Estimated CO<sub>2</sub></span></div>
                    <strong class="@(hasPlan ? "summary-co2" : "summary-placeholder")">@(hasPlan
                        ? $"{optimizedIntervals.Sum(x => x.EstimatedCo2Emissions):0.##} g CO₂" : "—")</strong>
                </div>
                <div class="mb-3 d-flex justify-content-end gap-2 save-plan-button">
                    @if (!IsEditMode)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelGeneratedPlan" disabled="@(!displayPlan)">Cancel</button>
                    }
                    <button type="button" @onclick="SubmitPlan" class="btn btn-primary" disabled="@(IsEditMode ? !editLoaded : !displayPlan)">@(IsEditMode ? "Update Plan" : "Save Plan")</button>
                </div>

            </section>
        </div>
    </div>
</div>
}

@code {

    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public EventCallback<string> OnPlanNameLoaded { get; set; }
    private int editingPlanId;
    private bool editLoaded;
    private bool isLoading = true;
    private string? loadError;
    private string? userId;
    private PlanDTO? existingPlan;
    private List<PlanDTO> existingPlanIntervals = new();
    private static readonly TimeZoneInfo CopenhagenTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Copenhagen");
    
    // Plan timestamps without an offset are already Copenhagen clock times.
    private static DateTime PlanTimeToUtc(DateTime time) => time.Kind == DateTimeKind.Unspecified
        ? TimeZoneInfo.ConvertTimeToUtc(time, CopenhagenTimeZone)
        : time.ToUniversalTime();

    private TimeSpan OptimizedDuration => TimeSpan.FromTicks(
        optimizedIntervals.Sum(interval => (interval.EndTime - interval.StartTime).Ticks));
    private string DisplayedDuration =>
        IsEditMode && existingPlan is not null
            ? ((int)OptimizedDuration.TotalMinutes).ToString(CultureInfo.InvariantCulture)

            : isInterruptible && optimizedIntervals.Count > 0
                ? optimizedIntervals.Sum(x =>
                    (int)(x.EndTime - x.StartTime).TotalMinutes)
                    .ToString(CultureInfo.InvariantCulture)

                : ScheduleForm.Preset?.duration?
                    .ToString(CultureInfo.InvariantCulture) ?? "?";

    // Active schedules populate the price chart beside the form.
    private List<PlanDto>? activeSchedules;
    private List<PlanDto> previewSchedules = new List<PlanDto>();
    private List<PlanDto> ChartSchedules => previewSchedules.Concat(activeSchedules ?? new List<PlanDto>()).ToList();
    private string area = "DK1";
    
    // Collects the values sent to the optimization API.
    private ScheduleForm ScheduleForm = new ScheduleForm();
    
    // Presets available for the selected device.
    private List<PresetDto> filteredPresets = new List<PresetDto>();
    private string? selectedPresetId;
    
    // Devices registered by the current user.
    private List<PlanUserDeviceDto> userDevices = new List<PlanUserDeviceDto>();
    private PlanUserDeviceDto? SelectedDevice => userDevices
        .FirstOrDefault(device => device.id.ToString(CultureInfo.InvariantCulture) == selectedDeviceId);
    
    // Presets indexed by device so the picker can filter them.
    private Dictionary<int, List<PresetDto>> presetsByDevice = new Dictionary<int, List<PresetDto>>();
    private string? selectedDeviceId;
    
    // Optimization result displayed in the plan overview.
    private List<OptimizationResultDTO> optimizedIntervals = new();
    private DateTime? requestedWindowStart;
    private DateTime? requestedWindowEnd;
    private string? schedulingError;
    private int MaxMinutes = 0;
    private int MinMinutes = 0;
    private int TimeStep = 15;
    private DateTime schedulingDate = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, CopenhagenTimeZone).Date;

    private string Format(int minutes)
    {
        DateTime time = schedulingDate.AddMinutes(minutes);
        string day = (time.Date - schedulingDate).Days switch
        {
            0 => "Today",
            1 => "Tomorrow",
            _ => time.ToString("ddd d MMM", CultureInfo.InvariantCulture)
        };
        return $"{day} {time:HH:mm}";
    }

    private void OnStartChanged()
    {
        ScheduleForm.Start = Math.Clamp(ScheduleForm.Start, MinMinutes, MaxMinutes - 15);
        if (ScheduleForm.End <= ScheduleForm.Start)
            ScheduleForm.End = ScheduleForm.Start + 15;
    }

    private void OnEndChanged()
    {
        ScheduleForm.End = Math.Clamp(ScheduleForm.End, MinMinutes + 15, MaxMinutes);
        if (ScheduleForm.Start >= ScheduleForm.End)
            ScheduleForm.Start = ScheduleForm.End - 15;
    }
    private string Duration
    {
        get
        {
            int diff = ScheduleForm.End - ScheduleForm.Start;
            return $"{diff / 60}h {diff % 60}m";
        }
    }

    private bool isInterruptible = false;
    private bool isNonInterruptible = false;
    private bool displayPlan = false;


    // Load the current user's schedules, devices, and presets before showing the form.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
            userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrWhiteSpace(userId))
                throw new InvalidOperationException("The current user could not be identified.");

            if (IsEditMode)
            {
                editingPlanId = PlanState.SelectedPlanId;
                if (editingPlanId <= 0)
                {
                    loadError = "Select a plan on the Optimized page before editing.";
                    return;
                }
            }

            using HttpRequestMessage? request = new HttpRequestMessage(HttpMethod.Get, "api/plan-controller/get-plan");
            request.Headers.Add("UserId", userId);
            using HttpResponseMessage response = await Http.SendAsync(request);
            response.EnsureSuccessStatusCode();
            activeSchedules = await response.Content.ReadFromJsonAsync<List<PlanDto>>() ?? new List<PlanDto>();

            userDevices = await Http.GetFromJsonAsync<List<PlanUserDeviceDto>>(
                $"api/createPlan-controller/get-user-device/{userId}") ?? new List<PlanUserDeviceDto>();

            foreach (PlanUserDeviceDto userDevice in userDevices)
            {
                List<PresetDto> presets = await Http.GetFromJsonAsync<List<PresetDto>>(
                    $"api/createPlan-controller/get-preset/{userDevice.deviceId}") ?? new List<PresetDto>();
                presetsByDevice[userDevice.id] = presets;
            }

            DateTime now = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, CopenhagenTimeZone);
            schedulingDate = now.Date;
            DateTime then = schedulingDate;
            int addMinutes = ((int)(now - then).TotalMinutes) % 15;
            if (addMinutes == 0)
            {
                MinMinutes = (int)(now - then).TotalMinutes;
                MaxMinutes = (int)(now - then).TotalMinutes + 2160;
            }
            else
            {
                MinMinutes = (int)(now - then).TotalMinutes + (15-addMinutes);
                MaxMinutes = (int)(now - then).TotalMinutes + 2160 + (15-addMinutes);

            }

            ScheduleForm.Start = MinMinutes;
            ScheduleForm.End = MaxMinutes;

            if (IsEditMode)
                await LoadExistingPlanAsync();
        }
        catch (Exception exception)
        {
            loadError = $"The plan could not be loaded: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadExistingPlanAsync()
    {
        using HttpRequestMessage? request = new HttpRequestMessage(HttpMethod.Get,
            $"api/plan-controller/get-plan/{editingPlanId}");
        request.Headers.Add("UserId", userId);
        using HttpResponseMessage response = await Http.SendAsync(request);
        if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            loadError = "The selected plan was not found.";
            return;
        }

        response.EnsureSuccessStatusCode();
        existingPlan = await response.Content.ReadFromJsonAsync<PlanDTO>();
        if (existingPlan is null)
        {
            loadError = "The selected plan could not be loaded.";
            return;
        }

        if (existingPlan.planId != editingPlanId)
        {
            loadError = "The selected plan did not match the plan returned by the server.";
            Logger.LogWarning("Edit plan ID mismatch: requested {PlanId}, received {ReturnedPlanId}",
                editingPlanId, existingPlan.planId);
            return;
        }

        await OnPlanNameLoaded.InvokeAsync(existingPlan.planName);

        if (existingPlan.windowStartTime is null || existingPlan.windowEndTime is null)
        {
            loadError = "The selected plan has no scheduling window.";
            return;
        }

        existingPlanIntervals = new List<PlanDTO> { existingPlan };
        HashSet<int> visited = new HashSet<int>() { editingPlanId };
        while (existingPlanIntervals[^1].nextPlanId is int nextId)
        {
            if (!visited.Add(nextId))
                throw new InvalidOperationException("The selected plan contains a circular interval link.");

            using HttpRequestMessage? intervalRequest = new HttpRequestMessage(HttpMethod.Get,
                $"api/plan-controller/get-plan/{nextId}");
            intervalRequest.Headers.Add("UserId", userId);
            
            using HttpResponseMessage? intervalResponse = await Http.SendAsync(intervalRequest);
            intervalResponse.EnsureSuccessStatusCode();
            PlanDTO? interval = await intervalResponse.Content.ReadFromJsonAsync<PlanDTO>();
            if (interval?.planId != nextId || interval.userDeviceId != existingPlan.userDeviceId)
                throw new InvalidOperationException("A linked interval could not be loaded for the selected device.");

            existingPlanIntervals.Add(interval);
        }

        selectedDeviceId = existingPlan.userDeviceId.ToString(CultureInfo.InvariantCulture);
        OnDeviceSelected();
        if (string.IsNullOrWhiteSpace(ScheduleForm.DeviceName))
        {
            loadError = "The plan's device is unavailable.";
            return;
        }

        ScheduleForm.PlanName = existingPlan.planName;
        ScheduleForm.Priority = existingPlan.optimizationObjective ?? "Cheapest";

        DateTime localStart = TimeZoneInfo.ConvertTimeFromUtc(
            PlanTimeToUtc(existingPlan.windowStartTime.Value), CopenhagenTimeZone);
        DateTime localEnd = TimeZoneInfo.ConvertTimeFromUtc(
            PlanTimeToUtc(existingPlan.windowEndTime.Value), CopenhagenTimeZone);
        ScheduleForm.Start = (int)(localStart - schedulingDate).TotalMinutes;
        ScheduleForm.End = (int)(localEnd - schedulingDate).TotalMinutes;
        // Keep the saved window visible, including times outside the new-plan slider range.
        MinMinutes = Math.Min(MinMinutes, ScheduleForm.Start);
        MaxMinutes = Math.Max(MaxMinutes, ScheduleForm.End);
        // Preserve minute precision on older windows that are not on quarter-hour boundaries.
        TimeStep = ScheduleForm.Start % 15 == 0 && ScheduleForm.End % 15 == 0 ? 15 : 1;

        if (isInterruptible)
        {
            ScheduleForm.ChargeStopPercentage = existingPlan.chargeStopPercentage;
        }
        else if (isNonInterruptible)
        {
            PresetDto? preset = filteredPresets.FirstOrDefault(item => item.id == existingPlan.presetId);
            selectedPresetId = preset?.id.ToString(CultureInfo.InvariantCulture);
            ScheduleForm.Preset = preset;
        }

        ShowExistingPlanPreview();
        editLoaded = true;
    }

    private void ShowExistingPlanPreview()
    {
        if (existingPlan is null)
            return;

        optimizedIntervals = existingPlanIntervals.Select(interval => new OptimizationResultDTO(
            PlanTimeToUtc(interval.startTime),
            PlanTimeToUtc(interval.endTime),
            interval.estimatedCost,
            interval.estimatedCo2Emissions)).ToList();

        displayPlan = true;
    }

    private void SetPriority(string value)
    {
        ScheduleForm.Priority = value;

    }

    private void CancelGeneratedPlan()
    {
        optimizedIntervals.Clear();
        previewSchedules.Clear();
        requestedWindowStart = null;
        requestedWindowEnd = null;
        displayPlan = false;
        schedulingError = null;
    }

    private void ClearSchedule()
    {
        previewSchedules.Clear();
        ScheduleForm = new ScheduleForm();
        filteredPresets = new List<PresetDto>();
        selectedDeviceId = string.Empty;
        optimizedIntervals.Clear();
        requestedWindowStart = null;
        requestedWindowEnd = null;
        displayPlan = false;
        isInterruptible = false;
        isNonInterruptible = false;
    }

    // Update the selected device name, available presets, and device category.
    private void OnDeviceSelected()
    {
        PlanUserDeviceDto? selectedDevice = SelectedDevice;

        ScheduleForm.DeviceName = selectedDevice?.deviceNickname ?? string.Empty;

        filteredPresets = selectedDevice != null && presetsByDevice.TryGetValue(selectedDevice.id, out List<PresetDto>? presets)
        ? presets : new List<PresetDto>();

        isInterruptible = selectedDevice?.category == "Interruptible";

        isNonInterruptible = selectedDevice is not null && !isInterruptible;

        selectedPresetId = null;
        ScheduleForm.Preset = isInterruptible ? filteredPresets.FirstOrDefault() : new PresetDto();
        ScheduleForm.ChargeStopPercentage = isInterruptible ? 50 : null;
    }

    // Store the preset selected from the filtered list.
    private void UpdateSelectedPreset()
    {
        PresetDto? selectedPreset = filteredPresets.FirstOrDefault(p => p.id.ToString() == selectedPresetId);

        if (selectedPreset is not null)
        {
            ScheduleForm.Preset = selectedPreset;
        }
        schedulingError = null;
    }

    // Sliders store minutes from the same Copenhagen date for loading and saving.
    private DateTime GetScheduledDateTime(int minute) => schedulingDate.AddMinutes(minute);

    // Request an optimized plan and show its result in the overview.
    private async Task GenerateScheduling()
    {
        if (IsEditMode)
            return;

        schedulingError = null;
        if (isNonInterruptible && (ScheduleForm.Preset?.id ?? 0) <= 0)
        {
            NotificationService.ErrorNotification($"Select a device preset before generating a plan.");
            // schedulingError = "Select a device preset before generating a plan.";
            return;
        }

        if (isInterruptible && ScheduleForm.ChargeStopPercentage is null)
        {
            NotificationService.ErrorNotification($"Select a charge percentage before generating a plan.");
            // schedulingError = "Select a charge percentage before generating a plan.";
            return;
        }

        optimizedIntervals.Clear();
        displayPlan = false;
        requestedWindowStart = null;
        requestedWindowEnd = null;
        previewSchedules.Clear();

        DateTime startTime = GetScheduledDateTime(ScheduleForm.Start);
        DateTime endTime = GetScheduledDateTime(ScheduleForm.End);

        Console.WriteLine($"Start time: {startTime}");
        Console.WriteLine($"End time: {endTime}");

        int timeWindow = (int)(endTime - startTime).TotalMinutes;

        if (ScheduleForm.Preset != null && ScheduleForm.Preset.duration > timeWindow)
        {
            NotificationService.ErrorNotification($"The selected program requires {ScheduleForm.Preset.duration} minutes.");
            // schedulingError = $"The selected program requires {ScheduleForm.Preset.duration} minutes.";
            return;
        }

        try
        {
            requestedWindowStart = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(startTime, DateTimeKind.Unspecified), CopenhagenTimeZone);
            requestedWindowEnd = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(endTime, DateTimeKind.Unspecified), CopenhagenTimeZone);
            Console.WriteLine($"Start time: {requestedWindowStart}");
            Console.WriteLine($"End time: {requestedWindowEnd}");
        }
        catch (ArgumentException)
        {
            NotificationService.ErrorNotification($"The selected time does not exist on this date. Choose another time.");
            // schedulingError = "The selected time does not exist on this date. Choose another time.";
            return;
        }


        PlanUserDeviceDto selectedDevice = SelectedDevice!;
        OptimizationRequestDTO? optimizationRequest = new OptimizationRequestDTO
        {
            Area = area,
            UserDeviceId = selectedDevice.id,
            DevicePresetId = ScheduleForm.Preset?.id ?? 0,
            StartWindow = requestedWindowStart.Value,   // UTC, already computed above
            EndWindow = requestedWindowEnd.Value,
            Priority = ScheduleForm.Priority
        };

        try
        {
            using HttpResponseMessage? result = await Http.PostAsJsonAsync(
                "api/createPlan-controller/optimize",
                optimizationRequest);

            if (!result.IsSuccessStatusCode)
            {
                NotificationService.ErrorNotification($"Optimization failed: {await result.Content.ReadAsStringAsync()}");
                // schedulingError = $"Optimization failed: {await result.Content.ReadAsStringAsync()}";
                return;
            }

            optimizedIntervals =
                await result.Content.ReadFromJsonAsync<List<OptimizationResultDTO>>()
                ?? new List<OptimizationResultDTO>();

            optimizedIntervals = optimizedIntervals
                .OrderBy(x => x.StartTime)
                .ToList();

            if (optimizedIntervals.Count == 0)
            {
                NotificationService.ErrorNotification($"The optimizer returned no charging intervals.");
                // schedulingError = "The optimizer returned no charging intervals.";
                return;
            }

            displayPlan = true;

            string planName = string.IsNullOrWhiteSpace(ScheduleForm.PlanName)
            ? ScheduleForm.DeviceName
            : ScheduleForm.PlanName.Trim();

            ShowGeneratedPlanPreview(selectedDevice, planName);

            NotificationService.SuccessNotification($"An optimized schedule for \"{planName}\" was succesfully created.");



            Logger.LogInformation(
                "Optimization worked. Received {Count} intervals.",
                optimizedIntervals.Count);
        }
        catch (Exception e)
        {
            NotificationService.ErrorNotification($"Error with optimization: {e.Message}");
            // schedulingError = $"Error with optimization: {e.Message}";
            Logger.LogError(e, "Optimization failed");
        }

        await Task.CompletedTask;
        return ;

    }

    private static DateTime ChartTime(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(
        DateTime.SpecifyKind(utc, DateTimeKind.Utc), CopenhagenTimeZone);

    private void ShowGeneratedPlanPreview(PlanUserDeviceDto device, string planName)
    {
        // Negative IDs keep unsaved intervals separate from database plans and link them into one track.
        previewSchedules = optimizedIntervals.Select((OptimizationResultDTO interval, int index) => new PlanDto(
            planId: -(index + 1),
            nextPlanId: index + 1 < optimizedIntervals.Count ? -(index + 2) : null,
            planName: $"{planName} (Preview)",
            icon: device.icon, colorCode: device.color,
            deviceName: device.deviceNickname, deviceCategory: device.category,
            optimizationObjective: ScheduleForm.Priority,
            chargeStopPercentage: ScheduleForm.ChargeStopPercentage,
            presetDurationInMinutes: ScheduleForm.Preset?.duration,
            startTime: ChartTime(interval.StartTime), endTime: ChartTime(interval.EndTime),
            windowStartTime: ChartTime(requestedWindowStart!.Value),
            windowEndTime: ChartTime(requestedWindowEnd!.Value),
            estimatedCost: interval.EstimatedPrice,
            estimatedCo2Emissions: interval.EstimatedCo2Emissions,
            estimatedUnscheduledPrice: 0m, estimatedUnscheduledCo2Emissions: 0m,
            batteryCapacityInKwh: device.batteryCapacityInKwh)).ToList();
    }

    // Save the generated plan and its form values through the API.
    private async Task addPlan()
    {
        PlanUserDeviceDto? selectedDevice = userDevices
            .FirstOrDefault(d => d.id.ToString() == selectedDeviceId);

        if (selectedDevice is null ||
            optimizedIntervals.Count == 0 ||
            requestedWindowStart is null ||
            requestedWindowEnd is null)
        {
            NotificationService.ErrorNotification($"No optimized plans are available to save.");
            // schedulingError = "No optimized plans are available to save.";
            return;
        }

        schedulingError = null;

        int? nextPlanId = null;
        int? firstPlanId = null;

        string planName = string.IsNullOrWhiteSpace(ScheduleForm.PlanName)
            ? ScheduleForm.DeviceName
            : ScheduleForm.PlanName.Trim();

        try
        {
            (UnscheduledEstimateDto? unscheduledEstimate, string? baselineError) =
                await GetUnscheduledEstimateAsync(selectedDevice, requestedWindowStart.Value);
            if (unscheduledEstimate is null)
            {
                schedulingError = baselineError ?? "Could not calculate the unscheduled baseline.";
                return;
            }

            // Save the last interval first.
            List<OptimizationResultDTO>? intervalsToSave = optimizedIntervals.OrderByDescending(x => x.StartTime).ToList();
            List<UnscheduledEstimateDto>? intervalEstimates = DistributeUnscheduledEstimate(unscheduledEstimate, intervalsToSave);
            for (int index = 0; index < intervalsToSave.Count; index++)
            {
                OptimizationResultDTO? interval = intervalsToSave[index];
                PlanDTO? planToSave = new PlanDTO
                {
                    userDeviceId = selectedDevice.id,

                    // Optimizer returns UTC.
                    startTime = DateTime.SpecifyKind(
                        interval.StartTime, DateTimeKind.Utc),

                    endTime = DateTime.SpecifyKind(
                        interval.EndTime, DateTimeKind.Utc),

                    windowStartTime = requestedWindowStart.Value,
                    windowEndTime = requestedWindowEnd.Value,

                    // Link to the next chronological charging interval.
                    nextPlanId = nextPlanId,

                    estimatedCost = interval.EstimatedPrice,
                    estimatedCo2Emissions = interval.EstimatedCo2Emissions,

                    estimatedUnscheduledCost = intervalEstimates[index].EstimatedPrice,
                    estimatedUnscheduledCo2Emissions = intervalEstimates[index].EstimatedCo2Emissions,

                    planName = planName,
                    optimizationObjective = ScheduleForm.Priority,

                    presetId = ScheduleForm.Preset?.id,

                    chargeStopPercentage = isInterruptible
                        ? ScheduleForm.ChargeStopPercentage
                        : null,

                    batteryCapacityInKwh =
                        selectedDevice.batteryCapacityInKwh
                };

                using HttpResponseMessage? result = await Http.PostAsJsonAsync(
                    "api/createPlan-controller/post-plan",
                    planToSave);

                if (!result.IsSuccessStatusCode)
                {
                    string error = await result.Content.ReadAsStringAsync();
                    NotificationService.ErrorNotification($"Error with adding the plan: {error}");

                    // schedulingError =
                    //     $"Failed to save a charging interval: {error}";

                    return;
                }

                PlanDTO? savedPlan =
                    await result.Content.ReadFromJsonAsync<PlanDTO>();

                if (savedPlan?.planId is not int savedId || savedId <= 0)
                {
                    NotificationService.ErrorNotification($"The API did not return a valid saved plan ID");
                    // schedulingError =
                    //     "The API did not return a valid saved plan ID.";

                    return;
                }

                if (savedPlan.nextPlanId != nextPlanId)
                {
                    NotificationService.ErrorNotification($"The API did not preserve the NextPlanId link.");

                    // schedulingError =
                    //     "The API did not preserve the NextPlanId link.";

                    return;
                }

                // The next saved plan will point to this one.
                nextPlanId = savedId;

                // Because we're saving backwards, this ends up
                // containing the ID of the first chronological plan.
                firstPlanId = savedId;
            }

            if (firstPlanId.HasValue)
            {
                PlanState.SelectedPlanId = firstPlanId.Value;
            }

            Logger.LogInformation(
                "Saved {Count} linked plans. First plan ID: {PlanId}",
                optimizedIntervals.Count,
                firstPlanId);

            ClearSchedule();

            NavigationManager.NavigateTo("/optimized");
        }
        catch (Exception ex)
        {
            NotificationService.ErrorNotification($"Error with saving optimized plan: {ex.Message}");
            Logger.LogError(ex, "Failed to save optimized plans");
            // schedulingError = $"Error saving plans: {ex.Message}";
        }
    }

    private async Task<(UnscheduledEstimateDto? Estimate, string? Error)> GetUnscheduledEstimateAsync(
        PlanUserDeviceDto selectedDevice,
        DateTime baselineStart)
    {
        if (optimizedIntervals.Count == 0 || optimizedIntervals.Any(interval => interval.EndTime <= interval.StartTime))
            return (null, "Valid charging intervals are required to calculate the unscheduled baseline.");

        decimal energyInKwh;

        if (isInterruptible)
        {
            // Interruptible baseline workload is the selected charge-stop percentage of the battery capacity.
            if (selectedDevice.batteryCapacityInKwh is not decimal batteryCapacity ||
                ScheduleForm.ChargeStopPercentage is not int chargeStopPercentage)
            {
                return (null, "Battery capacity and charge-stop percentage are required.");
            }

            energyInKwh = batteryCapacity * chargeStopPercentage / 100m;
        }
        else if (ScheduleForm.Preset?.consumption is decimal presetConsumption)
        {
            energyInKwh = presetConsumption;
        }
        else
        {
            return (null, "A device preset with consumption data is required.");
        }

        // The baseline runs continuously from the window start, without optimizer pauses.
        DateTime baselineEnd = baselineStart + OptimizedDuration;

        UnscheduledEstimateRequestDto request = new UnscheduledEstimateRequestDto()
        {
            AreaCode = area,
            StartTime = baselineStart,
            EndTime = baselineEnd,
            EnergyInKwh = energyInKwh
        };

        using HttpResponseMessage response = await Http.PostAsJsonAsync(
            "api/electricity-price-controller/unscheduled-estimate",
            request);

        if (!response.IsSuccessStatusCode)
        {
            string error = await response.Content.ReadAsStringAsync();
            return (null, string.IsNullOrWhiteSpace(error)
                ? "Could not calculate the unscheduled baseline."
                : error);
        }

        UnscheduledEstimateDto? estimate =
            await response.Content.ReadFromJsonAsync<UnscheduledEstimateDto>();
        return estimate is null
            ? (null, "The backend returned an empty unscheduled baseline.")
            : (estimate, null);
    }

    private static List<UnscheduledEstimateDto> DistributeUnscheduledEstimate(
        UnscheduledEstimateDto estimate, IReadOnlyList<OptimizationResultDTO> intervals)
    {
        decimal totalTicks = intervals.Sum(interval => (interval.EndTime - interval.StartTime).Ticks);
        decimal remainingPrice = estimate.EstimatedPrice;
        decimal remainingCo2 = estimate.EstimatedCo2Emissions;
        List<UnscheduledEstimateDto>? result = new List<UnscheduledEstimateDto>();

        for (int index = 0; index < intervals.Count; index++)
        {
            decimal durationTicks = (intervals[index].EndTime - intervals[index].StartTime).Ticks;
            bool isLast = index == intervals.Count - 1;
            decimal price = isLast ? remainingPrice : estimate.EstimatedPrice * durationTicks / totalTicks;
            decimal co2 = isLast ? remainingCo2 : estimate.EstimatedCo2Emissions * durationTicks / totalTicks;
            result.Add(new UnscheduledEstimateDto(price, co2));
            // Keep the exact total even when a proportional share has repeating decimals.
            remainingPrice -= price;
            remainingCo2 -= co2;
        }

        return result;
    }

    private Task SubmitPlan() => IsEditMode ? UpdatePlanAsync() : addPlan();


    private async Task UpdatePlanAsync()
    {
        if (!editLoaded || existingPlan is null || editingPlanId <= 0 || string.IsNullOrWhiteSpace(userId))
            return;

        schedulingError = null;
        if (!int.TryParse(selectedDeviceId, out int deviceId) || ScheduleForm.End <= ScheduleForm.Start)
        {
            NotificationService.ErrorNotification("Select a device and scheduling window.");
            return;
        }

        if (isNonInterruptible && (ScheduleForm.Preset?.id ?? 0) <= 0)
        {
            NotificationService.ErrorNotification("Select a device preset before updating.");
            return;
        }

        if (isInterruptible && ScheduleForm.ChargeStopPercentage is null)
        {
            NotificationService.ErrorNotification("Select a charge percentage before updating.");
            return;
        }

        string planName = string.IsNullOrWhiteSpace(ScheduleForm.PlanName)
            ? ScheduleForm.DeviceName
            : ScheduleForm.PlanName.Trim();
        if (planName.Length > 100)
        {
            NotificationService.ErrorNotification("The plan name cannot exceed 100 characters.");
            return;
        }

        DateTime localStart = DateTime.SpecifyKind(GetScheduledDateTime(ScheduleForm.Start), DateTimeKind.Unspecified);
        DateTime localEnd = DateTime.SpecifyKind(GetScheduledDateTime(ScheduleForm.End), DateTimeKind.Unspecified);

        if (ScheduleForm.Preset is not null && (localEnd - localStart).TotalMinutes < ScheduleForm.Preset.duration)
        {
            NotificationService.ErrorNotification("The scheduling window is not large enough for the duration of the plan.");
            return;
        }

        if (CopenhagenTimeZone.IsInvalidTime(localStart) || CopenhagenTimeZone.IsInvalidTime(localEnd))
        {
            NotificationService.ErrorNotification("The selected time does not exist on this date. Choose another time.");
            return;
        }

        PlanUserDeviceDto? selectedDevice = SelectedDevice;
        if (selectedDevice is null)
        {
            NotificationService.ErrorNotification("Select a valid device before updating.");
            return;
        }

        try
        {
            DateTime windowStart = TimeZoneInfo.ConvertTimeToUtc(localStart, CopenhagenTimeZone);
            DateTime windowEnd = TimeZoneInfo.ConvertTimeToUtc(localEnd, CopenhagenTimeZone);
            (UnscheduledEstimateDto? unscheduledEstimate, string? baselineError) =
                await GetUnscheduledEstimateAsync(selectedDevice, windowStart);
            if (unscheduledEstimate is null)
            {
                schedulingError = baselineError ?? "Could not calculate the unscheduled baseline.";
                return;
            }

            List<UnscheduledEstimateDto>? intervalEstimates = DistributeUnscheduledEstimate(unscheduledEstimate, optimizedIntervals);
            for (int index = 0; index < existingPlanIntervals.Count; index++)
            {
                int intervalId = existingPlanIntervals[index].planId!.Value;
                PlanDTO? update = new PlanDTO
                {
                    planId = intervalId,
                    userDeviceId = deviceId,
                    planName = planName,
                    windowStartTime = windowStart,
                    windowEndTime = windowEnd,
                    optimizationObjective = ScheduleForm.Priority,
                    presetId = ScheduleForm.Preset?.id,
                    chargeStopPercentage = isInterruptible ? ScheduleForm.ChargeStopPercentage : null,
                    batteryCapacityInKwh = selectedDevice.batteryCapacityInKwh,
                    estimatedUnscheduledCost = intervalEstimates[index].EstimatedPrice,
                    estimatedUnscheduledCo2Emissions = intervalEstimates[index].EstimatedCo2Emissions
                };

                using HttpRequestMessage? request = new HttpRequestMessage(HttpMethod.Put,
                    $"api/plan-controller/update-plan/{intervalId}")
                {
                    Content = JsonContent.Create(update)
                };
                request.Headers.Add("UserId", userId);
                using HttpResponseMessage result = await Http.SendAsync(request);
                if (!result.IsSuccessStatusCode)
                {
                    NotificationService.ErrorNotification($"The plan could not be fully updated (interval {intervalId}): {await result.Content.ReadAsStringAsync()}");
                    return;
                }

                PlanDTO? savedPlan = await result.Content.ReadFromJsonAsync<PlanDTO>();
                if (savedPlan?.planId != intervalId)
                {
                    NotificationService.ErrorNotification("The server returned a different plan after the update. Please reload before editing again.");
                    Logger.LogWarning("Updated plan ID mismatch: requested {PlanId}, received {ReturnedPlanId}",
                        intervalId, savedPlan?.planId);
                    return;
                }

                Logger.LogInformation(
                    "Updated plan {PlanId}: server returned window {WindowStartTime}–{WindowEndTime}",
                    savedPlan.planId, savedPlan.windowStartTime, savedPlan.windowEndTime);
            }

            PlanState.SelectedPlanId = editingPlanId;
            PlanState.ReturnToSelectedPlan = true;
            NavigationManager.NavigateTo("/optimized");
        }
        catch (Exception exception)
        {
            NotificationService.ErrorNotification($"The plan could not be updated: {exception.Message}");
        }
    }
}

