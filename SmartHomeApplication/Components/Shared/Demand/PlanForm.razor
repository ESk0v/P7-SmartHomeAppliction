@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthProvider
@inject OptimizedPlanState PlanState
@inject ILogger<PlanForm> Logger

@using global::Shared.Dashboard
@using System.Globalization
@using System.Security.Claims
@using Utilities.Models

@if (loadError is not null)
{
    <div class="alert alert-danger" role="alert">
        @loadError
        @if (IsEditMode)
        {
            <a href="/optimized">Select a plan</a>
        }
    </div>
}
else if (isLoading)
{
    <p>Loading plan details...</p>
}

@if (!isLoading && loadError is null)
{
<div class="row">
    <div class="col-sm-7">
        <EditForm Method="post" Model="ScheduleForm" OnValidSubmit="GenerateScheduling" FormName="AddSchedulingForm">
            <div class="mb-4 boxes">
                
                <DataAnnotationsValidator />
                <div class="inboxes">
                    <label for="deviceName" class="form-label form-label-down">Device Name</label>
                    <ButtonSelectDevice Options="@(userDevices.Select(d => (d.id.ToString(), d.deviceNickname, d.icon, d.color)))"
                        @bind-Value="selectedDeviceId" @bind-Value:after="OnDeviceSelected" Placeholder="Select device" />
                    <ValidationMessage For="() => ScheduleForm.DeviceName" class="text-danger" />
                </div>   
                
                @if (isInterruptible)
                {
                    <div class="charge-settings mt-4 mb-4">
                        <p>Battery capacity: @(SelectedDevice?.batteryCapacityInKwh is decimal capacity ? $"{capacity:0.###} kWh" : "Unknown")</p>
                        <div class="charge-slider">
                            <div class="charge-slider-header">
                                <label for="chargeStop">Charge to</label>
                                <span>@ScheduleForm.ChargeStopPercentage%</span>
                            </div>
                            <InputNumber id="chargeStop" class="charge-range" @bind-Value="ScheduleForm.ChargeStopPercentage"
                                        min="5" max="100" step="5" type="range" />
                        </div>
                    </div>
                }

                @if (isNonInterruptible)
                {
                    <div class="inboxes">
                        <label for="devicePreset" class="form-label form-label-down">Device Preset</label>
                        <ButtonSelect Options="@(filteredPresets.Select(p => (Value: p.id.ToString(), Text: p.presetName)))"
                            @bind-Value="selectedPresetId"
                            @bind-Value:after="UpdateSelectedPreset"
                            Placeholder="Select preset" />
                        <ValidationMessage For="() => ScheduleForm.Preset" class="text-danger" />
                    </div>  
                }
                <div class="mb-3 mt-2">
                    <label for="planName" class="form-label form-label-input">Name the plan</label>
                    <InputText id="planName" class="form-control" @bind-Value="ScheduleForm.PlanName" />
                </div>
            </div>
            <div class="boxes">
                <div class ="row">
                    <div class="mb-4 col-sm-6 inboxes">
                        <div>
                            <div class="choices mb-4">
                                <span>Scheduling window</span>
                            </div>
                            <div>
                                <label class="form-label1">Start  <i class="bi bi-clock"/></label>
                                <div class="d-flex gap-2 align-items-center">
                                    <ButtonSelect Options="HourOptions" @bind-Value="StartHourText" 
                                        CssClass="time-picker" Placeholder="" />
                                    <span>:</span>

                                    <ButtonSelect Options="MinuteOptions" @bind-Value="StartMinuteText"
                                        CssClass="time-picker" Placeholder="" />
                                </div>
                                <ValidationMessage For="() => ScheduleForm.StartHour" class="text-danger" />
                                <ValidationMessage For="() => ScheduleForm.StartMinute" class="text-danger" />
                            </div>
                            <div class="mt-4">
                                <label class="form-label1">End  <i class="bi bi-clock"/></label>
                                <div class="d-flex gap-2 align-items-center">
                                    <ButtonSelect Options="HourOptions" @bind-Value="EndHourText" 
                                        CssClass="time-picker" Placeholder="" />
                                    <span>:</span>

                                    <ButtonSelect Options="MinuteOptions" @bind-Value="EndMinuteText"
                                        CssClass="time-picker" Placeholder="" />
                                </div>
                            </div>
                            <ValidationMessage For="() => ScheduleForm.EndHour" class="text-danger" />
                            <ValidationMessage For="() => ScheduleForm.EndMinute" class="text-danger" />
                            @if (!string.IsNullOrEmpty(schedulingError))
                            {
                                <div class="alert alert-danger mt-5" roles="alert">
                                    @schedulingError
                                </div>
                            }
                        </div>
                    </div> 
                    <div class="mb-4 col-sm-6 inboxes">
                        <div class="mb-6 choices">
                            <span>Priority</span><br />
                            <label class="form-label1">Choose an option for optimization</label>
                        </div>
            
                        <div class="priority-toggle @(ScheduleForm.Priority == "Greenest" ? "is-right" : "is-left")"
                            role="radiogroup" aria-labelledby="priority-label">
                            <span class="priority-thumb" aria-hidden="true"></span>

                            <button type="button" role="radio"
                                    class="priority-option @(ScheduleForm.Priority == "Cheapest" ? "active" : "")"
                                    aria-checked="@(ScheduleForm.Priority == "Cheapest")"
                                    @onclick='() => SetPriority("Cheapest")'>
                                Cheapest
                            </button>

                            <button type="button" role="radio"
                                    class="priority-option @(ScheduleForm.Priority == "Greenest" ? "active" : "")"
                                    aria-checked="@(ScheduleForm.Priority == "Greenest")"
                                    @onclick='() => SetPriority("Greenest")'>
                                Greenest
                            </button>
                        </div>

                        <ValidationMessage For="() => ScheduleForm.Priority" class="text-danger" />
                    </div>
                    <div class="mb-3 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary" disabled="@IsEditMode" title="@(IsEditMode ? "Plan regeneration will be available later" : null)">Generate Plan</button>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
    <div class="col-sm-5">
        <div class="priceoverview">
            @if (activeSchedules is not null)
            {
                <PriceChart activeSchedules="activeSchedules" MaxDisplayedPrices="24"/>
            }
        </div>
        <div class="optimized-side-column">
            <section class="optimized-card plan-summary-card">
                @if (displayPlan && response != null)
                {
                    <div class="card-heading">
                        <h2>Plan overview</h2>
                    </div>
                    <div class="summary-row">
                        <div>
                            <span>@(IsEditMode ? "Scheduled start time" : "Start time")</span>
                            <small>@((ScheduleForm.PlanName == string.Empty) ? ScheduleForm.DeviceName : ScheduleForm.PlanName) runs for @DisplayedDuration minutes</small>
                        </div>
                        <strong>@response.StartTime.ToString("HH:mm")</strong>
                    </div>
                    <div class="summary-row">
                        <div>
                            <span>Cost</span>
                            <small>Estimated cost for @((ScheduleForm.PlanName == string.Empty) ? ScheduleForm.DeviceName : ScheduleForm.PlanName)</small>
                        </div>
                        <strong class="summary-cost" >@response.EstimatedPrice kr.</strong>
                    </div>
                    <div class="summary-row">
                        <div>
                            <span>CO2 Emission</span>
                            <small>Estimated CO2 emissions for @((ScheduleForm.PlanName == string.Empty) ? ScheduleForm.DeviceName : ScheduleForm.PlanName)</small>
                        </div>
                        <strong class="summary-co2" >@response.EstimatedCo2Emissions %</strong>
                    </div>
                }
                else
                {
                   <div class="card-heading">
                        <h2>Plan overview</h2>
                    </div>
                    <div class="summary-row">
                        <div>
                            <span>No plan generated yet.</span>
                        </div>
                    </div>
                }
                <div class="mb-3 d-flex justify-content-end save-plan-button">
                    <button type="button" @onclick="SubmitPlan" class="btn btn-primary" disabled="@(IsEditMode ? !editLoaded : !displayPlan)">@(IsEditMode ? "Update Plan" : "Save Plan")</button>
                </div>
                
            </section>
        </div>   
    </div>
</div>
}

@code {

    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public EventCallback<string> OnPlanNameLoaded { get; set; }
    private int editingPlanId;
    private bool editLoaded;
    private bool isLoading = true;
    private string? loadError;
    private string? userId;
    private PlanDTO? existingPlan;
    private static readonly TimeZoneInfo CopenhagenTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Copenhagen");
    private string DisplayedDuration => IsEditMode && existingPlan is not null
        ? ((int)(existingPlan.endTime - existingPlan.startTime).TotalMinutes).ToString(CultureInfo.InvariantCulture)
        : isInterruptible && response is not null
            ? ((int)(response.EndTime - response.StartTime).TotalMinutes).ToString(CultureInfo.InvariantCulture)
            : ScheduleForm.Preset?.duration?.ToString(CultureInfo.InvariantCulture) ?? "?";

    // Active schedules populate the price chart beside the form.
    private List<PlanDto>? activeSchedules;
    private string area = "DK1";
    // Collects the values sent to the optimization API.
    private ScheduleForm ScheduleForm = new ScheduleForm();
    // Presets available for the selected device.
    private List<PresetDto> filteredPresets = new List<PresetDto>();
    private string? selectedPresetId;
    // Devices registered by the current user.
    private List<PlanUserDeviceDto> userDevices = new List<PlanUserDeviceDto>();
    private PlanUserDeviceDto? SelectedDevice => userDevices
        .FirstOrDefault(device => device.id.ToString(CultureInfo.InvariantCulture) == selectedDeviceId);
    // Presets indexed by device so the picker can filter them.
    private Dictionary<int, List<PresetDto>> presetsByDevice = new Dictionary<int, List<PresetDto>>();
    private string? selectedDeviceId;
    // Optimization result displayed in the plan overview.
    private OptimizationResultDTO? response;
    private DateTime? requestedWindowStart;
    private DateTime? requestedWindowEnd;
    private List<int> Hours { get; set; } = new List<int>();
    private int [] Minutes = {00, 15, 30, 45};
    private IEnumerable<(string Value, string Text)> HourOptions =>
    Hours.Select(h => (h.ToString(), h.ToString("D2")));
    private IEnumerable<(string Value, string Text)> MinuteOptions =>
    Minutes.Select(m => (m.ToString(), m.ToString("D2")));
    private string? schedulingError;

    // Convert the hour and minute picker values to and from strings.
    private string? StartHourText
    {
        get => ScheduleForm.StartHour?.ToString();
        set => ScheduleForm.StartHour =
            int.TryParse(value, out int hour) ? hour : null;
    }

    private string? StartMinuteText
    {
        get => ScheduleForm.StartMinute?.ToString();
        set => ScheduleForm.StartMinute =
            int.TryParse(value, out int minute) ? minute : null;
    }
    private string? EndHourText
    {
        get => ScheduleForm.EndHour?.ToString();
        set => ScheduleForm.EndHour =
            int.TryParse(value, out int hour) ? hour : null;
    }

    private string? EndMinuteText
    {
        get => ScheduleForm.EndMinute?.ToString();
        set => ScheduleForm.EndMinute =
            int.TryParse(value, out int minute) ? minute : null;
    }
    private bool isInterruptible = false;
    private bool isNonInterruptible = false;
    private bool displayPlan = false;


    // Load the current user's schedules, devices, and presets before showing the form.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState state = await AuthProvider.GetAuthenticationStateAsync();
            userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrWhiteSpace(userId))
                throw new InvalidOperationException("The current user could not be identified.");

            if (IsEditMode)
            {
                editingPlanId = PlanState.SelectedPlanId;
                if (editingPlanId <= 0)
                {
                    loadError = "Select a plan on the Optimized page before editing.";
                    return;
                }
            }

            using HttpRequestMessage? request = new HttpRequestMessage(HttpMethod.Get, "api/plan-controller/get-plan");
            request.Headers.Add("UserId", userId);
            using HttpResponseMessage response = await Http.SendAsync(request);
            response.EnsureSuccessStatusCode();
            activeSchedules = await response.Content.ReadFromJsonAsync<List<PlanDto>>() ?? new List<PlanDto>();

            userDevices = await Http.GetFromJsonAsync<List<PlanUserDeviceDto>>(
                $"api/createPlan-controller/get-user-device/{userId}") ?? new List<PlanUserDeviceDto>();

            foreach (PlanUserDeviceDto userDevice in userDevices)
            {
                List<PresetDto> presets = await Http.GetFromJsonAsync<List<PresetDto>>(
                    $"api/createPlan-controller/get-preset/{userDevice.deviceId}") ?? new List<PresetDto>();
                presetsByDevice[userDevice.id] = presets;
            }

            int currentHour = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, CopenhagenTimeZone).Hour + 1;
            Hours = Enumerable.Range(0, 24)
                .Select(i => (currentHour + i) % 24)
                .ToList();

            if (IsEditMode)
                await LoadExistingPlanAsync();
        }
        catch (Exception exception)
        {
            loadError = $"The plan could not be loaded: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadExistingPlanAsync()
    {
        using HttpRequestMessage? request = new HttpRequestMessage(HttpMethod.Get,
            $"api/plan-controller/get-plan/{editingPlanId}");
        request.Headers.Add("UserId", userId);
        using HttpResponseMessage response = await Http.SendAsync(request);
        if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            loadError = "The selected plan was not found.";
            return;
        }

        response.EnsureSuccessStatusCode();
        existingPlan = await response.Content.ReadFromJsonAsync<PlanDTO>();
        if (existingPlan is null)
        {
            loadError = "The selected plan could not be loaded.";
            return;
        }

        if (existingPlan.planId != editingPlanId)
        {
            loadError = "The selected plan did not match the plan returned by the server.";
            Logger.LogWarning("Edit plan ID mismatch: requested {PlanId}, received {ReturnedPlanId}",
                editingPlanId, existingPlan.planId);
            return;
        }

        await OnPlanNameLoaded.InvokeAsync(existingPlan.planName);

        if (existingPlan.windowStartTime is null || existingPlan.windowEndTime is null)
        {
            loadError = "The selected plan has no scheduling window.";
            return;
        }

        selectedDeviceId = existingPlan.userDeviceId.ToString(CultureInfo.InvariantCulture);
        OnDeviceSelected();
        if (string.IsNullOrWhiteSpace(ScheduleForm.DeviceName))
        {
            loadError = "The plan's device is unavailable.";
            return;
        }

        ScheduleForm.PlanName = existingPlan.planName;
        ScheduleForm.Priority = existingPlan.optimizationObjective ?? "Cheapest";

        DateTime localStart = existingPlan.windowStartTime.Value;
        DateTime localEnd = existingPlan.windowEndTime.Value;
        ScheduleForm.StartHour = localStart.Hour;
        ScheduleForm.StartMinute = localStart.Minute;
        ScheduleForm.EndHour = localEnd.Hour;
        ScheduleForm.EndMinute = localEnd.Minute;
        Minutes = Minutes.Concat(new[] { localStart.Minute, localEnd.Minute })
            .Distinct().OrderBy(minute => minute).ToArray();

        if (isInterruptible)
        {
            ScheduleForm.ChargeStopPercentage = existingPlan.chargeStopPercentage;
        }
        else if (isNonInterruptible)
        {
            PresetDto? preset = filteredPresets.FirstOrDefault(item => item.id == existingPlan.presetId);
            selectedPresetId = preset?.id.ToString(CultureInfo.InvariantCulture);
            ScheduleForm.Preset = preset;
        }

        ShowExistingPlanPreview();
        editLoaded = true;
    }

    private void ShowExistingPlanPreview()
    {
        if (existingPlan is null)
            return;

        response = new OptimizationResultDTO(
            existingPlan.startTime,
            existingPlan.endTime,
            existingPlan.estimatedCost,
            existingPlan.estimatedCo2Emissions);
        displayPlan = true;
    }

    private void SetPriority(string value)
    {
        ScheduleForm.Priority = value;

    }

    private void ClearSchedule()
    {
        ScheduleForm = new ScheduleForm();
        filteredPresets = new List<PresetDto>();
        selectedDeviceId = string.Empty;
        response = null;
        requestedWindowStart = null;
        requestedWindowEnd = null;
        displayPlan = false;
        isInterruptible = false;
        isNonInterruptible = false;
    }

    // Update the selected device name, available presets, and device category.
    private void OnDeviceSelected()
    {
        PlanUserDeviceDto? selectedDevice = SelectedDevice;

        ScheduleForm.DeviceName = selectedDevice?.deviceNickname ?? string.Empty;

        filteredPresets = selectedDevice != null && presetsByDevice.TryGetValue(selectedDevice.id, out List<PresetDto>? presets)
        ? presets : new List<PresetDto>();

        isInterruptible = selectedDevice?.category == "Interruptible";

        isNonInterruptible = selectedDevice is not null && !isInterruptible;
        
        selectedPresetId = null;
        ScheduleForm.Preset = isInterruptible ? filteredPresets.FirstOrDefault() : new PresetDto();
        ScheduleForm.ChargeStopPercentage = null;
    }

    // Store the preset selected from the filtered list.
    private void UpdateSelectedPreset()
    {
        PresetDto? selectedPreset = filteredPresets.FirstOrDefault(p => p.id.ToString() == selectedPresetId);

        if (selectedPreset is not null)
        {
            ScheduleForm.Preset = selectedPreset;
        }
        schedulingError = null;
    }

    // Resolve a selected clock time to today or tomorrow in Copenhagen.
    private DateTime GetScheduledDateTime(int hour, int minute)
    {
        DateTime now = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, CopenhagenTimeZone);
        DateTime scheduledTime = now.Date.AddHours(hour).AddMinutes(minute);

        if (scheduledTime < now)
        {
            scheduledTime = scheduledTime.AddDays(1);
        }
        return scheduledTime;
    }
    // Request an optimized plan and show its result in the overview.
    private async Task GenerateScheduling()
    {
        if (IsEditMode)
            return;

        schedulingError = null;
        if (isNonInterruptible && (ScheduleForm.Preset?.id ?? 0) <= 0)
        {
            schedulingError = "Select a device preset before generating a plan.";
            return;
        }

        if (isInterruptible && ScheduleForm.ChargeStopPercentage is null)
        {
            schedulingError = "Select a charge percentage before generating a plan.";
            return;
        }

        response = null;
        displayPlan = false;
        requestedWindowStart = null;
        requestedWindowEnd = null;
        DateTime startTime = GetScheduledDateTime(ScheduleForm.StartHour!.Value, ScheduleForm.StartMinute!.Value);
        DateTime endTime = GetScheduledDateTime(ScheduleForm.EndHour!.Value, ScheduleForm.EndMinute!.Value);

        if (endTime <= startTime)
        {
            endTime = endTime.AddDays(1);
        }

        int timeWindow = (int)(endTime - startTime).TotalMinutes;

        if (ScheduleForm.Preset != null && ScheduleForm.Preset.duration > timeWindow)
        {
            schedulingError = $"The selected program requires {ScheduleForm.Preset.duration} minutes.";
            return;
        }

        try
        {
            requestedWindowStart = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(startTime, DateTimeKind.Unspecified), CopenhagenTimeZone);
            requestedWindowEnd = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(endTime, DateTimeKind.Unspecified), CopenhagenTimeZone);
        }
        catch (ArgumentException)
        {
            schedulingError = "The selected time does not exist on this date. Choose another time.";
            return;
        }


        OptimizationRequestDTO? optimizationRequest = new OptimizationRequestDTO
        {
            Area = area,
            DeviceName = ScheduleForm.DeviceName,
            BatteryCapacityInKwh = SelectedDevice?.batteryCapacityInKwh,
            ChargeStopPercentage = isInterruptible ? ScheduleForm.ChargeStopPercentage : null,
            Preset = isInterruptible ? null : ScheduleForm.Preset,
            StartTime = startTime,
            EndTime = endTime,
            Priority = ScheduleForm.Priority
        };

        try
        {
            HttpResponseMessage? result = await Http.PostAsJsonAsync("api/optimization-controller/optimize", optimizationRequest);

            if (!result.IsSuccessStatusCode)
            {
                Console.WriteLine($"Optimization did not work {result.StatusCode}");
            }
            else
            {
                response = await result.Content.ReadFromJsonAsync<OptimizationResultDTO>();
                
                displayPlan = true;

                Console.WriteLine("Optimization worked");
            }    
        }
        catch (Exception e)
        {
            Console.WriteLine($"Error with opptimization: {e.Message}");
        }

        await Task.CompletedTask;
        return ;
    }

    // Save the generated plan and its form values through the API.
    private async Task addPlan()
    {
        PlanUserDeviceDto? selectedDevice = userDevices
            .FirstOrDefault(d => d.id.ToString() == selectedDeviceId);

        if (selectedDevice == null)
        {
            Console.WriteLine("No device selected");
            return;
        }

        if (response is null || requestedWindowStart is null || requestedWindowEnd is null)
        {
            Console.WriteLine("Optimization result or requested window is missing");
            return;
        }

        (UnscheduledEstimateDto? unscheduledEstimate, string? baselineError) =
            await GetUnscheduledEstimateAsync(
            selectedDevice,
            response.StartTime,
            response.EndTime,
            requestedWindowStart.Value);

        if (unscheduledEstimate is null)
        {
            schedulingError = baselineError ?? "Could not calculate the unscheduled baseline.";
            return;
        }

        PlanDTO? planToSave = new PlanDTO
        {
            userDeviceId = selectedDevice.id,
            startTime = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(response.StartTime, DateTimeKind.Unspecified), CopenhagenTimeZone),
            endTime = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(response.EndTime, DateTimeKind.Unspecified), CopenhagenTimeZone),
            windowStartTime = requestedWindowStart.Value,
            windowEndTime = requestedWindowEnd.Value,
            nextPlanId = null,
            estimatedCost = response.EstimatedPrice,
            estimatedCo2Emissions = response.EstimatedCo2Emissions,
            estimatedUnscheduledCost = unscheduledEstimate.EstimatedPrice,
            estimatedUnscheduledCo2Emissions = unscheduledEstimate.EstimatedCo2Emissions,
            planName = (ScheduleForm.PlanName == string.Empty) ? ScheduleForm.DeviceName : ScheduleForm.PlanName,
            optimizationObjective = ScheduleForm.Priority,
            presetId = ScheduleForm.Preset?.id,
            chargeStopPercentage = isInterruptible ? ScheduleForm.ChargeStopPercentage : null,
            batteryCapacityInKwh = selectedDevice.batteryCapacityInKwh
        };

        try
        {
            HttpResponseMessage? result = await Http.PostAsJsonAsync("api/createPlan-controller/post-plan", planToSave);
            if (result.IsSuccessStatusCode)
            {
                PlanDTO? savedPlan = await result.Content.ReadFromJsonAsync<PlanDTO>();
                if (savedPlan?.planId is int newPlanId)
                    PlanState.SelectedPlanId = newPlanId;

                Console.WriteLine("Plan saved");
                ClearSchedule();
                NavigationManager.NavigateTo("/optimized");

            }

            else
            {
                string? error = await result.Content.ReadAsStringAsync();
                Console.WriteLine($"Failed to save plan: {result.StatusCode} - {error}");
            }
        }
        catch (Exception e)
        {
            Console.WriteLine($"Error with saving plan: {e.Message}");
        }

    }

    private async Task<(UnscheduledEstimateDto? Estimate, string? Error)> GetUnscheduledEstimateAsync(
        PlanUserDeviceDto selectedDevice,
        DateTime optimizedStart,
        DateTime optimizedEnd,
        DateTime baselineStart)
    {
        decimal energyInKwh;

        if (isInterruptible)
        {
            // Interruptible baseline workload is the selected charge-stop percentage of the battery capacity.
            if (selectedDevice.batteryCapacityInKwh is not decimal batteryCapacity ||
                ScheduleForm.ChargeStopPercentage is not int chargeStopPercentage)
            {
                return (null, "Battery capacity and charge-stop percentage are required.");
            }

            energyInKwh = batteryCapacity * chargeStopPercentage / 100m;
        }
        else if (ScheduleForm.Preset?.consumption is decimal presetConsumption)
        {
            energyInKwh = presetConsumption;
        }
        else
        {
            return (null, "A device preset with consumption data is required.");
        }

        TimeSpan workloadDuration = optimizedEnd - optimizedStart;
        DateTime baselineEnd = baselineStart + workloadDuration;

        UnscheduledEstimateRequestDto request = new UnscheduledEstimateRequestDto()
        {
            AreaCode = area,
            StartTime = baselineStart,
            EndTime = baselineEnd,
            EnergyInKwh = energyInKwh
        };

        HttpResponseMessage response = await Http.PostAsJsonAsync(
            "api/electricity-price-controller/unscheduled-estimate",
            request);

        if (!response.IsSuccessStatusCode)
        {
            string error = await response.Content.ReadAsStringAsync();
            return (null, string.IsNullOrWhiteSpace(error)
                ? "Could not calculate the unscheduled baseline."
                : error);
        }

        UnscheduledEstimateDto? estimate =
            await response.Content.ReadFromJsonAsync<UnscheduledEstimateDto>();
        return estimate is null
            ? (null, "The backend returned an empty unscheduled baseline.")
            : (estimate, null);
    }

    private Task SubmitPlan() => IsEditMode ? UpdatePlanAsync() : addPlan();

    private async Task UpdatePlanAsync()
    {
        if (!editLoaded || existingPlan is null || editingPlanId <= 0 || string.IsNullOrWhiteSpace(userId))
            return;

        schedulingError = null;
        if (!int.TryParse(selectedDeviceId, out int deviceId) ||
            ScheduleForm.StartHour is null || ScheduleForm.StartMinute is null ||
            ScheduleForm.EndHour is null || ScheduleForm.EndMinute is null)
        {
            schedulingError = "Select a device and scheduling window.";
            return;
        }

        if (isNonInterruptible && (ScheduleForm.Preset?.id ?? 0) <= 0)
        {
            schedulingError = "Select a device preset before updating.";
            return;
        }

        if (isInterruptible && ScheduleForm.ChargeStopPercentage is null)
        {
            schedulingError = "Select a charge percentage before updating.";
            return;
        }

        string planName = string.IsNullOrWhiteSpace(ScheduleForm.PlanName)
            ? ScheduleForm.DeviceName
            : ScheduleForm.PlanName.Trim();
        if (planName.Length > 100)
        {
            schedulingError = "The plan name cannot exceed 100 characters.";
            return;
        }

        DateTime localOriginalStart = existingPlan.windowStartTime!.Value;
        DateTime localStart = DateTime.SpecifyKind(localOriginalStart.Date
            .AddHours(ScheduleForm.StartHour.Value)
            .AddMinutes(ScheduleForm.StartMinute.Value), DateTimeKind.Unspecified);
        DateTime localEnd = DateTime.SpecifyKind(localStart.Date
            .AddHours(ScheduleForm.EndHour.Value)
            .AddMinutes(ScheduleForm.EndMinute.Value), DateTimeKind.Unspecified);
        if (localEnd <= localStart)
            localEnd = localEnd.AddDays(1);

        if (CopenhagenTimeZone.IsInvalidTime(localStart) || CopenhagenTimeZone.IsInvalidTime(localEnd))
        {
            schedulingError = "The selected time does not exist on this date. Choose another time.";
            return;
        }

        PlanUserDeviceDto? selectedDevice = SelectedDevice;
        if (selectedDevice is null)
        {
            schedulingError = "Select a valid device before updating.";
            return;
        }

        (UnscheduledEstimateDto? unscheduledEstimate, string? baselineError) =
            await GetUnscheduledEstimateAsync(
            selectedDevice,
            existingPlan.startTime,
            existingPlan.endTime,
            localStart);
        if (unscheduledEstimate is null)
        {
            schedulingError = baselineError ?? "Could not calculate the unscheduled baseline.";
            return;
        }

        PlanDTO? update = new PlanDTO
        {
            planId = editingPlanId,
            userDeviceId = deviceId,
            planName = planName,
            windowStartTime = TimeZoneInfo.ConvertTimeToUtc(localStart, CopenhagenTimeZone),
            windowEndTime = TimeZoneInfo.ConvertTimeToUtc(localEnd, CopenhagenTimeZone),
            optimizationObjective = ScheduleForm.Priority,
            presetId = ScheduleForm.Preset?.id,
            chargeStopPercentage = isInterruptible ? ScheduleForm.ChargeStopPercentage : null,
            batteryCapacityInKwh = selectedDevice.batteryCapacityInKwh,
            estimatedUnscheduledCost = unscheduledEstimate.EstimatedPrice,
            estimatedUnscheduledCo2Emissions = unscheduledEstimate.EstimatedCo2Emissions
        };

        Logger.LogInformation(
            "Updating plan {PlanId}: selected window {SelectedStartTime}–{SelectedEndTime}, sent window {WindowStartTime}–{WindowEndTime}",
            editingPlanId, localStart, localEnd, update.windowStartTime, update.windowEndTime);

        try
        {
            using HttpRequestMessage? request = new HttpRequestMessage(HttpMethod.Put,
                $"api/plan-controller/update-plan/{editingPlanId}")
            {
                Content = JsonContent.Create(update)
            };
            request.Headers.Add("UserId", userId);
            using HttpResponseMessage result = await Http.SendAsync(request);
            if (!result.IsSuccessStatusCode)
            {
                schedulingError = $"The plan could not be updated: {await result.Content.ReadAsStringAsync()}";
                return;
            }

            PlanDTO? savedPlan = await result.Content.ReadFromJsonAsync<PlanDTO>();
            if (savedPlan?.planId != editingPlanId)
            {
                schedulingError = "The server returned a different plan after the update. Please reload before editing again.";
                Logger.LogWarning("Updated plan ID mismatch: requested {PlanId}, received {ReturnedPlanId}",
                    editingPlanId, savedPlan?.planId);
                return;
            }

            Logger.LogInformation(
                "Updated plan {PlanId}: server returned window {WindowStartTime}–{WindowEndTime}",
                savedPlan.planId, savedPlan.windowStartTime, savedPlan.windowEndTime);
            PlanState.SelectedPlanId = editingPlanId;
            PlanState.ReturnToSelectedPlan = true;
            NavigationManager.NavigateTo("/optimized");
        }
        catch (Exception exception)
        {
            schedulingError = $"The plan could not be updated: {exception.Message}";
        }
    }
}

