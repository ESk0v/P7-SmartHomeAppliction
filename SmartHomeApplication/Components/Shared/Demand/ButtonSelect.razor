
@inject IJSRuntime JS
@implements IDisposable

<div class="plan-picker @CssClass" data-picker @ref="picker">
    <button id="@ControlId" @ref="trigger" type="button" class="plan-picker-trigger"
            aria-haspopup="listbox" aria-expanded="@(open ? "true" : "false")" aria-controls="@(open ? ControlId + "-options" : null)"
            aria-label="@(Label is null ? null : $"{Label}: {Options.FirstOrDefault(option => option.Value == Value).Text ?? Placeholder}")" aria-describedby="@DescribedBy" aria-invalid="@(HasError ? "true" : null)" @onclick="Toggle">
        <span class="@(Options.Any(option => option.Value == Value) ? null : "plan-picker-placeholder")">
            @if (OptionContent is not null && Options.Any(option => option.Value == Value))
            {
                @OptionContent(Options.First(option => option.Value == Value))
            }
            else
            {
                @(Options.FirstOrDefault(x => x.Value == Value).Text ?? Placeholder)
            }
        </span>
        <span aria-hidden="true" class="plan-picker-chevron @(open ? "plan-picker-chevron-open" : "")"></span>
    </button>

    @if (open)
    {
        <div id="@(ControlId + "-options")" class="plan-picker-menu" role="listbox" aria-label="@(Label ?? Placeholder)">
            @foreach (var option in Options)
            {
                <button type="button"
                        data-value="@option.Value" role="option" tabindex="-1" aria-selected="@(option.Value == Value ? "true" : "false")"
                        class="plan-picker-option @(option.Value == Value ? "plan-picker-option-selected" : "")"
                        @onclick="() => Select(option.Value)">
                    @if (OptionContent is not null) { @OptionContent(option) } else { @option.Text }
                    @if (option.Value == Value)
                    {
                        <span class="plan-picker-check" aria-hidden="true">✓</span>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<(string Value, string Text)> Options { get; set; } = [];
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string? Id { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? DescribedBy { get; set; }
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public RenderFragment<(string Value, string Text)>? OptionContent { get; set; }
    [Parameter] public string? FieldName { get; set; }
    [CascadingParameter] private EditContext? FormContext { get; set; }
    private EditContext? subscribedContext;
    private bool HasError => Invalid || (FieldName is not null && FormContext?.GetValidationMessages(new FieldIdentifier(FormContext.Model, FieldName)).Any() == true);

    protected override void OnParametersSet()
    {
        if (subscribedContext == FormContext) return;
        Dispose();
        subscribedContext = FormContext;
        if (subscribedContext is not null) subscribedContext.OnValidationStateChanged += ValidationChanged;
    }
    private void ValidationChanged(object? sender, ValidationStateChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        if (subscribedContext is not null) subscribedContext.OnValidationStateChanged -= ValidationChanged;
    }

    private readonly string generatedId = $"picker-{Guid.NewGuid():N}";
    private string ControlId => Id ?? generatedId;
    private ElementReference picker, trigger;
    private bool open, focusMenu, restoreFocus;

    private void Toggle()
    {
        open = !open;
        focusMenu = open;
    }

    private async Task Select(string value)
    {
        open = false;
        restoreFocus = true;
        await ValueChanged.InvokeAsync(value);
        if (FormContext is not null && FieldName is not null)
            FormContext.NotifyFieldChanged(new FieldIdentifier(FormContext.Model, FieldName));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusMenu && open)
        {
            focusMenu = false;
            await JS.InvokeVoidAsync("smartHomeAccessibility.focusSelectedOption", picker);
        }
        if (restoreFocus)
        {
            restoreFocus = false;
            await JS.InvokeVoidAsync("smartHomeAccessibility.focus", trigger);
        }
    }
}

<style>


    .plan-picker {
        position: relative;
    }

    .plan-picker-trigger {
        align-items: center;
        appearance: none;
        background: #fff;
        border: 0;
        border-radius: 0.75rem;
        color: #222;
        cursor: pointer;
        display: flex;
        font: inherit;
        font-size: 1.1rem;
        gap: 0.75rem;
        min-width: 20rem;
        padding: 0.3rem 0.85rem;
        text-align: left;
        transition: background-color 150ms ease, box-shadow 150ms ease;
    }

    .plan-picker-trigger:hover {
        background: #f5f9fd;
    }

    .plan-picker-trigger:focus-visible {
        background: #f5f9fd;
        outline: 2px solid #0a66c3;
        outline-offset: 2px;
    }

    .plan-picker-icon {
        color: #0a66c3;
        display: inline-flex;
        flex-shrink: 0;
        height: 1.4rem;
        width: 1.4rem;
    }

    .plan-picker-icon svg {
        height: 100%;
        width: 100%;
    }

    .plan-picker-chevron {
        border-bottom: 2px solid #999;
        border-right: 2px solid #999;
        height: 0.6rem;
        margin-left: auto;
        transform: rotate(45deg) translateY(-0.15rem);
        transition: border-color 150ms ease, transform 150ms ease;
        width: 0.6rem;
    }

    .plan-picker-chevron-open {
        border-color: #0a66c3;
        transform: rotate(225deg) translateY(-0.05rem);
    }

    .plan-picker-menu {
        background: #f2f2ee;
        border: 1px solid #e2ded9;
        border-radius: 0.75rem;
        box-shadow: 0 0.5rem 1.2rem rgba(34, 34, 34, 0.14);
        left: 0;
        max-height: 220px;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 0.25rem 0;
        position: absolute;
        right: 0;
        top: calc(100% + 0.4rem);
        z-index: 10;
    }

    .plan-picker-option {
        align-items: center;
        background: #f2f1f3;
        border: 0;
        color: #222;
        cursor: pointer;
        display: flex;
        font: inherit;
        font-size: 1.1rem;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        text-align: left;
        width: 100%;
    }

    .plan-picker-option:hover {
        background: #edf5fd;
    }

    .plan-picker-option:focus-visible {
        background: #edf5fd;
        outline: 2px solid #0a66c3;
        outline-offset: 2px;
    }

    .plan-picker-option-selected {
        background: #deedfc;
    }

    .plan-picker-check {
        color: #0a66c3;
        font-size: 1.2rem;
        font-weight: 600;
        margin-left: auto;
    }

    .plan-picker-trigger {
        min-width: 0;
        width: 100%;
        background-color: #f0f5fa;

    }

    .time-picker {
        width: 5rem;
    }

    .time-picker .plan-picker-trigger {
        padding: 0.4rem;
        font-size: 1rem;
        justify-content: center;
    }

    .time-picker .plan-picker-menu {
        min-width: 5rem;
    }

    .time-picker .plan-picker-option {
        padding: 0.6rem 0.4rem;
    }

</Style>
