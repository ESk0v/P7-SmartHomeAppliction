@if (Href is not null)
{
    <a class="header-button header-button-primary" href="@Href">@Content</a>
}
else
{
    <button type="button" class="header-button header-button-primary" @onclick="OnClick">@Content</button>
}

@code {
    [Parameter] public string? Href { get; set; }
    private RenderFragment Content => @<text>
        @if (ShowPlusIcon)
        {
            <span class="header-button-icon" aria-hidden="true"><i aria-hidden="true" class="bi bi-plus"></i></span>
        }
        @ChildContent
    </text>;

    [Parameter]
    public bool ShowPlusIcon { get; set; } = true;

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

<style>
    .header-button {
        text-decoration: none;
        align-items: center;
        border-radius: 0.45rem;
        cursor: pointer;
        display: inline-flex;
        font: inherit;
        font-size: 0.85rem;
        justify-content: center;
        min-height: 2.3rem;
        padding: 0.375rem 0.75rem;
        transition: background-color 150ms ease, border-color 150ms ease;
    }

    .header-button:focus-visible {
        outline: 2px solid #042250;
        outline-offset: 3px;
    }

    .header-button-primary {
        background: #0a66c3;
        border: 1px solid #0a66c3;
        color: #fff;
        min-width: 8rem;
    }

    .header-button-primary:hover {
        background-color: #084f98;
        border-color: #084f98;
    }

    .header-button-icon {
        align-items: center;
        display: inline-flex;
        flex-shrink: 0;
        font-size: 1rem;
        height: 1rem;
        justify-content: center;
        margin-right: 0.375rem;
        width: 1rem;
    }

    @@media (max-width: 640.98px) {
        .header-button {
            flex: 1;
        }
    }
</style>
