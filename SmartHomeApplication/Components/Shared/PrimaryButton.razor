<button type="button" class="header-button header-button-primary">
    @if (ShowPlusIcon)
    {
        <span class="header-button-icon" aria-hidden="true">@Icons.Plus</span>
    }

    @ChildContent
</button>

@code {
    [Parameter]
    public bool ShowPlusIcon { get; set; } = true;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

<style>
    .header-button {
        align-items: center;
        border-radius: 0.45rem;
        cursor: pointer;
        display: inline-flex;
        font: inherit;
        font-size: 0.85rem;
        justify-content: center;
        min-height: 2.3rem;
        padding: 0.375rem 0.75rem;
        transition: background-color 150ms ease, border-color 150ms ease;
    }

    .header-button:focus-visible {
        outline: 1.5px solid #a9a0ff;
        outline-offset: 1px;
    }

    .header-button-primary {
        background: #7569e8;
        border: 1px solid #7569e8;
        color: #fff;
        min-width: 8rem;
    }

    .header-button-primary:hover {
        background-color: #5f54c9;
        border-color: #5f54c9;
    }

    .header-button-icon {
        display: inline-flex;
        flex-shrink: 0;
        height: 1rem;
        margin-right: 0.375rem;
        width: 1rem;
    }

    .header-button-icon svg {
        display: block;
        height: 100%;
        width: 100%;
    }

    @@media (max-width: 640.98px) {
        .header-button {
            flex: 1;
        }
    }
</style>