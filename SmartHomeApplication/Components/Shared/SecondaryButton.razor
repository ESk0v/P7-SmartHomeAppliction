<button type="button" class="header-button header-button-secondary">
    @if (Icon is not null)
    {
        <span class="header-button-icon" aria-hidden="true">@Icon</span>
    }

    @ChildContent
</button>

@code {
    [Parameter]
    public RenderFragment? Icon { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

<style>
    .header-button {
        align-items: center;
        border-radius: 0.45rem;
        cursor: pointer;
        display: inline-flex;
        font: inherit;
        font-size: 0.75rem;
        justify-content: center;
        min-height: 2.3rem;
        padding: 0.375rem 0.75rem;
        transition: background-color 150ms ease, border-color 150ms ease;
    }

    .header-button:focus-visible {
        outline: 1.5px solid #a9a0ff;
        outline-offset: 1px;
    }

    .header-button-secondary {
        background: #fff;
        border: 1px solid #e2ded9;
        color: #222;
        min-width: 7rem;
    }

    .header-button-secondary:hover {
        background-color: #e8e5e1;
        border-color: #d2ccc5;
    }

    .header-button-icon {
        display: inline-flex;
        flex-shrink: 0;
        height: 1rem;
        margin-right: 0.375rem;
        width: 1rem;
    }

    .header-button-icon svg {
        display: block;
        height: 100%;
        width: 100%;
    }

    @@media (max-width: 640.98px) {
        .header-button {
            flex: 1;
        }
    }
</style>