@inject INotificationService NotificationService
@implements IDisposable

<div class="visually-hidden" role="status" aria-atomic="true">@(_isVisible && _level != ToastLevel.Error && _level != ToastLevel.Warning ? $"{_heading}: {_message}" : null)</div>
<div class="visually-hidden" role="alert" aria-atomic="true">@(_isVisible && (_level == ToastLevel.Error || _level == ToastLevel.Warning) ? $"{_heading}: {_message}" : null)</div>
<div class="custom-toast @(_isVisible ? "custom-toast-visible" : "") @(_backgroundCssClass)">
    <div class="custom-toast-icon" aria-hidden="true">
        <i class="fa fa-@_iconCssClass" aria-hidden="true"></i>
    </div>
    <div class="custom-toast-body" aria-hidden="true">
        <strong class="inline-heading">@_heading</strong>
        <p class="inline-message">@_message</p>
    </div>
    <button type="button" class="toast-dismiss" aria-label="Dismiss notification" @onclick="NotificationService.DismissNotification">×</button>
</div>

@code {
    private string? _heading;
    private string? _message;
    private bool _isVisible;
    private ToastLevel _level;
    private string? _backgroundCssClass;
    private string? _iconCssClass;
    
    protected override void OnInitialized()
    {
        NotificationService.OnShow += ShowToast;
        NotificationService.OnHide += HideToast;
    }
    
    private void ShowToast(string message, ToastLevel level)
    {
        _level = level;
        BuildToastSettings(level, message);
        _isVisible = true;
        InvokeAsync(StateHasChanged);
    }
    
    private void HideToast()
    {
        _isVisible = false;
        InvokeAsync(StateHasChanged);
    }
    
    private void BuildToastSettings(ToastLevel level, string message)
    {
        (_backgroundCssClass, _iconCssClass, _heading) = level switch
        {
            ToastLevel.Success => ("text-success", "check", "Success"),
            ToastLevel.Error => ("text-danger", "times", "Error"),
            ToastLevel.Warning => ("text-warning", "exclamation", "Warning"),
            ToastLevel.Info => ("text-info", "info", "Info"),
            _ => ("text-info", "info", "Notification")
        };
        
        _message = message;
    }
    
    public void Dispose()
    {
        NotificationService.OnShow -= ShowToast;
        NotificationService.OnHide -= HideToast;
    }
}
<style>
    .toast-dismiss { align-self: flex-start; background: transparent; border: 0; color: #292724; font-size: 1.4rem; min-width: 28px; min-height: 28px; padding: 0; }
    .custom-toast .custom-toast-body { min-width: 0; overflow-wrap: anywhere; }

    .custom-toast {
        display: none;
        position: fixed;
        top: 5rem;
        right: 2rem;
        z-index: 999999;
        align-items: center;
        gap: 1rem;
        min-width: 340px;
        max-width: 480px;
        padding: 1.1rem 1.5rem;
        border-radius: .75rem;
        background-color: #ffffff;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    .custom-toast-visible {
        display: flex;
        flex-direction: row;
        animation: fadein 0.3s ease-in;
    }

    .custom-toast-icon { font-size: 1.75rem; line-height: 1; }

    .custom-toast-body .inline-heading {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0 0 .15rem 0;
    }

    .custom-toast-body .inline-message {
        font-size: 1rem;
        margin: 0;
        color: #333;
    }

    @@keyframes fadein {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .text-success { border-left: 6px solid #28a745; }
    .text-danger  { border-left: 6px solid #dc3545; }
    .text-warning { border-left: 6px solid #ffc107; }
    .text-info    { border-left: 6px solid #17a2b8; }

    .text-success .custom-toast-icon, .text-success .inline-heading { color: #1a7832; }
    .text-danger  .custom-toast-icon, .text-danger  .inline-heading { color: #dc3545; }
    .text-warning .custom-toast-icon, .text-warning .inline-heading { color: #805e08; }
    .text-info    .custom-toast-icon, .text-info    .inline-heading { color: #0b7181; }

    @@media (max-width: 640.98px), (max-width: 960px) and (max-height: 500px) and (pointer: coarse) {
        .custom-toast {
            top: 1rem;
            left: 1rem;
            right: 1rem;
            min-width: 0;
            max-width: none;
            padding: 1rem;
            gap: 0.75rem;
        }

        .custom-toast .custom-toast-body {
            min-width: 0;
            overflow-wrap: anywhere;
        }

    }
</style>
