@inject INotificationService NotificationService
@implements IDisposable

<div class="custom-toast @(_isVisible ? "custom-toast-visible" : "") @(_backgroundCssClass)">
    <div class="custom-toast-icon">
        <i class="fa fa-@_iconCssClass" aria-hidden="true"></i>
    </div>
    <div class="custom-toast-body">
        <h6 class="inline-heading">@_heading</h6>
        <p class="inline-message">@_message</p>
    </div>
</div>

@code {
    private string? _heading;
    private string? _message;
    private bool _isVisible;
    private string? _backgroundCssClass;
    private string? _iconCssClass;
    
    protected override void OnInitialized()
    {
        NotificationService.OnShow += ShowToast;
        NotificationService.OnHide += HideToast;
    }
    
    private void ShowToast(string message, ToastLevel level)
    {
        BuildToastSettings(level, message);
        _isVisible = true;
        InvokeAsync(StateHasChanged);
    }
    
    private void HideToast()
    {
        _isVisible = false;
        InvokeAsync(StateHasChanged);
    }
    
    private void BuildToastSettings(ToastLevel level, string message)
    {
        (_backgroundCssClass, _iconCssClass, _heading) = level switch
        {
            ToastLevel.Success => ("text-success", "check", "Success"),
            ToastLevel.Error => ("text-danger", "times", "Error"),
            ToastLevel.Warning => ("text-warning", "exclamation", "Warning"),
            ToastLevel.Info => ("text-info", "info", "Info"),
            _ => ("text-info", "info", "Notification")
        };
        
        _message = message;
    }
    
    public void Dispose()
    {
        NotificationService.OnShow -= ShowToast;
        NotificationService.OnHide -= HideToast;
    }
}
<style>
    .custom-toast {
        display: none;
        position: fixed;
        top: 5rem;                 
        right: 2rem;
        z-index: 999999;
        align-items: center;
        gap: 1rem;
        min-width: 340px;
        max-width: 480px;
        padding: 1.1rem 1.5rem;
        border-radius: .75rem;
        background-color: #ffffff;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    .custom-toast-visible {
        display: flex;
        flex-direction: row;
        animation: fadein 0.3s ease-in;
    }

    .custom-toast-icon { font-size: 1.75rem; line-height: 1; }

    .custom-toast-body .inline-heading {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0 0 .15rem 0;
    }

    .custom-toast-body .inline-message {
        font-size: 1rem;
        margin: 0;
        color: #333;              
    }

    @@keyframes fadein {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .text-success { border-left: 6px solid #28a745; }
    .text-danger  { border-left: 6px solid #dc3545; }
    .text-warning { border-left: 6px solid #ffc107; }
    .text-info    { border-left: 6px solid #17a2b8; }

    .text-success .custom-toast-icon, .text-success .inline-heading { color: #28a745; }
    .text-danger  .custom-toast-icon, .text-danger  .inline-heading { color: #dc3545; }
    .text-warning .custom-toast-icon, .text-warning .inline-heading { color: #b8860b; }
    .text-info    .custom-toast-icon, .text-info    .inline-heading { color: #17a2b8; }
</style>