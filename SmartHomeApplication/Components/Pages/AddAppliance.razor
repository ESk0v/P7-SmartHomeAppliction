            border-color: var(--smarthome-border);
        }

        .add-appliance-layout .catalogue-scroll {
            flex: 1;
            min-height: 0;
            height: auto;
            max-height: none;
            margin-top: 0.75rem;
        }

        .add-appliance-layout .appliance-form-card {
            overflow-y: auto;
        }

        .add-appliance-layout .catalogue-scroll table {
            width: 100%;
            table-layout: fixed;
            margin-bottom: 0;
            font-size: 0.875rem;
        }

        .add-appliance-layout .catalogue-scroll th,
        .add-appliance-layout .catalogue-scroll td {
            padding: 0.85rem 1rem;
            vertical-align: middle;
            overflow-wrap: anywhere;
        }

        .add-appliance-layout .catalogue-scroll .btn {
            font-size: inherit;
        }

        .add-appliance-layout .catalogue-scroll tbody tr:hover {
            --bs-table-bg: #edf5fd;
        }

        .add-appliance-layout .info-tooltip .info-tooltiptext {
            display: none;
            position: absolute;
            width: min(22rem, 100%);
            left: 0;
            top: calc(100% + 0.5rem);
            bottom: auto;
            transform: none;
            padding: 0.85rem 1rem;
            background: #464646;
            color: #fff;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 400;
            line-height: 1.5;
