        }

        .add-appliance-layout .appliance-form-card,
        .add-appliance-layout .catalogue-card {
            padding: 1rem !important;
            min-width: 0;
        }

        .add-appliance-layout .plan-picker-trigger,
        .add-appliance-layout .plan-picker-option {
            min-width: 0;
            width: 100%;
            min-height: 44px;
            white-space: normal;
            overflow-wrap: anywhere;
        }

        .add-appliance-layout .plan-picker-menu {
            max-height: min(220px, 50dvh);
        }

        .add-appliance-layout .catalogue-scroll table {
            table-layout: fixed;
            width: 100%;
            margin-bottom: 0;
        }

        .add-appliance-layout .catalogue-scroll th,
        .add-appliance-layout .catalogue-scroll td,
        .add-appliance-layout .catalogue-scroll button {
