@page "/add-device"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject SmartHomeApplication.Service.IDeviceService DeviceService
@inject INotificationService NotificationService
@using Utilities.Models
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.QuickGrid
@using SmartHomeApplication.Components.Shared.Demand

<PageTitle>Add Device</PageTitle>

<SectionContent SectionName="TopBarActions">
    <div class="header">
        <div class="heading">
            <h1>Device registry</h1>
            <p>@amount devices</p>
        </div>

        <div class="header-actions">
            <PrimaryButton Href="device" ShowPlusIcon="false">
                Go back
                </PrimaryButton>
        </div>
    </div>
</SectionContent>

<div class="row add-appliance-layout">
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 p-4 bg-white appliance-form-card">
            <h2 class="h5 mb-4">Add a new device</h2>
                    <EditForm @ref="editForm" Method="post" Model="CreateDeviceDto" OnValidSubmit="CreateDevice" FormName="AddDeviceForm" data-enhance="false">
                        <AntiforgeryToken/>
                        <DataAnnotationsValidator />
                <FormErrors FieldIds='@(new Dictionary<string, string> { [nameof(CreateDeviceDto.Model)] = "deviceModel", [nameof(CreateDeviceDto.Category)] = "deviceCategory", [nameof(CreateDeviceDto.BatteryCapacityInKwh)] = "deviceBatteryCapacity", [nameof(CreateDeviceDto.ConsumptionInKwh)] = string.IsNullOrEmpty(CreateDeviceDto.Category) ? "deviceCategory" : "deviceConsumption", [nameof(CreateDeviceDto.Preset)] = string.IsNullOrEmpty(CreateDeviceDto.Category) ? "deviceCategory" : IsCustomPreset ? "customPresetName" : "devicePreset", [nameof(CreateDeviceDto.DurationInMinutes)] = "deviceDuration" })' />
                        <div class="mb-3">
                            <label for="deviceModel" class="form-label">Device Model</label>
                            <InputText id="deviceModel" aria-describedby="deviceModel-error"
                               class="form-control"
                               Value="@CreateDeviceDto.Model"
                               ValueChanged="@((string? v) => CreateDeviceDto.Model = v ?? "")"
                               ValueExpression="@(() => CreateDeviceDto.Model)"
                               @oninput="e => CreateDeviceDto.Model = e.Value?.ToString() ?? string.Empty" />
                            <ValidationMessage For="() => CreateDeviceDto.Model" class="text-danger" id="deviceModel-error" />
                        </div> 
                        <div class="mb-3">
                            <label for="deviceCategory" class="form-label">Device Category</label>
                            <details class="category-help">
                                <summary>About device categories</summary>
                                <p id="category-help">Interruptible devices, such as EV chargers, can be paused. Non-interruptible devices, such as washing machines, must finish their cycle without pausing.</p>
                            </details>
                            <ButtonSelect Id="deviceCategory" Label="Device category" FieldName="Category" DescribedBy="deviceCategory-error category-help"
                                          Options="@(categories.Select(category => (Value: category, Text: category)))"
                                          @bind-Value="CreateDeviceDto.Category"
                                          @bind-Value:after="CategoryChanged"
                                          Placeholder="Select a category" />
                            <ValidationMessage For="() => CreateDeviceDto.Category" class="text-danger" id="deviceCategory-error" />
                        </div>
                        @if (IsInterruptible && CreateDeviceDto.Category != "")
                        {
                            <div class="mb-3">
                                <label for="deviceBatteryCapacity" class="form-label">Battery Capacity (kWh)</label>
                                <InputNumber id="deviceBatteryCapacity" aria-describedby="deviceBatteryCapacity-error" class="form-control" @bind-Value="CreateDeviceDto.BatteryCapacityInKwh" />
                                <ValidationMessage For="() => CreateDeviceDto.BatteryCapacityInKwh" class="text-danger" id="deviceBatteryCapacity-error" />
                            </div>
                            <div class="mb-3">
                                <label for="deviceConsumption" class="form-label">Charging Speed (kWh)</label>
                                <InputNumber id="deviceConsumption" aria-describedby="deviceConsumption-error" class="form-control" @bind-Value="CreateDeviceDto.ConsumptionInKwh" />
                                <ValidationMessage For="() => CreateDeviceDto.ConsumptionInKwh" class="text-danger" id="deviceConsumption-error" />
                            </div>
                        }
                        else if (!IsInterruptible && CreateDeviceDto.Category != "")
                        {
                          <div class="mb-3">
                                <label for="devicePreset" class="form-label">Preset</label>
                                <ButtonSelect Id="devicePreset" Label="Preset" FieldName="Preset" DescribedBy="devicePreset-error"
                                              Options="@(CreateDeviceDto.Presets.Select(preset => (Value: preset.PresetName, Text: preset.PresetName))
                                                  .Append((CustomPresetOption, "+ Create a new preset")))"
                                              @bind-Value="selectedPresetOption"
                                              @bind-Value:after="PresetSelectionChanged"
                                              Placeholder="Select a preset" />
                                <ValidationMessage For="() => CreateDeviceDto.Preset" class="text-danger" id="devicePreset-error" />
                            </div>
                            @if (IsCustomPreset)
                            {
                                <div class="mb-3">
                                    <label for="customPresetName" class="form-label">Preset name</label>
                                    <InputText id="customPresetName" aria-describedby="customPresetName-error" class="form-control" @bind-Value="CreateDeviceDto.Preset" />
                                    <ValidationMessage For="() => CreateDeviceDto.Preset" class="text-danger" id="customPresetName-error" />
                                </div>
                                <div class="mb-3">
                                    <label for="deviceConsumption" class="form-label">Consumption (kWh)</label>
                                    <InputNumber id="deviceConsumption" aria-describedby="deviceConsumption-error" class="form-control" @bind-Value="CreateDeviceDto.ConsumptionInKwh" />
                                    <ValidationMessage For="() => CreateDeviceDto.ConsumptionInKwh" class="text-danger" id="deviceConsumption-error" />
                                </div>
                                <div class="mb-3">
                                    <label for="deviceDuration" class="form-label">Duration (minutes)</label>
                                    <InputNumber id="deviceDuration" aria-describedby="deviceDuration-error" class="form-control" @bind-Value="CreateDeviceDto.DurationInMinutes" />
                                    <ValidationMessage For="() => CreateDeviceDto.DurationInMinutes" class="text-danger" id="deviceDuration-error" />
                                </div>
                            }
                            else 
                            {
                                <div class="mb-3">
                                    <label for="deviceConsumption" class="form-label">Consumption (kWh)</label>
                                    <InputNumber id="deviceConsumption" aria-describedby="deviceConsumption-error" class="form-control" @bind-Value="CreateDeviceDto.ConsumptionInKwh" disabled/>
                                    <ValidationMessage For="() => CreateDeviceDto.ConsumptionInKwh" class="text-danger" id="deviceConsumption-error" />
                                </div>
                                <div class="mb-3">
                                    <label for="deviceDuration" class="form-label">Duration (minutes)</label>
                                    <InputNumber id="deviceDuration" aria-describedby="deviceDuration-error" class="form-control" @bind-Value="CreateDeviceDto.DurationInMinutes" disabled />
                                    <ValidationMessage For="() => CreateDeviceDto.DurationInMinutes" class="text-danger" id="deviceDuration-error" />
                                </div>
                            }
                        }
                        else
                        {
                        <div class="mb-3">
                            <p class="text-muted">Please select a category to enter additional device details.</p>
                        </div>
                        }
                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary">Save Device</button>
                        </div>
                         
                    </EditForm>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 p-4 bg-white h-100 catalogue-card">
             <h2 class="h5">Device catalogue</h2>
                <section class="border rounded catalogue-scroll" aria-label="Device catalogue">
                    <QuickGrid Class="table table-striped" Items="FilteredDevices"
                               RowClass="@(device => selectedCatalogueDevice == device ? "catalogue-row-selected" : string.Empty)">
                        <TemplateColumn Title="Model" Context="device" SortBy="@(GridSort<CatalogueDeviceDto>.ByAscending(d => d.Model))">
                            <button type="button" class="btn btn-link p-0 text-start stretched-link catalogue-row-button"
                                    aria-label="@($"{device.Model}, {device.Category}")"
                                    aria-pressed="@(selectedCatalogueDevice == device ? "true" : "false")"
                                    @onclick="() => SelectDevice(device)">
                                @device.Model
                            </button>
                        </TemplateColumn>
                        <TemplateColumn Title="Category" Context="device" SortBy="@(GridSort<CatalogueDeviceDto>.ByAscending(d => d.Category))">
                            @device.Category
                        </TemplateColumn>
                    </QuickGrid>
                </section>
            </div>
        </div>
    </div>

@code  
{
    private int amount = 0;

    private void GoToAppliance()
    {
        NavigationManager.NavigateTo("/device");
    }

    private List<string> categories = new List<string>()
    {
        "Interruptible",
        "Non-Interruptible"
    };

    private CreateDeviceDto CreateDeviceDto { get; set; } = new CreateDeviceDto();
    private EditForm? editForm;
    private const string CustomPresetOption = "__custom_preset__";
    private string selectedPresetOption = string.Empty;
    private bool IsCustomPreset => selectedPresetOption == CustomPresetOption;

    private void PresetSelectionChanged()
    {
        if (IsCustomPreset)
        {
            CreateDeviceDto.Preset = string.Empty;
            CreateDeviceDto.BatteryCapacityInKwh = null;
            CreateDeviceDto.ConsumptionInKwh = null;
            CreateDeviceDto.DurationInMinutes = null;
            return;
        }

        PresetDeviceDto? preset = CreateDeviceDto.Presets.FirstOrDefault(p => p.PresetName == selectedPresetOption);
        if (preset is null)
        {
            CreateDeviceDto.Preset = string.Empty;
            CreateDeviceDto.BatteryCapacityInKwh = null;
            CreateDeviceDto.ConsumptionInKwh = null;
            CreateDeviceDto.DurationInMinutes = null;
            return;
        }

        CreateDeviceDto.Preset = preset.PresetName;
        CreateDeviceDto.BatteryCapacityInKwh = preset.BatteryCapacityInKwh;
        CreateDeviceDto.ConsumptionInKwh = preset.ConsumptionInKwh;
        CreateDeviceDto.DurationInMinutes = preset.DurationInMinutes;
    }

    private bool IsInterruptible =>
        string.Equals(CreateDeviceDto.Category, "Interruptible", StringComparison.OrdinalIgnoreCase);

    public async Task CreateDevice()
    {
        if (IsCustomPreset && CreateDeviceDto.Presets.Any(preset =>
                string.Equals(preset.PresetName.Trim(), CreateDeviceDto.Preset.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            NotificationService.ErrorNotification($"Preset \"{CreateDeviceDto.Preset}\" already exists for device \"{CreateDeviceDto.Model}\".");
            return;
        }

        try 
        {
            if (IsInterruptible)
            {
                CreateDeviceDto.Preset = "Info";
                CreateDeviceDto.DurationInMinutes = null;
            }

            await DeviceService.CreateDeviceAsync(CreateDeviceDto);
            GoToAppliance();
            NotificationService.SuccessNotification($"Device: \"{CreateDeviceDto.Model}\" successfully added to your devices.");
        }
        catch (Exception ex)
        {
            NotificationService.ErrorNotification($"Error creating device: {ex.Message}");    
        }
    }
    
    private List<CatalogueDeviceDto> devices = [];
    private CatalogueDeviceDto? selectedCatalogueDevice;
   
    private IQueryable<CatalogueDeviceDto> FilteredDevices => 
    devices.AsQueryable().Where(d => d.Model.Contains(CreateDeviceDto.Model ?? "",StringComparison.OrdinalIgnoreCase) && 
    (string.IsNullOrEmpty(CreateDeviceDto.Category) || d.Category.Equals(CreateDeviceDto.Category, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        devices = (await DeviceService.GetAllDevicesAsync()).ToList();
        amount = (await DeviceService.GetUserDevicesAsync()).Count();
    }
    
    private void SelectDevice(CatalogueDeviceDto device)
    {
        if (selectedCatalogueDevice == device)
        {
            selectedCatalogueDevice = null;
            CreateDeviceDto = new CreateDeviceDto();
            selectedPresetOption = string.Empty;
            return;
        }

        selectedCatalogueDevice = device;
        CreateDeviceDto.Model = device.Model;
        CreateDeviceDto.Category = device.Category;
        CreateDeviceDto.Presets = device.Presets;

        bool isInterruptible = IsInterruptible;
        string? presetName = isInterruptible ? "Info" : device.Preset;
        PresetDeviceDto? preset = CreateDeviceDto.Presets.FirstOrDefault(p => p.PresetName == presetName)
            ?? (isInterruptible ? CreateDeviceDto.Presets.FirstOrDefault() : null);

        if (preset is not null)
        {
            selectedPresetOption = preset.PresetName;
            PresetSelectionChanged();
        }
        else
        {
            selectedPresetOption = string.Empty;
            CreateDeviceDto.Preset = isInterruptible ? "Info" : string.Empty;
            CreateDeviceDto.BatteryCapacityInKwh = null;
            CreateDeviceDto.ConsumptionInKwh = null;
            CreateDeviceDto.DurationInMinutes = null;
        }

        editForm?.EditContext?.NotifyFieldChanged(new FieldIdentifier(CreateDeviceDto, nameof(CreateDeviceDto.Category)));
    }

    private void CategoryChanged()
    {
        CreateDeviceDto.BatteryCapacityInKwh = null;

        if (IsInterruptible)
        {
            CreateDeviceDto.Preset = "Info";
            CreateDeviceDto.DurationInMinutes = null;
        }
        else
        {
            CreateDeviceDto.Preset = "standard";
            CreateDeviceDto.DurationInMinutes = null;
        }
    }
}

<style>
    .catalogue-scroll tbody tr {
        position: relative;
        cursor: pointer;
    }

    .catalogue-scroll tbody tr:hover > td {
        --bs-table-bg-state: #edf5fd;
    }

    .catalogue-scroll tbody tr.catalogue-row-selected > td {
        --bs-table-bg-state: #deedfc;
    }

    .catalogue-scroll .catalogue-row-button:focus {
        box-shadow: none;
    }

    .catalogue-scroll .catalogue-row-button:focus-visible::after {
        outline: 2px solid #0a66c3;
        outline-offset: -2px;
    }

    .add-appliance-layout .plan-picker-placeholder {
        color: var(--smarthome-muted);
    }

    .add-appliance-layout .plan-picker-option[data-value="__custom_preset__"] {
        border-top: 1px solid #b8d5f2;
        margin-top: 0.25rem;
        color: #0a66c3;
        font-weight: 600;
    }

    .form-control {
        background-color: #f8f9fa;
        border: 1px solid #ced4da;
    }

    .form-control:focus {
        background-color: #ffffff;
    }

    .header {
        align-items: center;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        width: 100%;
    }

    .heading h1 {
        color: #222;
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 0.6;
        margin: 0;
    }

    .heading p {
        color: var(--smarthome-muted);
        font-size: 0.70rem;
        line-height: 0.75;
        margin: 0;
    }

    .heading {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .header-actions {
        align-items: center;
        display: flex;
        flex-shrink: 0;
        gap: 0.5rem;
    }

    .catalogue-card {
        display: flex;
        flex-direction: column;
    }

    .catalogue-scroll {
        overflow-y: auto;
        max-height: 400px;
    }

    @@media (min-width: 992px) {
        .catalogue-scroll {
            flex: 1 1 0;
            height: 0;
            min-height: 0;
            max-height: none;
        }
    }

    .catalogue-scroll thead th {
        position: sticky;
        top: 0;
        background: #fff;
    }

    .catalogue-scroll td,
    .catalogue-scroll td * {
        color: inherit;
        text-decoration: none;
    }

    .catalogue-scroll { padding: 0; }

    .catalogue-scroll thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #fff;
    }

    .add-appliance-layout .catalogue-scroll th {
        background: #faf9f7;
        color: var(--smarthome-muted);
        font-size: 0.8rem;
    }

    .add-appliance-layout .catalogue-scroll .col-title {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        border: 0;
        background: none;
        padding: 0;
        color: inherit;
        font: inherit;
        font-weight: 600;
        text-align: left;
    }

    .add-appliance-layout .catalogue-scroll .col-title:hover {
        color: #0a66c3;
    }

    .add-appliance-layout .sort-indicator {
        width: 0.4rem;
        height: 0.4rem;
        border-right: 1.5px solid currentColor;
        border-bottom: 1.5px solid currentColor;
        transform: rotate(45deg);
        opacity: 0.4;
    }

    .add-appliance-layout .col-sort-asc .sort-indicator {
        opacity: 1;
        transform: rotate(225deg);
    }

    .add-appliance-layout .col-sort-desc .sort-indicator {
        opacity: 1;
    }

    @@media (min-width: 992px) {
        .add-appliance-layout {
            height: calc(100dvh - 6.6rem);
            min-height: 0;
        }

        .appliance-form-card {
            max-height: 100%;
            overflow-y: auto;
        }

        .catalogue-card {
            min-height: 0;
        }
        .info-tooltip {
            position: relative;
            display: inline-block;
            text-align: center;
        }

        .info-tooltip .info-tooltiptext {
            position: fixed;
            visibility: hidden;
            width: 450px;
            background-color: #464646;
            color: #fff;
            text-align: left;
            border-radius: 6px;
            padding: 5px;
            
            z-index: 1;
            
            opacity: 0;
            transition: opacity 0.3s;
        }

        .info-tooltip:hover a {
            color: #fff;
        }

        .info-tooltip:hover .info-tooltiptext {
            visibility: visible;
            opacity: 1;
        }
    }

    @@media (min-width: 961px) {
        .add-appliance-layout {
            flex: 1;
            height: 100%;
            min-height: 0;
            align-items: stretch;
            row-gap: 1.5rem;
        }

        .add-appliance-layout > div {
            flex: 0 0 50%;
            width: 50%;
            height: 100%;
            min-height: 0;
        }

        .add-appliance-layout .appliance-form-card,
        .add-appliance-layout .catalogue-card {
            max-height: 100%;
            min-height: 0;
