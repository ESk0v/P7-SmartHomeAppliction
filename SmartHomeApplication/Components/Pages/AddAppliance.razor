        }

        .add-appliance-layout .appliance-form-card .form-label {
            display: block;
            position: relative;
        }

        .add-appliance-layout .info-tooltip {
            display: inline-block;
            position: static;
        }

        .add-appliance-layout .info-tooltip:hover .info-tooltiptext,
        .add-appliance-layout .info-tooltip:focus-within .info-tooltiptext {
            display: block;
            visibility: visible;
            opacity: 1;
        }
    }

    @@media (max-width: 640.98px), (max-width: 960px) and (max-height: 500px) and (pointer: coarse) {
        .add-appliance-layout {
            row-gap: 1rem;
        }

        .add-appliance-layout > div {
