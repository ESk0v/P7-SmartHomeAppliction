@page "/add-device"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject SmartHomeApplication.Service.IDeviceService DeviceService
@inject INotificationService NotificationService
@using Utilities.Models
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Add Device</PageTitle>

<SectionContent SectionName="TopBarActions">
    <div class="header">
        <div class="heading">
            <h1>Device registry</h1>
            <p>@amount devices</p>
        </div>

        <div class="header-actions">
            <NavLink class="nav-link" href="device" Match="NavLinkMatch.All">
                <PrimaryButton ShowPlusIcon="false">
                Go back
                </PrimaryButton>
            </NavLink>
        </div>
    </div>
</SectionContent>

<div class="row add-appliance-layout">
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 p-4 bg-white appliance-form-card">
            <h2 class="h5 mb-4">Add a new device</h2>
                    <EditForm Method="post" Model="CreateDeviceDto" OnValidSubmit="CreateDevice" FormName="AddDeviceForm" data-enhance="false">
                        <AntiforgeryToken/>
                        <DataAnnotationsValidator />   
                        <div class="mb-3">
                            <label for="deviceModel" class="form-label">Device Model</label>
                            <InputText id="deviceModel"
                               class="form-control"
                               Value="@CreateDeviceDto.Model"
                               ValueChanged="@((string? v) => CreateDeviceDto.Model = v ?? "")"
                               ValueExpression="@(() => CreateDeviceDto.Model)"
                               @oninput="e => CreateDeviceDto.Model = e.Value?.ToString() ?? string.Empty" />
                            <ValidationMessage For="() => CreateDeviceDto.Model" class="text-danger" />
                        </div> 
                        <div class="mb-3">
                            <label for="deviceCategory" class="form-label">Device Category
                                <div class="info-tooltip">
                                    <span><i class="bi bi-info-circle-fill"/></span>
                                    <span class="info-tooltiptext">
                                        Interruptible devices can be paused. This is devices such as an EV-Charger or Robot vacuum.<br><br>
                                        Non-Interruptible devices cannot be paused. This is devices such as a washing machine or a dryer.
                                    </span>
                                </div>
                            </label>
                            
                            <InputSelect id="deviceCategory"
                                         class="form-control"
                                         Value="@CreateDeviceDto.Category"
                                         ValueChanged="@((string? category) => CategoryChanged(category))"
                                         ValueExpression="@(() => CreateDeviceDto.Category)">
                            <option value="">-- Select a Category --</option>
                            @foreach (string category in categories)
                            {
                                <option value="@category">@category</option>
                            }
                            </InputSelect>
                            <ValidationMessage For="() => CreateDeviceDto.Category" class="text-danger" /> 
                        </div>
                        @if (IsInterruptible)
                        {
                            <div class="mb-3">
                                <label for="deviceBatteryCapacity" class="form-label">Battery Capacity (kWh)</label>
                                <InputNumber id="deviceBatteryCapacity" class="form-control" @bind-Value="CreateDeviceDto.BatteryCapacityInKwh" />
                                <ValidationMessage For="() => CreateDeviceDto.BatteryCapacityInKwh" class="text-danger" />
                            </div>
                        }
                        else
                        {
                          <div class="mb-3">
                                <label for="devicePreset" class="form-label">Preset</label>
                                <InputSelect id="devicePreset" class="form-control" @bind-Value="selectedPresetOption" @bind-Value:after="PresetSelectionChanged">
                                    <option value="">-- Select a Preset --</option>
                                    @foreach (var preset in CreateDeviceDto.Presets)
                                    {
                                        <option value="@preset.PresetName">@preset.PresetName</option>
                                    }
                                    <option value="@CustomPresetOption">Create a new preset</option>
                                </InputSelect>
                                <ValidationMessage For="() => CreateDeviceDto.Preset" class="text-danger" /> 
                            </div>
                            @if (IsCustomPreset)
                            {
                                <div class="mb-3">
                                    <label for="customPresetName" class="form-label">Preset name</label>
                                    <InputText id="customPresetName" class="form-control" @bind-Value="CreateDeviceDto.Preset" />
                                    <ValidationMessage For="() => CreateDeviceDto.Preset" class="text-danger" />
                                </div>
                        }
                        <div class="mb-3">
                            <label for="deviceConsumption" class="form-label">Consumption (kWh)</label>
                            <InputNumber id="deviceConsumption" class="form-control" @bind-Value="CreateDeviceDto.ConsumptionInKwh" />
                            <ValidationMessage For="() => CreateDeviceDto.ConsumptionInKwh" class="text-danger" /> 
                        </div>
                        }
                        @if (!IsInterruptible)
                        {
                            <div class="mb-3">
                                <label for="deviceDuration" class="form-label">Duration (minutes)</label>
                                <InputNumber id="deviceDuration" class="form-control" @bind-Value="CreateDeviceDto.DurationInMinutes" />
                                <ValidationMessage For="() => CreateDeviceDto.DurationInMinutes" class="text-danger" />
                            </div>
                        }
                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary">Save Device</button>
                            </div>
                        } 
                    </EditForm>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 p-4 bg-white h-100 catalogue-card">
             <h2 class="h5">Device catalogue</h2>
                <section class="border rounded catalogue-scroll" aria-label="Device catalogue">
                    <QuickGrid Class="table table-striped" Items="FilteredDevices">
                        <TemplateColumn Title="Model" Context="device" SortBy="@(GridSort<CatalogueDeviceDto>.ByAscending(d => d.Model))">
                            <button type="button" class="btn btn-link p-0 text-start" @onclick="() => SelectDevice(device)">
                                @device.Model
                            </button>
                        </TemplateColumn>
                        <TemplateColumn Title="Category" Context="device" SortBy="@(GridSort<CatalogueDeviceDto>.ByAscending(d => d.Category))">
                            <button type="button" class="btn btn-link p-0 text-start" @onclick="() => SelectDevice(device)">
                                @device.Category
                            </button>
                        </TemplateColumn>
                    </QuickGrid>
                </section>
            </div>
        </div>
    </div>

@code  
{
    private List<string> categories = new List<string>()
    {
        "Interruptible",
        "Non-Interruptible"
    };

    private CreateDeviceDto CreateDeviceDto { get; set; } = new CreateDeviceDto();
    private const string CustomPresetOption = "__custom_preset__";
    private string selectedPresetOption = string.Empty;
    private bool IsCustomPreset => selectedPresetOption == CustomPresetOption;

    private void PresetSelectionChanged()
    {
        if (IsCustomPreset)
        {
            CreateDeviceDto.Preset = string.Empty;
            CreateDeviceDto.ConsumptionInKwh = null;
            CreateDeviceDto.DurationInMinutes = null;
            return;
        }

        var preset = CreateDeviceDto.Presets.FirstOrDefault(p => p.PresetName == selectedPresetOption);
        if (preset is null)
        {
            CreateDeviceDto.Preset = string.Empty;
            CreateDeviceDto.ConsumptionInKwh = null;
            CreateDeviceDto.DurationInMinutes = null;
            return;
        }

        CreateDeviceDto.Preset = preset.PresetName;
        CreateDeviceDto.ConsumptionInKwh = preset.ConsumptionInKwh;
        CreateDeviceDto.DurationInMinutes = preset.DurationInMinutes;
    }

    private bool IsInterruptible =>
        string.Equals(CreateDeviceDto.Category, "Interruptible", StringComparison.OrdinalIgnoreCase);

    public async Task CreateDevice()
    {
        try 
        {
            if (IsInterruptible)
            {
                CreateDeviceDto.Preset = "Info";
                CreateDeviceDto.DurationInMinutes = null;
            }

            await DeviceService.CreateDeviceAsync(CreateDeviceDto);
            GoToAppliance();
            NotificationService.SuccessNotification($"Device: \"{CreateDeviceDto.Model}\" successfully added to your devices.");
        }
        catch (Exception ex)
        {
            NotificationService.ErrorNotification($"Error creating device: {ex.Message}");    
        }
    }
    
    private List<CatalogueDeviceDto> devices = [];
   
    private IQueryable<CatalogueDeviceDto> FilteredDevices => 
    devices.AsQueryable().Where(d => d.Model.Contains(CreateDeviceDto.Model ?? "",StringComparison.OrdinalIgnoreCase) && 
    (string.IsNullOrEmpty(CreateDeviceDto.Category) || d.Category.Equals(CreateDeviceDto.Category, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        devices = (await DeviceService.GetAllDevicesAsync()).ToList();
        amount = (await DeviceService.GetUserDevicesAsync()).Count();
    }
    
    private void SelectDevice(CatalogueDeviceDto device)
    {
        CreateDeviceDto.Model = device.Model;
        CreateDeviceDto.Category = device.Category;
        CreateDeviceDto.BatteryCapacityInKwh = device.BatteryCapacityInKwh;
        CreateDeviceDto.Preset = device.Preset;
        selectedPresetOption = device.Preset;
        CreateDeviceDto.ConsumptionInKwh = device.ConsumptionInKwh;
        CreateDeviceDto.DurationInMinutes = device.DurationInMinutes;
        CreateDeviceDto.Presets = device.Presets;

        var preset = CreateDeviceDto.Presets.FirstOrDefault(p => p.PresetName == device.Preset);
        if (preset is not null)
        {
            CreateDeviceDto.ConsumptionInKwh = preset.ConsumptionInKwh;
            CreateDeviceDto.DurationInMinutes = preset.DurationInMinutes;
        CreateDeviceDto.BatteryCapacityInKwh = device.BatteryCapacityInKwh;
        CreateDeviceDto.Preset = IsInterruptible ? "Info" : device.Preset;
        CreateDeviceDto.ConsumptionInKwh = device.ConsumptionInKwh;
        CreateDeviceDto.DurationInMinutes = IsInterruptible ? null : device.DurationInMinutes;
        }
    }

    private void CategoryChanged(string? category)
    {
        CreateDeviceDto.Category = category ?? string.Empty;
        CreateDeviceDto.BatteryCapacityInKwh = null;

        if (IsInterruptible)
        {
            CreateDeviceDto.Preset = "Info";
            CreateDeviceDto.DurationInMinutes = null;
        }
        else
        {
            CreateDeviceDto.Preset = "standard";
            CreateDeviceDto.DurationInMinutes = null;
        }
    }
}

<style>
    .form-control {
        background-color: #f8f9fa;
        border: 1px solid #ced4da;
    }

    .form-control:focus {
        background-color: #ffffff;
    }

    .header {
        align-items: center;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        width: 100%;
    }

    .heading h1 {
        color: #222;
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 0.6;
        margin: 0;
    }

    .heading p {
        color: #999;
        font-size: 0.70rem;
        line-height: 0.75;
        margin: 0;
    }

    .heading {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .header-actions {
        align-items: center;
        display: flex;
        flex-shrink: 0;
        gap: 0.5rem;
    }

    @@media (max-width: 640.98px) {
        .header {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.5rem;
        }

        .header-actions {
            width: 100%;
        }
    }

   .catalogue-card {
    display: flex;
    flex-direction: column;
}

.catalogue-scroll {
    overflow-y: auto;
    max-height: 400px; 
}

@@media (min-width: 992px) {
    .catalogue-scroll {
        flex: 1 1 0;
        height: 0;       
        min-height: 0;
        max-height: none;
    }
}

    .catalogue-scroll thead th {
    position: sticky;
    top: 0;
    background: #fff;
}

.catalogue-scroll td,
.catalogue-scroll td * {
    color: inherit;
    text-decoration: none;
}

.catalogue-scroll { padding: 0; }

.catalogue-scroll thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: #fff;
}

@@media (min-width: 992px) {
    .add-appliance-layout {
        height: calc(100dvh - 6.6rem);
        min-height: 0;
    }

    .appliance-form-card {
        max-height: 100%;
        overflow-y: auto;
    }

    .catalogue-card {
        min-height: 0;
    }
.info-tooltip {
    position: relative;
    display: inline-block;
    text-align: center;
}

.info-tooltip .info-tooltiptext {
    visibility: visible;
    width: 450px;
    background-color: #464646;
    color: #fff;
    text-align: center;
    border-radius: 6px;
    padding: 5px;
    position: absolute;
    z-index: 1;
    bottom: 125%;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    transition: opacity 0.3s;
}

.info-tooltip:hover a {
    color: #fff;
}

.info-tooltip:hover .info-tooltiptext {
    visibility: visible;
    opacity: 1;
}
    
</style>
