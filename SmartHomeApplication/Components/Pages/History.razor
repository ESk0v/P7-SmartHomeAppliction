@page "/history"
@attribute [Authorize]

@rendermode InteractiveServer
@using global::Shared.Dashboard
@using System.Globalization

@inject HttpClient Http
@inject AuthenticationStateProvider AuthProvider
@using System.Security.Claims
@using Utilities.Models

<PageTitle>History</PageTitle>

<SectionContent SectionName="TopBarActions">
    <div class="header">
        <div class="heading">
            <h1>History</h1>
            <p>@dateRange</p>
        </div>

        <div class="header-actions">
            <div class="@GetPeriodToggleClass()" role="group" aria-label="History period">
                <span class="period-toggle-indicator" aria-hidden="true"></span>
                <button type="button"
                        class="@GetPeriodButtonClass(HistoryPeriod.SevenDays)"
                        @onclick="() => SelectPeriod(HistoryPeriod.SevenDays)">
                    7d
                </button>
                <button type="button"
                        class="@GetPeriodButtonClass(HistoryPeriod.ThirtyDays)"
                        @onclick="() => SelectPeriod(HistoryPeriod.ThirtyDays)">
                    30d
                </button>
                <button type="button"
                        class="@GetPeriodButtonClass(HistoryPeriod.Year)"
                        @onclick="() => SelectPeriod(HistoryPeriod.Year)">
                    Year
                </button>
            </div>
        </div>
    </div>
</SectionContent>

<div>
    <div class="statistics">
        <Statistics Type="StatisticsType.PlannedCost" From="GetStartDate(selectedPeriod)" To="DateTime.Today" />
        <Statistics Type="StatisticsType.ScheduleSavingsCost" From="GetStartDate(selectedPeriod)" To="DateTime.Today" />
        <Statistics Type="StatisticsType.PlannedCo2" From="GetStartDate(selectedPeriod)" To="DateTime.Today" />
        <Statistics Type="StatisticsType.ScheduleSavingsCo2" From="GetStartDate(selectedPeriod)" To="DateTime.Today" />
    </div>

    <div class="history-chart-card">
        <div class="history-chart-header">
            <span class="history-chart-title">@ChartTitle</span>
            <div class="history-legend">
                <span class="history-legend-item">
                    <span class="history-legend-dot" style="background-color:#e0a526"></span>Cost (kr)
                </span>
                <span class="history-legend-item">
                    <span class="history-legend-dot" style="background-color:#2f9e6e"></span>CO2 (g)
                </span>
            </div>
        </div>

        <div class="history-chart-bars @(chartPoints.Count <= 13 ? "history-chart-bars-few" : "")">
            @foreach (var p in chartPoints)
            {
                <div class="history-chart-column" data-tooltip="@p.Tooltip">
                    <div class="history-chart-bar-area">
                        <div class="history-chart-bar history-bar-price" style="@BarHeight(p.Price, maxPrice)"></div>
                        <div class="history-chart-bar history-bar-co2" style="@BarHeight(p.Co2, maxCo2)"></div>
                    </div>
                    <span class="history-chart-label">@p.Label</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private HistoryPeriod selectedPeriod = HistoryPeriod.ThirtyDays;

    private string fromDate => GetStartDate(selectedPeriod)
        .ToString("d MMM yyyy", CultureInfo.InvariantCulture);

    private string toDate => DateTime.Today.AddDays(-1)
        .ToString("d MMM yyyy", CultureInfo.InvariantCulture);

    private string dateRange => $"{fromDate} - {toDate}";

    // ---- chart ----
    private record ChartPoint(string Label, string Tooltip, decimal Price, decimal Co2);

    private List<ChartPoint> chartPoints = new();
    private decimal maxPrice;
    private decimal maxCo2;

    private string ChartTitle => selectedPeriod == HistoryPeriod.Year
        ? "Cost and CO2 per month"
        : "Cost and CO2 per day";

    private int loadVersion;

    protected override async Task OnInitializedAsync() => await LoadChartAsync();

    private async Task SelectPeriod(HistoryPeriod period)
    {
        selectedPeriod = period;
        await LoadChartAsync();
    }

    private async Task LoadChartAsync()
    {
        var version = ++loadVersion;
        var from = GetStartDate(selectedPeriod);
        var to = DateTime.Today;

        List<ChartPoint> points;
        try
        {
            var days = await GetHistoryAsync(from, to);

            // a newer click finished first, so ignore this older response
            if (version != loadVersion) return;

            points = selectedPeriod == HistoryPeriod.Year
                ? ToMonthPoints(days)
                : ToDayPoints(days, from);
        }
        catch (Exception)
        {
            points = new List<ChartPoint>();
        }

        chartPoints = points;
        maxPrice = points.Count > 0 ? points.Max(p => p.Price) : 0;
        maxCo2 = points.Count > 0 ? points.Max(p => p.Co2) : 0;
    }

    private async Task<List<HistoryPointDto>> GetHistoryAsync(DateTime from, DateTime to)
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        string? userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);

        var query = string.Create(CultureInfo.InvariantCulture,
            $"?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}");

        var request = new HttpRequestMessage(HttpMethod.Get, "api/history-controller" + query);
        request.Headers.Add("UserId", userId);

        var response = await Http.SendAsync(request);
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<List<HistoryPointDto>>() ?? new();
    }

    private List<ChartPoint> ToDayPoints(List<HistoryPointDto> days, DateTime start)
    {
        return days.Select(d =>
        {
            string label;
            if (selectedPeriod == HistoryPeriod.SevenDays)
            {
                label = d.Date.ToString("ddd d", CultureInfo.InvariantCulture);
            }
            else
            {
                // 30d: month name on the first column and on the 1st of each month
                bool isMonthStart = d.Date == start.Date || d.Date.Day == 1;
                label = isMonthStart
                    ? d.Date.ToString("MMM d", CultureInfo.InvariantCulture)
                    : d.Date.Day.ToString();
            }

            var tooltip = $"{d.Date.ToString("d MMM", CultureInfo.InvariantCulture)}: {d.Cost:0.00} kr, {d.Co2:0} g";
            return new ChartPoint(label, tooltip, d.Cost, d.Co2);
        }).ToList();
    }

    private static List<ChartPoint> ToMonthPoints(List<HistoryPointDto> days)
    {
        return days
            .GroupBy(d => new DateTime(d.Date.Year, d.Date.Month, 1))
            .OrderBy(g => g.Key)
            .Select(g =>
            {
                var cost = g.Sum(d => d.Cost);
                var co2 = g.Sum(d => d.Co2);
                var label = g.Key.ToString("MMM", CultureInfo.InvariantCulture);
                var tooltip = $"{g.Key.ToString("MMMM yyyy", CultureInfo.InvariantCulture)}: {cost:0.00} kr, {co2:0} g";
                return new ChartPoint(label, tooltip, cost, co2);
            })
            .ToList();
    }

    private static string BarHeight(decimal value, decimal max)
    {
        var height = max > 0 ? (double)(value / max * 100) : 0;
        return string.Create(CultureInfo.InvariantCulture, $"height:{height:0.##}%");
    }

    // ---- period toggle ----
    private string GetPeriodButtonClass(HistoryPeriod period)
    {
        return selectedPeriod == period
            ? "period-option period-option-active"
            : "period-option";
    }

    private string GetPeriodToggleClass()
    {
        var periodClass = selectedPeriod switch
        {
            HistoryPeriod.SevenDays => "period-toggle-seven-days",
            HistoryPeriod.Year => "period-toggle-year",
            _ => "period-toggle-thirty-days"
        };

        return $"period-toggle {periodClass}";
    }

    private static DateTime GetStartDate(HistoryPeriod period)
    {
        return period switch
        {
            HistoryPeriod.SevenDays => DateTime.Today.AddDays(-7),
            HistoryPeriod.ThirtyDays => DateTime.Today.AddMonths(-1),
            HistoryPeriod.Year => DateTime.Today.AddYears(-1),
            _ => DateTime.Today.AddMonths(-1)
        };
    }

    private enum HistoryPeriod
    {
        SevenDays,
        ThirtyDays,
        Year
    }
}

<style>
    .statistics {
        flex: 0 0 15%;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 3vw;
    }
    
    .header {
        align-items: center;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        width: 100%;
    }

    .heading h1 {
        color: #222;
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 0.6;
        margin: 0;
    }

    .heading p {
        color: #999;
        font-size: 0.70rem;
        line-height: 0.75;
        margin: 0;
    }

    .heading {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .header-actions {
        align-items: center;
        display: flex;
        flex-shrink: 0;
        gap: 0.9rem;
    }

    .period-toggle {
        align-items: center;
        background-color: #f0eeec;
        border-radius: 0.75rem;
        display: flex;
        padding: 0.125rem;
        position: relative;
    }

    .period-toggle-indicator {
        background-color: #fff;
        border-radius: 0.65rem;
        bottom: 0.125rem;
        box-shadow: 0 0.1rem 0.25rem rgba(34, 34, 34, 0.12);
        left: 0.125rem;
        position: absolute;
        top: 0.125rem;
        transform: translateX(100%);
        transition: transform 180ms ease;
        width: calc((100% - 0.25rem) / 3);
    }

    .period-toggle-seven-days .period-toggle-indicator {
        transform: translateX(0);
    }

    .period-toggle-year .period-toggle-indicator {
        transform: translateX(200%);
    }

    .period-option {
        background: transparent;
        border: 0;
        border-radius: 0.65rem;
        color: #716d6a;
        cursor: pointer;
        font: inherit;
        font-size: 0.75rem;
        min-width: 3.25rem;
        padding: 0.55rem 0.75rem;
        position: relative;
        transition: color 150ms ease;
        width: 33.333%;
        z-index: 1;
    }

    .period-option:hover {
        color: #222;
    }

    .period-option:focus-visible {
        outline: 1.5px solid #a9a0ff;
        outline-offset: 1px;
    }

    .period-option-active {
        color: #222;
    }

    @@media (prefers-reduced-motion: reduce) {
        .period-toggle-indicator {
            transition: none;
        }
    }

    @@media (max-width: 640.98px) {
        .header {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.5rem;
        }

        .header-actions {
            width: 100%;
        }

        .period-toggle {
            width: 100%;
        }

        .period-option {
            flex: 1;
        }
    }

    .history-chart-card {
        background-color: #fff;
        border: 1px solid #e5e2dc;
        border-radius: 12px;
        padding: 16px 20px;
        box-sizing: border-box;
        width: 100%;
        height: 240px;
        margin-top: 2vw;
        display: flex;
        flex-direction: column;
    }

    .history-chart-bars {
        flex: 1 1 0;
        min-height: 0;
        width: 100%;
        display: flex;
        align-items: stretch;
        justify-content: space-between;
        gap: 6px;
        border-bottom: 1px solid #e5e2dc;
        /* faint guide lines at 25 / 50 / 75 / 100 % */
        background-image: repeating-linear-gradient(
            to top,
            transparent 0,
            transparent calc(25% - 1px),
            #f0eeec calc(25% - 1px),
            #f0eeec 25%);
    }

    .history-chart-bars-few {
        gap: 14px;
    }

    .history-chart-bar-area {
        flex: 1 1 0;
        min-height: 0;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 3px;
    }

    .history-chart-bar {
        flex: 1;
        max-width: 10px;
        min-height: 2px;
        border-radius: 4px 4px 0 0;
        transition: opacity 120ms ease;
    }

    .history-chart-bars-few .history-chart-bar {
        max-width: 26px;
    }

    .history-bar-price { background-color: #e0a526; }
    .history-bar-co2   { background-color: #2f9e6e; }

    .history-chart-label {
        flex: 0 0 auto;
        text-align: center;
        margin-top: 6px;
        font-size: 11px;
        color: #999;
        white-space: nowrap;
    }

    .history-chart-header {
    flex: 0 0 auto;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
    }

    .history-chart-title {
        color: #999;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .history-legend {
        display: flex;
        align-items: center;
        gap: 1.5vw;
    }

    .history-legend-item {
        display: inline-flex;
        align-items: center;
        gap: 0.3vw;
        font-size: 12px;
        white-space: nowrap;
    }

    .history-legend-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .history-chart-column {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: stretch;
    }

    .history-chart-bar {
    flex: 1;
    max-width: 10px;
    min-height: 2px;
    border-radius: 4px 4px 0 0;
    }

    .history-chart-column {
        position: relative;
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: stretch;
    }

    .history-chart-column::after {
        content: attr(data-tooltip);
        position: absolute;
        top: 4px;
        left: 50%;
        transform: translateX(-50%);
        background-color: #3b322c;
        color: #f5efe6;
        font-size: 11px;
        padding: 5px 8px;
        border-radius: 6px;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        z-index: 10;
    }

    .history-chart-column:hover::after {
        opacity: 1;
    }

    .history-chart-column:nth-child(-n+4)::after {
        left: 0;
        transform: none;
    }

    .history-chart-column:nth-last-child(-n+4)::after {
        left: auto;
        right: 0;
        transform: none;
    }
</style>
