@page "/"
@rendermode InteractiveServer

@using global::Shared.Dashboard
@using System.Globalization
@using Utilities.Models

@inject HttpClient Http

<PageTitle>Dashboard</PageTitle>

<SectionContent SectionName="TopBarActions">
    <div class="header">
        <div class="heading">
            <h1>Home energy plan</h1>
            <p>@date <span aria-hidden="true">•</span> @area</p>
        </div>

        <div class="header-actions">
            <SecondaryButton>
                Re-optimize
            </SecondaryButton>
            <PrimaryButton>
                New demand
            </PrimaryButton>
        </div>
    </div>
</SectionContent>

<div class="dashboard">
    <div class="statistics">
        <Statistics Type="StatisticsType.PlannedCost"/>
        <Statistics Type="StatisticsType.ScheduleSavings"/>
        <Statistics Type="StatisticsType.PeakShift"/>
        <Statistics Type="StatisticsType.CheapestPeriod"/>
    </div>

    <div class="priceoverview">
        @if (activeSchedules is not null)
        {
            <PriceChart activeSchedules="activeSchedules"/>
        }
    </div>

    <div class="devices">
        @if (activeSchedules is null)
        {
            <p>Loading...</p>
        }
        else {
            @foreach (PlanDto activeSchedule in activeSchedules)
            {
                <Schedules activeSchedule="activeSchedule" />
            }
        }
    </div>    
</div>

@code {
    private string date = DateTime.Today.ToString("ddd dd MMM yyyy", CultureInfo.InvariantCulture);
    private string area = "Nordpool DK1";

    private List<PlanDto>? activeSchedules;

    protected override async Task OnInitializedAsync()
    {
        activeSchedules = await Http.GetFromJsonAsync<List<PlanDto>>("api/plan-controller/get-plan");
    }
}

<style>
    .dashboard {
        height: calc(100vh - 120px);
        padding: 0 3vw;
        box-sizing: border-box;

        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .statistics {
        flex: 0 0 15%;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 3vw;
    }

    .priceoverview {
        flex: 0 0 60%;
        min-height: 0;
    }

    .devices {
        display: flex;
        gap: 3vw;
        overflow-x: auto;
        overflow-y: hidden;
        padding-bottom: 8px;
    }

    .devices {
        flex: 0 0 20%;
        display: flex;
        gap: 3vw;
        overflow-x: auto;
        overflow-y: hidden;
        padding-bottom: 8px;
        min-height: 0;
        scrollbar-width: thin;   
        scrollbar-color: #cfcbc3 transparent;
        --scrollbar-w: 6px;
        --scrollbar-gap: 6px;
        
    }

    .devices > * {
        flex: 0 0 calc((100% - 6vw) / 3);
    }

    .header {
        align-items: center;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        width: 100%;
    }

    .heading h1 {
        color: #222;
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 0.6;
        margin: 0;
    }

    .heading p {
        color: #999;
        font-size: 0.70rem;
        line-height: 0.75;
        margin: 0;
    }

    .heading {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .header-actions {
        align-items: center;
        display: flex;
        flex-shrink: 0;
        gap: 0.9rem;
    }

    @@media (max-width: 640.98px) {
        .header {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.5rem;
        }

        .header-actions {
            width: 100%;
        }

    }
</style>