@page "/"
@attribute [Authorize]
@rendermode InteractiveServer

@using global::Shared.Dashboard
@using System.Globalization
@using Utilities.Models
@using System.Security.Claims
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject AuthenticationStateProvider AuthProvider
@inject ILogger<Dashboard> Logger

<PageTitle>Dashboard</PageTitle>

<SectionContent SectionName="TopBarActions">
    <div class="header">
        <div class="heading">
            <h1>Home energy plan</h1>
            <p>@date <span aria-hidden="true">•</span> @area</p>
        </div>

        <div class="header-actions dashboard-header-actions">
            <SecondaryButton>
                Re-optimize
            </SecondaryButton>
            <PrimaryButton OnClick="GoToMakePlan">
                New plan
            </PrimaryButton>
        </div>
    </div>
</SectionContent>

<div class="dashboard">
    <div class="statistics">
        <Statistics Type="StatisticsType.PlannedCost" From="DateTime.Today" To="DateTime.Today.AddDays(1)" />
        <Statistics Type="StatisticsType.ScheduleSavingsCost" From="DateTime.Today" To="DateTime.Today.AddDays(1)" />
        <Statistics Type="StatisticsType.PlannedCo2" From="DateTime.Today" To="DateTime.Today.AddDays(1)" />
        <Statistics Type="StatisticsType.ScheduleSavingsCo2" From="DateTime.Today" To="DateTime.Today.AddDays(1)" />
    </div>

    <div class="priceoverview">
        @if (activeSchedules is not null)
        {
            <PriceChart activeSchedules="activeSchedules"/>
        }
    </div>

    <div class="devices">
        @if (displaySchedules is null)
        {
            <p>Loading...</p>
        }
        else {
            @foreach (PlanDto schedule in displaySchedules)
            {
                <Schedules activeSchedule="schedule" />
            }
        }
    </div>    
</div>

@code {
    private string date = DateTime.Today.ToString("ddd dd MMM yyyy", CultureInfo.InvariantCulture);
    private string area = "Nordpool DK1";

    private List<PlanDto>? activeSchedules;
    private List<PlanDto>? displaySchedules;  
    
    private void GoToMakePlan() => NavigationManager.NavigateTo("/new-plan");


    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        
        var request = new HttpRequestMessage(HttpMethod.Get, "api/plan-controller/get-plan");
        request.Headers.Add("UserId", userId);

        var response = await Http.SendAsync(request);
        response.EnsureSuccessStatusCode();
        activeSchedules = await response.Content.ReadFromJsonAsync<List<PlanDto>>();
        displaySchedules = BuildDisplaySchedules(activeSchedules ?? new List<PlanDto>());
    }
    private List<PlanDto> BuildDisplaySchedules(List<PlanDto> allSchedules)
    {
        if (allSchedules.Count == 0)
            return new List<PlanDto>();

        var plansById = allSchedules.ToDictionary(x => x.planId);

        HashSet<int> continuationIds = allSchedules
            .Where(x => x.nextPlanId.HasValue)
            .Select(x => x.nextPlanId!.Value)
            .ToHashSet();

        var normalPlans = allSchedules
            .Where(x => !continuationIds.Contains(x.planId))
            .ToList();

        var result = new List<PlanDto>();

        foreach (var plan in normalPlans)
        {
            PlanDto current = plan;
            PlanDto lastPlan = plan;

            HashSet<int> visited = new();

            visited.Add(current.planId);
            decimal estimatedUnscheduledPrice = plan.estimatedUnscheduledPrice;
            decimal estimatedUnscheduledCo2Emissions = plan.estimatedUnscheduledCo2Emissions;

            while (current.nextPlanId is { } nextId
                && plansById.TryGetValue(nextId, out PlanDto? next)
                && visited.Add(nextId))
            {
                current = next;
                lastPlan = current;
                estimatedUnscheduledPrice += current.estimatedUnscheduledPrice;
                estimatedUnscheduledCo2Emissions += current.estimatedUnscheduledCo2Emissions;
            }

            var combinedPlan = new PlanDto
            (
                planId: plan.planId,
                nextPlanId: plan.nextPlanId,
                planName: plan.planName,
                icon: plan.icon,
                colorCode: plan.colorCode,
                deviceName: plan.deviceName,
                deviceCategory: plan.deviceCategory,
                optimizationObjective: plan.optimizationObjective,
                chargeStopPercentage: plan.chargeStopPercentage,
                presetDurationInMinutes: plan.presetDurationInMinutes,
                startTime: plan.startTime,
                endTime: lastPlan.endTime,
                windowStartTime: plan.windowStartTime,
                windowEndTime: lastPlan.windowEndTime,
                estimatedCost: plan.estimatedCost,
                estimatedCo2Emissions: plan.estimatedCo2Emissions,
                estimatedUnscheduledPrice: estimatedUnscheduledPrice,
                estimatedUnscheduledCo2Emissions: estimatedUnscheduledCo2Emissions,
                batteryCapacityInKwh: plan.batteryCapacityInKwh
            );
            
            result.Add(combinedPlan);
        }

        return result;
    }

}

<style>
    .dashboard {
        height: calc(100vh - 120px);
        min-width: 0;
        padding: 0 3vw;
        box-sizing: border-box;

        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .statistics {
        flex: 0 0 15%;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 3vw;
    }

    .priceoverview {
        flex: 0 0 60%;
        min-height: 0;
        min-width: 0;
        width: 100%;
    }

    .devices {
        flex: 0 0 20%;
        display: flex;
        gap: 3vw;
        overflow-x: auto;
        overflow-y: hidden;
        padding-bottom: 8px;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: #cfcbc3 transparent;
        --scrollbar-w: 6px;
        --scrollbar-gap: 6px;

    }

    .devices > * {
        flex: 0 0 calc((100% - 6vw) / 3);
    }

    .header {
        align-items: center;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        width: 100%;
    }

    .heading h1 {
        color: #222;
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 0.6;
        margin: 0;
    }

    .heading p {
        color: #999;
        font-size: 0.70rem;
        line-height: 0.75;
        margin: 0;
    }

    .heading {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .header-actions {
        align-items: center;
        display: flex;
        flex-shrink: 0;
        gap: 0.9rem;
    }

    .dashboard-header-actions .header-button-primary {
        min-width: 6rem;
    }

    @@media (max-width: 640.98px), (max-width: 960px) and (max-height: 500px) and (pointer: coarse) {
        .dashboard {
            height: auto;
            padding: 0;
            gap: 1rem;
        }

        .dashboard .statistics {
            flex: none;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.75rem;
        }

        .dashboard .priceoverview {
            flex: none;
            height: auto;
            min-height: 0;
            max-height: none;
        }

        .dashboard .devices {
            flex: none;
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 0.75rem;
            overflow: visible;
            padding: 0;
        }

    }
</style>
