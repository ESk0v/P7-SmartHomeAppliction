@page "/"
@rendermode InteractiveServer

@using Shared.Dashboard

<PageTitle>Dashboard</PageTitle>

<SectionContent SectionName="TopBarActions">
    <span>Dashboard</span>
</SectionContent>

<div class="dashboard">
    <div class="statistics">
        <Statistics />
        <Statistics />
        <Statistics />
        <Statistics />
    </div>

    <div class="priceoverview">
        <PriceChart />
    </div>

    <div class="devices">
        <Devices />
        <Devices />
        <Devices />
    </div>    
</div>

@code {

}

<style>
.dashboard {
    height: calc(100vh - 120px); /* adjust 120px to your header/topbar height */
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
}

.statistics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3vw;
}

.devices {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3vw;
}
</style>