@page "/"
@rendermode InteractiveServer

@using Shared.Dashboard

<PageTitle>Dashboard</PageTitle>

<SectionContent SectionName="TopBarActions">
    <span>Dashboard</span>
</SectionContent>

<div class="dashboard">
    <div class="statistics">
        <Statistics Type="StatisticsType.PlannedCost"/>
        <Statistics Type="StatisticsType.ScheduleSavings"/>
        <Statistics Type="StatisticsType.PeakShift"/>
        <Statistics Type="StatisticsType.CheapestPeriod"/>
    </div>

    <div class="priceoverview">
        <PriceChart />
    </div>

    <div class="devices">
        <Devices />
        <Devices />
        <Devices />
    </div>    
</div>

@code {

}

<style>
.dashboard {
    height: calc(100vh - 120px); /* adjust 120px to your header/topbar height */
    padding: 0 3vw;
    box-sizing: border-box;
    
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
}

.statistics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3vw;
}

.devices {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3vw;
}
</style>