@page "/"
@rendermode InteractiveServer
@inject HttpClient Http
@inject ILogger<Dashboard> Logger
@using System.Globalization
@using Utilities.Models

<PageTitle>Dashboard</PageTitle>

<div class="chart-card">
    <h3>Electricity price per hour</h3>

    @if (loading)
    {
        <p>Loading...</p>
    }
    else if (prices.Count == 0)
    {
        <p>No prices available.</p>
    }
    else
    {
        <div class="chart">
            @foreach (var p in prices)
            {
                <div class="bar-col" title="@p.Hour.Hour:00 - @p.Price.ToString("0.00", CultureInfo.CurrentCulture) kr/kWh">
                    <div class="bar-area">
                        <div class="bar" style="height:@BarHeight(p.Price)%"></div>
                    </div>
                    <span class="bar-label">@p.Hour.Hour</span>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<HourPriceDto> prices = new();
    private decimal maxPrice;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            prices = await Http.GetFromJsonAsync<List<HourPriceDto>>(
                "api/electricity-price-controller/dashboard-showcase?areaCode=DK1") ?? new();
            maxPrice = prices.Count > 0 ? prices.Max(p => p.Price) : 0;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load electricity prices");
        }
        finally
        {
            loading = false;
        }
    }

    private string BarHeight(decimal price)
    {
        var pct = maxPrice > 0 ? price / maxPrice * 100 : 0;
        return pct.ToString("0.##", CultureInfo.InvariantCulture);
    }
}