        color: #222;
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 0.6;
        margin: 0;
    }

    .heading p {
        color: #999;
        font-size: 0.70rem;
        line-height: 0.75;
        margin: 0;
    }

    .heading {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        margin-left: -1rem;
        margin-top: -0.5rem;
    }

    .plan-title {
        align-items: center;
        display: flex;
        gap: 0.75rem;
    }

    .visually-hidden {
        height: 1px;
        margin: -1px;
        overflow: hidden;
        position: absolute;
        width: 1px;
    }

    .plan-picker {
        position: relative;
    }

    .plan-picker-trigger {
        align-items: center;
        appearance: none;
        background: #fff;
        border: 0;
        border-radius: 0.75rem;
        color: #222;
        cursor: pointer;
        display: flex;
        font: inherit;
        font-size: 1.1rem;
        font-weight: 600;
        gap: 0.75rem;
        min-width: 20rem;
        padding: 0.1rem 0.85rem;
        text-align: left;
        transition: background-color 150ms ease, box-shadow 150ms ease;
    }

    .plan-picker-trigger:hover,
    .plan-picker-trigger:focus-visible {
        background: #f8f7ff;
        outline: none;
    }

    .plan-picker-icon {
        color: #7569e8;
        display: inline-flex;
        flex-shrink: 0;
        height: 1.4rem;
        width: 1.4rem;
    }

    .plan-picker-icon svg {
        height: 100%;
        width: 100%;
    }

    .plan-picker-chevron {
        border-bottom: 2px solid #999;
        border-right: 2px solid #999;
        height: 0.6rem;
        margin-left: auto;
        transform: rotate(45deg) translateY(-0.15rem);
        transition: border-color 150ms ease, transform 150ms ease;
        width: 0.6rem;
    }

    .plan-picker-chevron-open {
        border-color: #7569e8;
        transform: rotate(225deg) translateY(-0.05rem);
    }

