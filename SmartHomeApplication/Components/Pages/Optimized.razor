        background: #373432;
        border-color: #373432;
    }

    .header-actions {
        align-items: center;
        display: flex;
        flex-shrink: 0;
        gap: 0.7rem;
    }

    @@media (max-width: 640.98px) {
        .body {
            height: auto;
            min-height: calc(100vh - 4.5rem);
            overflow: visible;
        }

        .header {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.5rem;
        }

        .header-actions {
            width: 100%;
        }

        .plan-title {
            flex-wrap: wrap;
            gap: 0.4rem;
        }

