@page "/optimized"
@rendermode InteractiveServer
@inject OptimizedPlanState PlanState
@attribute [Authorize]

@using global::Shared.Dashboard
@using System.Globalization
@using System.Security.Claims
@using Utilities.Models

@inject HttpClient Http
@inject AuthenticationStateProvider AuthProvider
@inject ILogger<Optimized> Logger

<PageTitle>Optimized plans</PageTitle>

<SectionContent SectionName="TopBarActions">
    <div class="header">
        <div class="heading">
            <div class="plan-title">
                <label id="plan-select-label" class="visually-hidden">Optimized plan</label>
                <div class="plan-picker">
                    <button type="button"
                        class="plan-picker-trigger"
                        @onclick="TogglePlanPicker">
                    <span class="plan-picker-icon">@selectedPlan.Icon</span>
                    <span>@selectedPlan.Name</span>
                    <span class="plan-picker-chevron @(isPlanPickerOpen ? "plan-picker-chevron-open" : "")"></span>
                    </button>

                    @if (isPlanPickerOpen)
                    {
                    <div class="plan-picker-menu">
                        @foreach (Plan plan in plans)
                        {
                            <button type="button"
                                    class="plan-picker-option @(plan.Id == selectedPlanId ? "plan-picker-option-selected" : "")"
                                    @onclick="() => SelectPlan(plan.Id)">
                                <span class="plan-picker-icon">@plan.Icon</span>
                                <span>@plan.Name</span>
                                @if (plan.Id == selectedPlanId)
                                {
                                    <span class="plan-picker-check">✓</span>
                                }
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
            <p style="padding: 0 0.85rem">@selectedPlan.Device • @selectedPlan.Target% target • Window: @selectedPlan.Window</p>
        </div>

        <div class="header-actions">
            <button type="button" class="optimized-action optimized-action-secondary">
                Adjust
            </button>
            <button type="button" class="optimized-action optimized-action-primary">
                Confirm
            </button>
        </div>
    </div>

</SectionContent>

<div class="body">
    <div class="statistics">
        <Statistics Type="StatisticsType.EstimatedCost"
                    OverrideData="EstimatedCost"
                    DescriptionClass="@(selectedSchedules.Count == 0 ? string.Empty : "positive")"/>
        <Statistics Type="StatisticsType.MoneySaved" OverrideData="MoneySaved"/>
        <Statistics Type="StatisticsType.LoadDuration" OverrideData="LoadDuration"/>
        <Statistics Type="StatisticsType.LoadFinish" OverrideData="LoadFinish"/>
    </div>

    <div class="optimized-timeline">
        @if (isLoading)
        {
            <p>Loading optimized plan...</p>
        }
        else if (loadError is not null)
        {
            <p class="optimized-error">@loadError</p>
        }
        else if (selectedSchedules.Count == 0)
        {
            <p class="optimized-empty">No optimized loads were found for @selectedPlan.Device.</p>
        }
        else
        {
            <PriceChart activeSchedules="selectedSchedules" />
        }
    </div>
</div>

@code {
    private List<Plan> plans =
    [
        new("mixed-home", "Whole-home savings plan", "Home appliances", 75, "21:00–06:00", Icons.Cpu),
        new("evening-ev", "EV evening plan", "EV Charger", 80, "22:00–07:00", Icons.Car),
        new("laundry-night", "Laundry night plan", "Washing machine", 65, "23:00–06:00", Icons.WashingMachine)
    ];

    private bool isPlanPickerOpen;
    private bool isLoading = true;
    private string? loadError;
    private List<PlanDto> allSchedules = new List<PlanDto>();

    private string selectedPlanId
    {
        get => PlanState.SelectedPlanId;
        set => PlanState.SelectedPlanId = value;
    }

    private Plan selectedPlan => plans.FirstOrDefault(plan => plan.Id == selectedPlanId) ?? plans[0];
    private List<PlanDto> selectedSchedules => allSchedules
        .Where(schedule => string.Equals(schedule.planName, selectedPlan.Name, StringComparison.OrdinalIgnoreCase))
        .OrderBy(schedule => schedule.startTime)
        .ToList();

    private StatisticsDto EstimatedCost => new StatisticsDto()
    {
        Value = selectedSchedules.Count == 0
            ? "--"
            : selectedSchedules.Sum(schedule => schedule.estimatedCost).ToString("C", CultureInfo.CurrentCulture),
        Description = selectedSchedules.Count == 0
            ? "No data available"
            : $"↓ {BaselineDifferencePercent:0}% vs. baseline"
    };

    private StatisticsDto MoneySaved
    {
        get
        {
            decimal estimatedCost = selectedSchedules.Sum(schedule => schedule.estimatedCost);
            decimal baselineCost = estimatedCost * 1.15m;   // Temporary baseline

            return new StatisticsDto()
            {
                Value = selectedSchedules.Count == 0
                    ? "--"
                    : (baselineCost - estimatedCost).ToString("C", CultureInfo.CurrentCulture),
                Description = selectedSchedules.Count == 0
                    ? "No data available"
                    : "vs. starting ASAP"
            };
        }
    }

    private StatisticsDto LoadDuration => new StatisticsDto()
    {
        Value = selectedSchedules.Count == 0
            ? "--"
            : FormatDuration(selectedSchedules
                .Select(schedule => schedule.endTime - schedule.startTime)
                .Aggregate(TimeSpan.Zero, (total, duration) => total + duration)),
        Description = selectedSchedules.Count == 0
            ? "No data available"
            : $"Starts at {selectedSchedules.Min(schedule => schedule.startTime):HH:mm}"
    };

    private StatisticsDto LoadFinish => new StatisticsDto()
    {
        Value = selectedSchedules.Count == 0
            ? "--"
            : selectedSchedules.Max(schedule => schedule.endTime).ToString("HH:mm", CultureInfo.InvariantCulture),
        Description = selectedSchedules.Count == 0
            ? "No data available"
            : FormatDeadlineDescription()
    };

    private decimal BaselineDifferencePercent
    {
        get
        {
            decimal estimatedCost = selectedSchedules.Sum(schedule => schedule.estimatedCost);
            decimal baselineCost = estimatedCost * 1.15m;   // Temporary baseline

            return baselineCost == 0
                ? 0
                : (baselineCost - estimatedCost) / baselineCost * 100;
        }
    }

    private string FormatDeadlineDescription()
    {
        DateTime finish = selectedSchedules.Max(schedule => schedule.endTime);
        DateTime deadline = finish;
        TimeSpan remaining = deadline - finish;

        if (remaining <= TimeSpan.Zero)
        {
            return remaining == TimeSpan.Zero
                ? "Finishes right on deadline"
                : "Finishes after deadline";    // Probably won't happen, but just in case
        }

        return $"Finishes {FormatDuration(remaining)} before deadline";
    }

    private void TogglePlanPicker()
    {
        isPlanPickerOpen = !isPlanPickerOpen;
    }

    private void SelectPlan(string planId)
    {
        selectedPlanId = planId;
        isPlanPickerOpen = false;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState? state = await AuthProvider.GetAuthenticationStateAsync();
            string? userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (string.IsNullOrWhiteSpace(userId))
            {
                loadError = "The current user could not be identified.";
                return;
            }

            using HttpRequestMessage? request = new HttpRequestMessage(HttpMethod.Get, "api/plan-controller/get-plan");
            request.Headers.Add("UserId", userId);

            using HttpResponseMessage? response = await Http.SendAsync(request);
            response.EnsureSuccessStatusCode();
            allSchedules = await response.Content.ReadFromJsonAsync<List<PlanDto>>() ?? new();
            BuildPlansFromSchedules();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load optimized plan data");
            loadError = "The optimized plan could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatDuration(TimeSpan duration)
    {
        return duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours}h {duration.Minutes}m"
            : $"{duration.Minutes}m";
    }

    private void BuildPlansFromSchedules()
    {
        if (allSchedules.Count == 0)
        {
            return;
        }

        plans = allSchedules
            .GroupBy(schedule => schedule.planName, StringComparer.OrdinalIgnoreCase)
            .Select(group =>
            {
                List<PlanDto>? schedules = group.OrderBy(schedule => schedule.startTime).ToList();
                PlanDto? firstSchedule = schedules[0];
                PlanDto? lastSchedule = schedules[^1];

                return new Plan(
                    CreatePlanId(group.Key),
                    group.Key,
                    schedules[0].deviceName,
                    100,
                    $"{firstSchedule.startTime:HH:mm}–{lastSchedule.endTime:HH:mm}",
                    IconFor(group.Key));
            })
            .ToList();

        if (!plans.Any(plan => plan.Id == selectedPlanId))
        {
            selectedPlanId = plans[0].Id;
        }
    }

    private static string CreatePlanId(string deviceName) =>
        string.Join("-", deviceName.Split(
            [' ', '-', '_'],
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .ToLowerInvariant();

    private static RenderFragment IconFor(string deviceName)
    {
        if (deviceName.Contains("car", StringComparison.OrdinalIgnoreCase)
            || deviceName.Contains("ev", StringComparison.OrdinalIgnoreCase))
        {
            return Icons.Car;
        }

        if (deviceName.Contains("wash", StringComparison.OrdinalIgnoreCase))
        {
            return Icons.WashingMachine;
        }

        return Icons.Cpu;
    }

    private sealed record Plan(
        string Id,
        string Name,
        string Device,
        int Target,
        string Window,
        RenderFragment Icon);
}


<style>
    .body {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 2rem;
        height: calc(100vh - 4.5rem);
        min-height: 0;
        overflow: hidden;
        padding: 1.5rem 3vw;
    }

    .statistics {
        display: grid;
        flex: 0 0 auto;
        gap: 3vw;
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .optimized-timeline {
        flex: 1 1 auto;
        min-height: 0;
        min-width: 0;
    }

    .optimized-timeline ::deep .chart-card {
        height: 100%;
    }

    .optimized-empty,
    .optimized-error {
        background: #fff;
        border: 1px solid #e5e2dc;
        border-radius: 12px;
        color: #777;
        margin: 0;
        padding: 2rem;
        text-align: center;
    }

    .optimized-error {
        color: #9f2d2d;
    }

    .header {
        align-items: center;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        width: 100%;
    }

    .heading h1 {
        color: #222;
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 0.6;
        margin: 0;
    }

    .heading p {
        color: #999;
        font-size: 0.70rem;
        line-height: 0.75;
        margin: 0;
    }

    .heading {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        margin-left: -1rem;
        margin-top: -0.5rem;
    }

    .plan-title {
        align-items: center;
        display: flex;
        gap: 0.75rem;
    }

    .visually-hidden {
        height: 1px;
        margin: -1px;
        overflow: hidden;
        position: absolute;
        width: 1px;
    }

    .plan-picker {
        position: relative;
    }

    .plan-picker-trigger {
        align-items: center;
        appearance: none;
        background: #fff;
        border: 0;
        border-radius: 0.75rem;
        color: #222;
        cursor: pointer;
        display: flex;
        font: inherit;
        font-size: 1.1rem;
        font-weight: 600;
        gap: 0.75rem;
        min-width: 20rem;
        padding: 0.1rem 0.85rem;
        text-align: left;
        transition: background-color 150ms ease, box-shadow 150ms ease;
    }

    .plan-picker-trigger:hover,
    .plan-picker-trigger:focus-visible {
        background: #f8f7ff;
        outline: none;
    }

    .plan-picker-icon {
        color: #7569e8;
        display: inline-flex;
        flex-shrink: 0;
        height: 1.4rem;
        width: 1.4rem;
    }

    .plan-picker-icon svg {
        height: 100%;
        width: 100%;
    }

    .plan-picker-chevron {
        border-bottom: 2px solid #999;
        border-right: 2px solid #999;
        height: 0.6rem;
        margin-left: auto;
        transform: rotate(45deg) translateY(-0.15rem);
        transition: border-color 150ms ease, transform 150ms ease;
        width: 0.6rem;
    }

    .plan-picker-chevron-open {
        border-color: #7569e8;
        transform: rotate(225deg) translateY(-0.05rem);
    }

    .plan-picker-menu {
        background: #fff;
        border: 1px solid #e2ded9;
        border-radius: 0.75rem;
        box-shadow: 0 0.5rem 1.2rem rgba(34, 34, 34, 0.14);
        left: 0;
        overflow: hidden;
        padding: 0.25rem 0;
        position: absolute;
        right: 0;
        top: calc(100% + 0.4rem);
        z-index: 10;
    }

    .plan-picker-option {
        align-items: center;
        background: #fff;
        border: 0;
        color: #222;
        cursor: pointer;
        display: flex;
        font: inherit;
        font-size: 1rem;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        text-align: left;
