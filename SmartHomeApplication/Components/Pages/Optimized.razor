        color: #7569e8;
        font-size: 1.2rem;
        font-weight: 700;
        margin-left: auto;
    }

    .optimized-action {
        align-items: center;
        border-radius: 0.7rem;
        cursor: pointer;
        display: inline-flex;
        font: inherit;
        font-size: 0.85rem;
