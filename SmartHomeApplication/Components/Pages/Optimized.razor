    }

    .plan-picker-option {
        align-items: center;
        background: #fff;
        border: 0;
        color: #222;
        cursor: pointer;
        display: flex;
        font: inherit;
        font-size: 1rem;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        text-align: left;
        width: 100%;
