    .optimized-action:focus-visible {
        outline: 1.5px solid #a9a0ff;
        outline-offset: 1px;
    }

    .optimized-action-secondary {
        background: #fff;
        border: 1px solid #e2ded9;
        color: #222;
    }

    .optimized-action-secondary:hover {
        background: #e8e5e1;
        border-color: #d2ccc5;
    }

    .optimized-action-primary {
        background: #1b1a19;
        border: 1px solid #1b1a19;
        color: #fff;
    }

    .optimized-action-primary:hover {
        background: #373432;
        border-color: #373432;
    }

    .header-actions {
        align-items: center;
        display: flex;
        flex-shrink: 0;
        gap: 0.7rem;
    }

    @@media (max-width: 640.98px) {
        .body {
            height: auto;
            min-height: calc(100vh - 4.5rem);
            overflow: visible;
        }

        .header {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.5rem;
        }

        .header-actions {
            width: 100%;
        }

        .plan-title {
            flex-wrap: wrap;
            gap: 0.4rem;
        }

        .plan-picker,
        .plan-picker-trigger {
            width: 100%;
        }

        .header-actions {
            justify-content: stretch;
        }

        .optimized-action {
            flex: 1;
        }

        .statistics {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
        }

        .optimized-timeline {
            min-height: 16rem;
        }
    }
</style>