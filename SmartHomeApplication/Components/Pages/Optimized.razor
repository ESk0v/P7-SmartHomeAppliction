@page "/optimized"
@rendermode InteractiveServer
@inject OptimizedPlanState PlanState
@attribute [Authorize]

@using global::Shared.Dashboard
@using System.Globalization
@using System.Security.Claims
@using Utilities.Models

@inject HttpClient Http
@inject AuthenticationStateProvider AuthProvider
@inject ILogger<Optimized> Logger

<PageTitle>Optimized plans</PageTitle>

<SectionContent SectionName="TopBarActions">
    <div class="header">
        <div class="heading">
            <div class="plan-title">
                <label id="plan-select-label" class="visually-hidden">Optimized plan</label>
                <div class="plan-picker">
                    <button type="button"
                        class="plan-picker-trigger"
                        @onclick="TogglePlanPicker">
                    <span class="plan-picker-icon">@selectedPlan.Icon</span>
                    <span>@selectedPlan.Name</span>
                    <span class="plan-picker-chevron @(isPlanPickerOpen ? "plan-picker-chevron-open" : "")"></span>
                    </button>

                    @if (isPlanPickerOpen)
                    {
                    <div class="plan-picker-menu">
                        @if (plans.Count == 0) { <p class="optimized-empty">No optimized plans were found.</p> }
                        @foreach (Plan plan in plans)
                        {
                            <button type="button"
                                    class="plan-picker-option @(plan.Id == selectedPlanId ? "plan-picker-option-selected" : "")"
                                    @onclick="() => SelectPlan(plan.Id)">
                                <span class="plan-picker-icon">@plan.Icon</span>
                                <span>@plan.Name</span>
                                @if (plan.Id == selectedPlanId)
                                {
                                    <span class="plan-picker-check">✓</span>
                                }
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
            <p style="padding: 0 0.85rem">@(plans.Count == 0 ? string.Empty : $"{selectedPlan.Device} • Window: {selectedPlan.Window}")</p>
        </div>

        <div class="header-actions">
            <button type="button" class="optimized-action optimized-action-secondary">
                Adjust
            </button>
            <button type="button" class="optimized-action optimized-action-primary">
                Confirm
            </button>
        </div>
    </div>

</SectionContent>

<div class="body">
    <div class="statistics">
        <Statistics Type="StatisticsType.EstimatedCost"/>
        <Statistics Type="StatisticsType.MoneySaved"/>
        <Statistics Type="StatisticsType.LoadDuration"/>
        <Statistics Type="StatisticsType.LoadFinish"/>
    </div>

    @if (isLoading)
    {
        <p>Loading optimized plan...</p>
    }
    else if (loadError is not null)
    {
        <p class="optimized-error">@loadError</p>
    }
    else if (selectedSchedules.Count == 0)
    {
        <p class="optimized-empty">No optimized loads were found for @selectedPlan.Device.</p>
    }
    else
    {
        <div class="optimized-content">
            <div class="optimized-main-column">
                <div class="optimized-timeline">
                    <PriceChart activeSchedules="selectedSchedules" />
                </div>

                <section class="optimized-card schedule-blocks-card">
                    <div class="card-heading">
                        <div>
                            <h2>Schedule blocks</h2>
                            <p>Contiguous parts of the selected plan</p>
                        </div>
                        <span class="demo-label">Estimated</span>
                    </div>

                    <div class="schedule-blocks">
                        @foreach (PlanDto block in selectedSchedules)
                        {
                            <div class="schedule-block">
                                <span class="schedule-block-icon">@Icons.Plus</span>
                                <div class="schedule-block-details">
                                    <strong>@block.startTime.ToString("HH:mm")–@block.endTime.ToString("HH:mm")</strong>
                                    <span>@block.deviceName · @FormatDuration(block.endTime - block.startTime)</span>
                                </div>
                                <div class="schedule-block-value">
                                    <strong>@block.estimatedCost.ToString("C", CultureInfo.CurrentCulture)</strong>
                                    <span>Block @(selectedSchedules.IndexOf(block) + 1) of @selectedSchedules.Count</span>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            </div>

            <div class="optimized-side-column">
                <section class="optimized-card plan-summary-card">
                    <div class="card-heading">
                        <h2>Plan summary</h2>
                    </div>
                    <div class="summary-row">
                        <div>
                            <span>Finishes</span>
                            <small>@FinishDescription</small>
                        </div>
                        <strong class="summary-positive">@selectedSchedules.Max(schedule => schedule.endTime).ToString("HH:mm")</strong>
                    </div>
                    <div class="summary-row">
                        <div>
                            <span>Peak household load</span>
                            <small>Temporary demo estimate</small>
                        </div>
                        <strong>9.1 kW</strong>
                    </div>
                    <div class="summary-row">
                        <div>
                            <span>Optimization status</span>
                            <small>Based on the selected schedule</small>
                        </div>
                        <strong>Optimized</strong>
                    </div>
                </section>

                <section class="optimized-card load-impact-card">
                    <div class="card-heading">
                        <div>
                            <h2>Peak household load</h2>
                            <p>Temporary demo estimate</p>
                        </div>
                    </div>
                    <div class="load-metric">
                        <div>
                            <span>Selected load</span>
                            <strong>7.4 kW</strong>
                        </div>
                        <div class="load-bar"><span class="selected-load"></span></div>
                    </div>
                    <div class="load-metric">
                        <div>
                            <span>Base load</span>
                            <strong>1.7 kW</strong>
                        </div>
                        <div class="load-bar"><span class="base-load"></span></div>
                    </div>
                    <div class="load-total">
                        <span>Total peak</span>
                        <strong>9.1 kW <small>/ 11 kW limit</small></strong>
                    </div>
                </section>
            </div>
        </div>
        }
    </div>

@code {
    private List<Plan> plans = new List<Plan>();

    private bool isPlanPickerOpen;
    private bool isLoading = true;
    private string? loadError;
    private List<PlanDto> allSchedules = new List<PlanDto>();

    private string selectedPlanId
    {
        get => PlanState.SelectedPlanId;
        set => PlanState.SelectedPlanId = value;
    }

    private Plan selectedPlan => plans.FirstOrDefault(plan => plan.Id == selectedPlanId) ?? EmptyPlan;
    private List<PlanDto> selectedSchedules => selectedPlan.Schedules;

    private StatisticsDto EstimatedCost => new StatisticsDto()
    {
        Value = selectedSchedules.Count == 0
            ? "--"
            : selectedSchedules.Sum(schedule => schedule.estimatedCost).ToString("C", CultureInfo.CurrentCulture),
        Description = selectedSchedules.Count == 0
            ? "No data available"
            : BaselineDifferencePercent == 0
                ? "0% vs. unscheduled"
                : $"↓ {BaselineDifferencePercent:0}% vs. unscheduled"
    };

    private StatisticsDto MoneySaved
    {
        get
        {
            decimal estimatedCost = selectedSchedules.Sum(schedule => schedule.estimatedCost);
            decimal baselineCost = estimatedCost * 1.15m;   // Temporary baseline

            return new StatisticsDto()
            {
                Value = selectedSchedules.Count == 0
                    ? "--"
                    : (baselineCost - estimatedCost).ToString("C", CultureInfo.CurrentCulture),
                Description = selectedSchedules.Count == 0
                    ? "No data available"
                    : "vs. unscheduled"
            };
        }
    }

    private StatisticsDto LoadDuration => new StatisticsDto()
    {
        Value = selectedSchedules.Count == 0
            ? "--"
            : FormatDuration(selectedSchedules
                .Select(schedule => schedule.endTime - schedule.startTime)
                .Aggregate(TimeSpan.Zero, (total, duration) => total + duration)),
        Description = selectedSchedules.Count == 0
            ? "No data available"
            : $"Starts at {selectedSchedules.Min(schedule => schedule.startTime):HH:mm}"
    };

    private StatisticsDto LoadFinish => new StatisticsDto()
    {
        Value = selectedSchedules.Count == 0
            ? "--"
            : selectedSchedules.Max(schedule => schedule.endTime).ToString("HH:mm", CultureInfo.InvariantCulture),
        Description = selectedSchedules.Count == 0
            ? "No data available"
            : FormatDeadlineDescription()
    };

    private string FinishDescription =>
        selectedSchedules.Count == 0
            ? "No schedule data"
            : FormatDeadlineDescription();

    private decimal BaselineDifferencePercent
    {
        get
        {
            decimal estimatedCost = selectedSchedules.Sum(schedule => schedule.estimatedCost);
            decimal baselineCost = estimatedCost * 1.15m;   // Temporary baseline

            return baselineCost == 0
                ? 0
                : (baselineCost - estimatedCost) / baselineCost * 100;
        }
    }

    private string FormatDeadlineDescription()
    {
        DateTime finish = selectedSchedules.Max(schedule => schedule.endTime);
        DateTime deadline = finish;
        TimeSpan remaining = deadline - finish;

        if (remaining <= TimeSpan.Zero)
        {
            return remaining == TimeSpan.Zero
                ? "Finishes right on deadline"
                : "Finishes after deadline";    // Probably won't happen, but just in case
        }

        return $"Finishes {FormatDuration(remaining)} before deadline";
    }

    private void TogglePlanPicker()
    {
        isPlanPickerOpen = !isPlanPickerOpen;
    }

    private void SelectPlan(string planId)
    {
        selectedPlanId = planId;
        isPlanPickerOpen = false;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState? state = await AuthProvider.GetAuthenticationStateAsync();
            string? userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (string.IsNullOrWhiteSpace(userId))
            {
                loadError = "The current user could not be identified.";
                return;
            }

            using HttpRequestMessage? request = new HttpRequestMessage(HttpMethod.Get, "api/plan-controller/get-plan");
            request.Headers.Add("UserId", userId);

            using HttpResponseMessage? response = await Http.SendAsync(request);
            response.EnsureSuccessStatusCode();
            allSchedules = await response.Content.ReadFromJsonAsync<List<PlanDto>>() ?? new();
            BuildPlansFromSchedules();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load optimized plan data");
            loadError = "The optimized plan could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatDuration(TimeSpan duration)
    {
        return duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours}h {duration.Minutes}m"
            : $"{duration.Minutes}m";
    }

    private void BuildPlansFromSchedules()
    {
        if (allSchedules.Count == 0)
        {
            return;
        }

        Dictionary<int, PlanDto> plansById = allSchedules.ToDictionary(schedule => schedule.planId);
        HashSet<int> continuationIds = allSchedules
            .Where(schedule => schedule.nextPlanId.HasValue)
            .Select(schedule => schedule.nextPlanId!.Value)
            .ToHashSet();

        plans = allSchedules
            .Where(schedule => !continuationIds.Contains(schedule.planId))
            .Select(root => CreatePlan(root, plansById))
            .ToList();

        if (plans.Count > 0 && !plans.Any(plan => plan.Id == selectedPlanId))
        {
            selectedPlanId = plans[0].Id;
        }
    }

    private static Plan CreatePlan(PlanDto root, Dictionary<int, PlanDto> plansById)
    {
        List<PlanDto> schedules = new();
        HashSet<int> visited = new();
        PlanDto? current = root;

        while (current is not null && visited.Add(current.planId))
        {
            schedules.Add(current);
            current = current.nextPlanId is { } nextId
                && plansById.TryGetValue(nextId, out PlanDto? next)
                    ? next
                    : null;
        }

        DateTime start = schedules.Min(schedule => schedule.startTime);
        DateTime end = schedules.Max(schedule => schedule.endTime);

        return new Plan(
            root.planId.ToString(CultureInfo.InvariantCulture),
            root.planName,
            root.deviceName,
            $"{start:HH:mm}–{end:HH:mm}",
            schedules,
            IconFor(root.icon, root.deviceName));
    }

    private static RenderFragment IconFor(string icon, string deviceName)
    {
        if (icon.Contains("car", StringComparison.OrdinalIgnoreCase)
            || icon.Contains("ev", StringComparison.OrdinalIgnoreCase)
            || deviceName.Contains("car", StringComparison.OrdinalIgnoreCase)
            || deviceName.Contains("ev", StringComparison.OrdinalIgnoreCase))
        {
            return Icons.Car;
        }

        if (icon.Contains("wash", StringComparison.OrdinalIgnoreCase)
            || deviceName.Contains("wash", StringComparison.OrdinalIgnoreCase))
        {
            return Icons.WashingMachine;
        }

        return Icons.Cpu;
    }

    private sealed record Plan(
        string Id,
        string Name,
        string Device,
        string Window,
        List<PlanDto> Schedules,
        RenderFragment Icon);

    private static readonly Plan EmptyPlan = new Plan(
        string.Empty,
        "No plan",
        "No device",
        "--",
        new List<PlanDto>(),
        Icons.Cpu);
}


<style>
