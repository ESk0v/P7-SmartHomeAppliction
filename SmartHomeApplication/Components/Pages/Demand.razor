@page "/demand"
@attribute [Authorize]

@inject HttpClient Http

@using System.Globalization
@rendermode InteractiveServer
@using Utilities.Models
@using System.Security.Claims

@inject AuthenticationStateProvider AuthProvider


<PageTitle>New demand</PageTitle>

<SectionContent SectionName="TopBarActions">
    <div class="header">
        <div class="heading">
            <h1>New demand</h1>
            <p>Configure a new scheduling demand..</p>
        </div>

        <div class="header-actions">

        </div>
    </div>
</SectionContent>

<div class="row">
    <div class="col-sm-7 boxes">
        <EditForm Method="post" Model="ScheduleDTO" OnValidSubmit="GenerateScheduling" FormName="AddSchedulingForm">
            <DataAnnotationsValidator />
            <div class="inboxes">
                <label for="deviceName" class="form-label">Device Name</label>
                <InputSelect @bind-Value="selectedDeviceId" @bind-Value:after="OnDeviceSelected" class="form-select" id="deviceName">
                    <option value=""></option>
                    @foreach (UserDeviceDto device in userDevices)
                    {
                        <option value="@device.id">@device.deviceNickname</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => ScheduleDTO.DeviceName" class="text-danger" />
        
            </div>   
            @if (isEVSelected)
            {
                <div class="section-card mb-4 inboxes">
                    <p>Current charge</p>
                    <p>Target charge</p>
                    <div class="mb-3">
                        <label class="form-label">Charge from: @(ScheduleDTO.ChargeStartPercentage)%</label>
                        <InputNumber @bind-Value="ScheduleDTO.ChargeStartPercentage" max="100" min="0" step="10" type="range" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Charge to: @(ScheduleDTO.ChargeStopPercentage)%</label>
                        <InputNumber @bind-Value="ScheduleDTO.ChargeStopPercentage" max="100" min="0" step="10" type="range" />
                    </div>
                </div>
            } 
            else 
            {
                <div class="inboxes">
                    <label for="devicePreset" class="form-label">Device Preset</label>
                    <InputSelect @bind-Value="ScheduleDTO.Preset" class="form-select" id="devicePreset">
                        <option value=""></option>
                        @foreach (PresetDto preset in filteredPresets)
                        {
                            <option value="@preset.presetName">@preset.presetName</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => ScheduleDTO.Preset" class="text-danger" />
                </div>  
            }

            <div class="inboxes">
                <p>ALLOWED WINDOW</p>
                <div>
                    <label class="form-label">START</label>
                    <div class="d-flex gap-2 align-items-center">
                        <InputSelect @bind-Value="ScheduleDTO.StartHour" class="form-select" id="startHour">
                            <option value=""></option>
                            @foreach (var hour in Hours)
                            {
                                <option value="@hour">@hour.ToString("D2")</option>
                            }
                        </InputSelect>
                        <span>:</span>
                        <InputSelect @bind-Value="ScheduleDTO.StartMinute" class="form-select" id="startMinute">
                            <option value=""></option>
                            @foreach (var minute in Minutes)
                            {
                                <option value="@minute">@minute.ToString("D2")</option>
                            }
                        </InputSelect>
                    </div>
                    <ValidationMessage For="() => ScheduleDTO.StartHour" class="text-danger" />
                    <ValidationMessage For="() => ScheduleDTO.StartMinute" class="text-danger" />
                </div>

                <div>
                    <label class="form-label">END</label>
                    <div class="d-flex gap-2 align-items-center">
                        <InputSelect @bind-Value="ScheduleDTO.EndHour" class="form-select" id="endHour">
                            <option value=""></option>
                            @foreach (var hour in Hours)
                            {
                                <option value="@hour">@hour.ToString("D2")</option>
                            }
                        </InputSelect>
                        <span>:</span>
                        <InputSelect @bind-Value="ScheduleDTO.EndMinute" class="form-select" id="endMinute">
                            <option value=""></option>
                            @foreach (var minute in Minutes)
                            {
                                <option value="@minute">@minute.ToString("D2")</option>
                            }
                        </InputSelect>
                    </div>
                </div>
                <ValidationMessage For="() => ScheduleDTO.EndHour" class="text-danger" />
                <ValidationMessage For="() => ScheduleDTO.EndMinute" class="text-danger" />
            </div>

            <div class="mb-4 inboxes">
                <label class="form-label">Priority</label>
                <InputRadioGroup @bind-Value="ScheduleDTO.Priority" class="priority-toggle">
                    <label class="priority-option">
                        <InputRadio Value="@("Cheapest")" />
                        <span>Cheapest</span>
                    </label>
                    <label class="priority-option">
                        <InputRadio Value="@("Greenest")" />
                        <span>Greenest</span>
                    </label>
                </InputRadioGroup>
                <ValidationMessage For="() => ScheduleDTO.Priority" class="text-danger" />
                    
                    
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Generate Plan</button>
            </div>
        </EditForm>
    </div>
    <div class="col-sm-5">
        <div class="mb-4 boxes">
            <h2>24HR prices</h2>
            <p>Here you will see price graph.</p>
        </div>
        <div class="mb-4 boxes">
            <EditForm Method="post" Model="ScheduleDTO" OnValidSubmit="addPlan" FormName="AddPlanForm">

                @if (displayPlan)
                {
                    <h2>Generated plan</h2>
                    <p>Start time: @response.StartTime.ToString("MMM dd yyyy HH:mm")</p>
                    <p>End time: @response.EndTime.ToString("MMM dd yyyy HH:mm")</p>
                    <p>Estimated price: @response.EstimatedPrice</p>
                    <p>Estimated CO2 emission: @response.EstimatedCo2Emissions</p>

                }
                else
                {
                    <h2>Generated plan</h2>
                    <p>No plan generated yet.</p>
                }
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Save Plan</button>
                </div>
            </EditForm> 
        </div>
        
        
    </div>
</div>



@code {
    private string date = DateTime.Today.ToString("ddd dd MMM yyyy", CultureInfo.InvariantCulture);
    private string area = "DK1";

    private ScheduleDTO ScheduleDTO = new();

    private OptimizationResultDTO response = new();

    // hent alle devices 
    // hente presets ud fra hvilket device der er valgt i drop down

    private List<PresetDto> filteredPresets = new();
    private List<DevicePresetDto> allDevicePresets = new List<DevicePresetDto>();
    private string? selectedDeviceId;
    private List<UserDeviceDto> userDevices = new();
    private OptimizationRequestDTO optimizationRequest = new();


    // public int deviceId = 1;
    // public string userId = "404b854b-d1c0-425f-bd41-1239a66de7df";
    private List<int> Hours { get; set; } = new();
    private int [] Minutes = {00, 15, 30, 45};

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);

        userDevices = await Http.GetFromJsonAsync<List<UserDeviceDto>>($"api/preset-controller/get-user-device/{userId}") ?? new List<UserDeviceDto>();

        foreach (UserDeviceDto userDevice in userDevices)
        {
            // Console.WriteLine($" {userDevice.id}");

            var presets = await Http.GetFromJsonAsync<List<PresetDto>>($"api/preset-controller/get-preset/{userDevice.deviceId}") ?? new List<PresetDto>();

            foreach (var preset in presets)
            {
                allDevicePresets.Add(new DevicePresetDto
                {
                    deviceId = userDevice.id.ToString(),
                    preset = preset
                });
            }
        }

        // Console.WriteLine($"User devices: {userDevices.Count}, Presets: {realPresets.Count}");

        int currentHour = DateTime.Now.Hour;
        Hours = Enumerable.Range(0, 24)
            .Select(i => (currentHour + i) % 24)
            .ToList();
    }

    private bool isEVSelected = false;

    private bool displayPlan = false;

    private void ClearSchedule()
    {
        ScheduleDTO = new ScheduleDTO();
        filteredPresets = new List<PresetDto>();
        selectedDeviceId = string.Empty;
    }

    private void OnDeviceSelected()
    {
        // filter i all presets og vælg ud fra device id -> devicePreset
        isEVSelected = userDevices.Any(
            device => device.category == "ev_charger" 
            && device.deviceNickname == ScheduleDTO.DeviceName
        );
        var selectedDevice = userDevices
            .FirstOrDefault(x => x.id.ToString() == selectedDeviceId);

        ScheduleDTO.DeviceName = selectedDevice?.deviceNickname ?? string.Empty;

        filteredPresets = string.IsNullOrEmpty(selectedDeviceId) ? new List<PresetDto>() : allDevicePresets
            .Where(x => x.deviceId == selectedDeviceId)
            .Select(x => x.preset)
            .ToList();

        ScheduleDTO.Preset = string.Empty;
    }

    private DateTime GetScheduledDateTime(int hour, int minute)
    {
        var now = DateTime.Now;
        var scheduledTime = now.Date.AddHours(hour).AddMinutes(minute);

        if (scheduledTime < now)
        {
            scheduledTime = scheduledTime.AddDays(1);
        }
        return scheduledTime;
    }
    private async Task GenerateScheduling()
    {   
        var startTime = GetScheduledDateTime(ScheduleDTO.StartHour!.Value, ScheduleDTO.StartMinute!.Value);
        var endTime = GetScheduledDateTime(ScheduleDTO.EndHour!.Value, ScheduleDTO.EndMinute!.Value);

        if (endTime <= startTime)
        {
            endTime = endTime.AddDays(1);
        }

        var today = DateTime.Today;
        var optimizationRequest = new OptimizationRequestDTO
        {
            Area = area,
            DeviceName = ScheduleDTO.DeviceName,
            ChargeStartPercentage = isEVSelected ? ScheduleDTO.ChargeStartPercentage : null,
            ChargeStopPercentage = isEVSelected ? ScheduleDTO.ChargeStopPercentage : null,
            Preset = isEVSelected ? null : ScheduleDTO.Preset,
            StartTime = startTime,
            EndTime = endTime,
            Priority = ScheduleDTO.Priority
        };

        response = new OptimizationResultDTO
        {
            StartTime = optimizationRequest.StartTime,
            EndTime = optimizationRequest.EndTime,
            EstimatedPrice = 8.5m, 
            EstimatedCo2Emissions = 20
        };

        displayPlan = true;

        await Task.CompletedTask;
        return ;
    }

    private async Task addPlan()
    {
        var selectedDevice = userDevices
            .FirstOrDefault(d => d.id.ToString() == selectedDeviceId);

        if (selectedDevice == null)
        {
            Console.WriteLine("No device selected");
            return;
        }
    

        var planToSave = new PlanDTO
        {
            UserDeviceId = selectedDevice.id,
            StartTime = response.StartTime.ToUniversalTime(),
            EndTime = response.EndTime.ToUniversalTime(),
            NextPlan = null,
            EstimatedPrice = response.EstimatedPrice,
            EstimatedCO2Emission = response.EstimatedCo2Emissions
        };

        try
        {
            var result = await Http.PostAsJsonAsync("api/preset-controller/post-plan", planToSave);
            if (result.IsSuccessStatusCode)
            {
                Console.WriteLine("Plan saved");
                ClearSchedule();
            }
            else
            {
                var error = await result.Content.ReadAsStringAsync();
                Console.WriteLine($"Failed to save plan: {result.StatusCode} - {error}");
            }
        }
        catch (Exception e)
        {
            Console.WriteLine($"Error with saving plan: {e.Message}");
        }
        
    }
}

