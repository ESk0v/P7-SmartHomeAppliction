@page "/demand"
@attribute [Authorize]

@inject HttpClient Http
@inject NavigationManager NavigationManager

@using global::Shared.Dashboard
@using SmartHomeApplication.Components.Shared.Demand
@using System.Globalization
@using System.Reflection
@rendermode InteractiveServer
@using Utilities.Models
@using System.Security.Claims

@inject AuthenticationStateProvider AuthProvider


<PageTitle>New demand</PageTitle>

<SectionContent SectionName="TopBarActions">
    <div class="header">
        <div class="heading">
            <h1>New demand</h1>
            <p>Configure a new scheduling demand..</p>
        </div>

        <div class="header-actions">

        </div>
    </div>
</SectionContent>

<div class="row">
    <div class="col-sm-7">
        <EditForm Method="post" Model="ScheduleForm" OnValidSubmit="GenerateScheduling" FormName="AddSchedulingForm">
            <div class="mb-4 boxes">
                
                <DataAnnotationsValidator />
                <div class="inboxes">
                    <label for="deviceName" class="form-label form-label-down">Device Name</label>
                    <ButtonSelectDevice Options="@(userDevices.Select(d => (d.id.ToString(), d.deviceNickname, d.icon, d.color)))"
                        @bind-Value="selectedDeviceId" @bind-Value:after="OnDeviceSelected" Placeholder="Select device" />
                    <ValidationMessage For="() => ScheduleForm.DeviceName" class="text-danger" />
                </div>   
                
                @if (isEVSelected)
                {
                    <div class="charge-settings mt-4 mb-4">
                        <div class="charge-slider">
                            <div class="charge-slider-header">
                                <label for="chargeStop">Charge to</label>
                                <span>@ScheduleForm.ChargeStopPercentage%</span>
                            </div>
                            <InputNumber id="chargeStop" class="charge-range" @bind-Value="ScheduleForm.ChargeStopPercentage"
                                        min="5" max="100" step="5" type="range" />
                        </div>
                    </div>
                }

                @if (isApplianceSelected)
                {
                    <div class="inboxes">
                        <label for="devicePreset" class="form-label form-label-down">Device Preset</label>
                        <ButtonSelect Options="@(filteredPresets.Select(p => (Value: p.id.ToString(), Text: p.presetName)))"
                            @bind-Value="selectedPresetId"
                            @bind-Value:after="UpdateSelectedPreset"
                            Placeholder="Select preset" />
                        <ValidationMessage For="() => ScheduleForm.Preset" class="text-danger" />
                    </div>  
                }
                <div class="mb-3 mt-2">
                    <label for="planName" class="form-label form-label-input">Name the plan</label>
                    <InputText id="planName" class="form-control" @bind-Value="ScheduleForm.PlanName" />
                </div>
            </div>
            <div class="boxes">
                <div class ="row">
                    <div class="mb-4 col-sm-6 inboxes">
                        <div>
                            <div class="choices mb-4">
                                <span>Scheduling window</span>
                            </div>
                            <div>
                                <label class="form-label1">Start  <i class="bi bi-clock"/></label>
                                <div class="d-flex gap-2 align-items-center">
                                    <ButtonSelect Options="HourOptions" @bind-Value="StartHourText" 
                                        CssClass="time-picker" Placeholder="" />
                                    <span>:</span>

                                    <ButtonSelect Options="MinuteOptions" @bind-Value="StartMinuteText"
                                        CssClass="time-picker" Placeholder="" />
                                </div>
                                <ValidationMessage For="() => ScheduleForm.StartHour" class="text-danger" />
                                <ValidationMessage For="() => ScheduleForm.StartMinute" class="text-danger" />
                            </div>
                            <div class="mt-4">
                                <label class="form-label1">End  <i class="bi bi-clock"/></label>
                                <div class="d-flex gap-2 align-items-center">
                                    <ButtonSelect Options="HourOptions" @bind-Value="EndHourText" 
                                        CssClass="time-picker" Placeholder="" />
                                    <span>:</span>

                                    <ButtonSelect Options="MinuteOptions" @bind-Value="EndMinuteText"
                                        CssClass="time-picker" Placeholder="" />
                                </div>
                            </div>
                            <ValidationMessage For="() => ScheduleForm.EndHour" class="text-danger" />
                            <ValidationMessage For="() => ScheduleForm.EndMinute" class="text-danger" />
                            @if (!string.IsNullOrEmpty(schedulingError))
                            {
                                <div class="alert alert-danger mt-5" roles="alert">
                                    @schedulingError
                                </div>
                            }
                        </div>
                    </div> 
                    <div class="mb-4 col-sm-6 inboxes">
                        <div class="mb-6 choices">
                            <span>Priority</span><br />
                            <label class="form-label1">Choose an option for optimization</label>
                        </div>
            
                        <div class="priority-toggle @(ScheduleForm.Priority == "Greenest" ? "is-right" : "is-left")"
                            role="radiogroup" aria-labelledby="priority-label">
                            <span class="priority-thumb" aria-hidden="true"></span>

                            <button type="button" role="radio"
                                    class="priority-option @(ScheduleForm.Priority == "Cheapest" ? "active" : "")"
                                    aria-checked="@(ScheduleForm.Priority == "Cheapest")"
                                    @onclick='() => SetPriority("Cheapest")'>
                                Cheapest
                            </button>

                            <button type="button" role="radio"
                                    class="priority-option @(ScheduleForm.Priority == "Greenest" ? "active" : "")"
                                    aria-checked="@(ScheduleForm.Priority == "Greenest")"
                                    @onclick='() => SetPriority("Greenest")'>
                                Greenest
                            </button>
                        </div>

                        <ValidationMessage For="() => ScheduleForm.Priority" class="text-danger" />
                    </div>
                    <div class="mb-3 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">Generate Plan</button>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
    <div class="col-sm-5">
        <div class="priceoverview">
            @if (activeSchedules is not null)
            {
                <PriceChart activeSchedules="activeSchedules"/>
            }
        </div>
        <div class="optimized-side-column">
            <section class="optimized-card plan-summary-card">
                @if (displayPlan && response != null)
                {
                    <div class="card-heading">
                        <h2>Plan overview</h2>
                    </div>
                    <div class="summary-row">
                        <div>
                            <span>Start time</span>
                            <small>@((ScheduleForm.PlanName == string.Empty) ? ScheduleForm.DeviceName : ScheduleForm.PlanName) runs for @((ScheduleForm.Preset != null) ? ScheduleForm.Preset.duration : "?") minutes</small>
                        </div>
                        <strong>@response.StartTime.ToString("HH:mm")</strong>
                    </div>
                    <div class="summary-row">
                        <div>
                            <span>Cost</span>
                            <small>Estimated cost for @((ScheduleForm.PlanName == string.Empty) ? ScheduleForm.DeviceName : ScheduleForm.PlanName)</small>
                        </div>
                        <strong class="summary-cost" >@response.EstimatedPrice kroner</strong>
                    </div>
                    <div class="summary-row">
                        <div>
                            <span>CO2 Emission</span>
                            <small>Estimated CO2 emissions for @((ScheduleForm.PlanName == string.Empty) ? ScheduleForm.DeviceName : ScheduleForm.PlanName)</small>
                        </div>
                        <strong class="summary-co2" >@response.EstimatedCo2Emissions %</strong>
                    </div>
                }
                else
                {
                   <div class="card-heading">
                        <h2>Plan overview</h2>
                    </div>
                    <div class="summary-row">
                        <div>
                            <span>No plan generated yet.</span>
                        </div>
                    </div>
                }
                <div class="mb-3 d-flex justify-content-end save-plan-button">
                    <button type="button" @onclick="addPlan" class="btn btn-primary" disabled="@(!displayPlan)">Save Plan</button>
                </div>
                
            </section>
        </div>   
    </div>
</div>

@code {

    // activeSchedules is used to show the price chart with the active plans
    private List<PlanDto>? activeSchedules;
    private string area = "DK1";

    // ScheduleForm is used to collect the data for the optimization request
    private ScheduleForm ScheduleForm = new();

    // filteredPresets is updated when a device is selected, and is used to show the presets for the selected device
    private List<PresetDto> filteredPresets = new();
    private string? selectedPresetId;

    //userDevices is collected from the API and is used to show the devices that the user has registered
    private List<PlanUserDeviceDto> userDevices = new();
    
    //A dictionary that maps device IDs to their corresponding presets. (is used to filter the presets into 'filteredPresets' when a device is selected)
    private Dictionary<int, List<PresetDto>> presetsByDevice = new();
    private string? selectedDeviceId;

    // response is used to store the result of the optimization request, and is used to show the plan overview
    private OptimizationResultDTO? response;

    private List<int> Hours { get; set; } = new();
    private int [] Minutes = {00, 15, 30, 45};
    private IEnumerable<(string Value, string Text)> HourOptions =>
    Hours.Select(h => (h.ToString(), h.ToString("D2")));
    private IEnumerable<(string Value, string Text)> MinuteOptions =>
    Minutes.Select(m => (m.ToString(), m.ToString("D2")));
    private string? schedulingError;

    // Methods to convert the start and end hour and minute values to and from strings.
    private string? StartHourText
    {
        get => ScheduleForm.StartHour?.ToString();
        set => ScheduleForm.StartHour =
            int.TryParse(value, out var hour) ? hour : null;
    }

    private string? StartMinuteText
    {
        get => ScheduleForm.StartMinute?.ToString();
        set => ScheduleForm.StartMinute =
            int.TryParse(value, out var minute) ? minute : null;
    }
    private string? EndHourText
    {
        get => ScheduleForm.EndHour?.ToString();
        set => ScheduleForm.EndHour =
            int.TryParse(value, out var hour) ? hour : null;
    }

    private string? EndMinuteText
    {
        get => ScheduleForm.EndMinute?.ToString();
        set => ScheduleForm.EndMinute =
            int.TryParse(value, out var minute) ? minute : null;
    }
    private bool isEVSelected = false;
    private bool isApplianceSelected = false;
    private bool displayPlan = false;


    //On initialization, user is found and fetches active schedules, user devices and their presets from the API.
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);

        var request = new HttpRequestMessage(HttpMethod.Get, "api/plan-controller/get-plan");
        request.Headers.Add("UserId", userId);

        var response = await Http.SendAsync(request);
        response.EnsureSuccessStatusCode();
        activeSchedules = await response.Content.ReadFromJsonAsync<List<PlanDto>>();

        userDevices = await Http.GetFromJsonAsync<List<PlanUserDeviceDto>>($"api/createPlan-controller/get-user-device/{userId}") ?? new List<PlanUserDeviceDto>();

        foreach (PlanUserDeviceDto userDevice in userDevices)
        {
            var presets = await Http.GetFromJsonAsync<List<PresetDto>>($"api/createPlan-controller/get-preset/{userDevice.deviceId}") ?? new List<PresetDto>();

            presetsByDevice[userDevice.id] = presets;
        }

        int currentHour = DateTime.Now.Hour + 1;
        Hours = Enumerable.Range(0, 24)
            .Select(i => (currentHour + i) % 24)
            .ToList();
    }

    private void SetPriority(string value)
    {
        ScheduleForm.Priority = value;

    }

    private void ClearSchedule()
    {
        ScheduleForm = new ScheduleForm();
        filteredPresets = new List<PresetDto>();
        selectedDeviceId = string.Empty;
        response = null;
        displayPlan = false;
        isEVSelected = false;
        isApplianceSelected = false;
    }

    // This method is called when a device is selected from the dropdown. 
    // It updates the ScheduleForm with the selected device's name, filters the presets for the selected device, 
    // and checks if the selected device is an EV charger or an appliance.
    private void OnDeviceSelected()
    {

        var selectedDevice = userDevices
            .FirstOrDefault(x => x.id.ToString() == selectedDeviceId);

        ScheduleForm.DeviceName = selectedDevice?.deviceNickname ?? string.Empty;

        filteredPresets = selectedDevice != null && presetsByDevice.TryGetValue(selectedDevice.id, out var presets)
        ? presets : new List<PresetDto>();

        isEVSelected = selectedDevice?.category == "ev_charger";
        isApplianceSelected = selectedDevice?.category != "ev_charger";
        
        selectedPresetId = null;
        ScheduleForm.Preset = new PresetDto();
    }

    // This method is called when a preset is selected from the dropdown.
    // It updates the ScheduleForm with the selected preset.
    private void UpdateSelectedPreset()
    {
        var selectedPreset = filteredPresets.FirstOrDefault(p => p.id.ToString() == selectedPresetId);

        if (selectedPreset is not null)
        {
            ScheduleForm.Preset = selectedPreset;
        }
        schedulingError = null;
    }
    
    // This method calculates the scheduled DateTime based on the provided hour and minute and the current time
    private DateTime GetScheduledDateTime(int hour, int minute)
    {
        var now = DateTime.Now;
        var scheduledTime = now.Date.AddHours(hour).AddMinutes(minute);

        if (scheduledTime < now)
        {
            scheduledTime = scheduledTime.AddDays(1);
        }
        return scheduledTime;
    }

    //This method is called when the 'generate plan' button is clicked.
    // it calls the optimization API with the data from the ScheduleForm and updates the response (used to display the plan) with the result.
    private async Task GenerateScheduling()
    {   
        schedulingError = null;
        var startTime = GetScheduledDateTime(ScheduleForm.StartHour!.Value, ScheduleForm.StartMinute!.Value);
        var endTime = GetScheduledDateTime(ScheduleForm.EndHour!.Value, ScheduleForm.EndMinute!.Value);

        if (endTime <= startTime)
        {
            endTime = endTime.AddDays(1);
        }

        var timeWindow = (int)(endTime - startTime).TotalMinutes;

        if (ScheduleForm.Preset != null && ScheduleForm.Preset.duration > timeWindow)
        {
            schedulingError = $"The selected program requires {ScheduleForm.Preset.duration} minutes.";
            return;
        }

        var optimizationRequest = new OptimizationRequestDTO
        {
            Area = area,
            DeviceName = ScheduleForm.DeviceName,
            ChargeStopPercentage = isEVSelected ? ScheduleForm.ChargeStopPercentage : null,
            Preset = isEVSelected ? null : ScheduleForm.Preset,
            StartTime = startTime,
            EndTime = endTime,
            Priority = ScheduleForm.Priority
        };

        try
        {
            var result = await Http.PostAsJsonAsync("api/optimization-controller/optimize", optimizationRequest);

            if (!result.IsSuccessStatusCode)
            {
                Console.WriteLine($"Optimization did not work {result.StatusCode}");
            }
            else
            {
                response = await result.Content.ReadFromJsonAsync<OptimizationResultDTO>();
                
                displayPlan = true;

                Console.WriteLine("Optimization worked");
            }    
        }
        catch (Exception e)
        {
            Console.WriteLine($"Error with opptimization: {e.Message}");
        }

        await Task.CompletedTask;
        return ;
    }

    // This method is called when the 'save plan' button is clicked.
    // It creates a PlanDTO object with the data from the ScheduleForm and the response from the optimization and sends it to API to be saved in DB
    private async Task addPlan()
    {
        var selectedDevice = userDevices
            .FirstOrDefault(d => d.id.ToString() == selectedDeviceId);

        if (selectedDevice == null)
        {
            Console.WriteLine("No device selected");
            return;
        }

        if (response is null)
        {
            Console.WriteLine("OptimizationResult is null");
            return;
        }


        var planToSave = new PlanDTO
        {
            userDeviceId = selectedDevice.id,
            startTime = response.StartTime.ToUniversalTime(),
            endTime = response.EndTime.ToUniversalTime(),
            nextPlanId = null,
            estimatedCost = response.EstimatedPrice,
            estimatedCo2Emissions = response.EstimatedCo2Emissions,
            estimatedUnscheduledCost = response.EstimatedPrice + 1,
            estimatedUnscheduledCo2Emissions = response.EstimatedCo2Emissions + 1,
            planName = (ScheduleForm.PlanName == string.Empty) ? ScheduleForm.DeviceName : ScheduleForm.PlanName,
            optimizationObjective = ScheduleForm.Priority
        };

        try
        {
            var result = await Http.PostAsJsonAsync("api/createPlan-controller/post-plan", planToSave);
            if (result.IsSuccessStatusCode)
            {
                Console.WriteLine("Plan saved");
                ClearSchedule();
                NavigationManager.NavigateTo("/optimized");

            }
            else
            {
                var error = await result.Content.ReadAsStringAsync();
                Console.WriteLine($"Failed to save plan: {result.StatusCode} - {error}");
            }
        }
        catch (Exception e)
        {
            Console.WriteLine($"Error with saving plan: {e.Message}");
        }

    }
}

