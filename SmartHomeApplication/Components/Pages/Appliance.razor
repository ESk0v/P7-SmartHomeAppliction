@page "/appliance"
@attribute [Authorize]
@inject SmartHomeApplication.Service.IDeviceService DeviceService
@using Utilities.Models
@using global::Shared.Dashboard

<PageTitle>Appliances</PageTitle>

<SectionContent SectionName="TopBarActions">
    <div class="header">
        <div class="heading">
            <h1>Appliance registry</h1>
            <p>@amount devices</p>
        </div>

        <div class="header-actions">
            <NavLink class="nav-link" href="addAppliance" Match="NavLinkMatch.All">
                <PrimaryButton>
                New device
                </PrimaryButton>
            </NavLink>
        </div>
    </div>

</SectionContent>

@if (message is not null)
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible" role="alert">
        @message
        <button type="button" class="btn-close" @onclick="() => message = null"></button>
    </div>
}

<div class="appliance-layout">

    <div class="device-list">
        @if (userdevices.Count == 0)
        {
            <p class="p-3 text-muted">No devices yet.</p>
        }
        @foreach (var device in userdevices)
        {
           <button type="button"
            class="device-item @(selected?.Id == device.Id ? "active" : "")"
            @onclick="() => Select(device)">
            <div class="device-icon" style="color: @device.Color;">
                <i class="bi @ScheduleIcons.Get(device.Icon)"></i>
            </div>
            <div>
                <div class="device-name">@device.Nickname</div>
            </div>
        </button>
        }
    </div>

    <div class="device-detail">
        @if (editDevice is null)
        {
            <p class="text-muted">Select a device to see its details.</p>
        }
        else
        {
            <EditForm Model="editDevice" OnValidSubmit="SaveChanges">
                <AntiforgeryToken />
                <DataAnnotationsValidator />

                <div class="row g-2 mb-3">
                    <div class="mb-3">
                        <label class="form-label" for="name">Nickname</label>
                        <InputText id="name" class="form-control" @bind-Value="editDevice.Nickname" />
                        <ValidationMessage For="() => editDevice.Nickname" class="text-danger" />
                    </div>
                        <div class="mb-3">
                        <label class="form-label">Icon</label>
                        <div class="icon-picker">
                            @foreach (var name in iconOptions)
                            {
                                <button type="button"
                                        class="icon-option @(editDevice.Icon == name ? "selected" : "")"
                                        title="@name"
                                        @onclick="() => editDevice.Icon = name">
                                    <i class="bi @ScheduleIcons.Get(name)"></i>
                                </button>
                            }
                        </div>
                    </div>
                        <div class="mb-3">  
                        <label class="form-label">Color</label>
                            <InputText type="color" class="form-control form-control-color" @bind-Value="editDevice.Color" />
                        </div>
                    <div class="mb-3">
                        <label class="form-label">Favorite</label>
                        <input class="form-check-input" type="checkbox" @bind="editDevice.IsFavorite" />
                        <ValidationMessage For="() => editDevice.IsFavorite" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Model</label>
                        <input class="form-control" value="@selected!.Model" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <input class="form-control" value="@selected!.Category" disabled />
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    private static readonly string[] iconOptions =
            Enum.GetNames<DeviceIcon>()
                .Where(n => n != nameof(DeviceIcon.default_icon))
                .ToArray();


    private int amount = 0;

    private string? message;
    private bool isError = false;

    private List<UserDeviceDto> userdevices = new();
    private UserDeviceDto? selected;
    private UpdateUserDeviceDto? editDevice;

    protected override async Task OnInitializedAsync()
    {
        userdevices = (await DeviceService.GetUserDevicesAsync()).ToList();
        amount = userdevices.Count;
        if (userdevices.Count > 0) {
            Select(userdevices.First());
        }       
    }

    private void Select(UserDeviceDto device)
    {
        selected = device;
        editDevice = new UpdateUserDeviceDto
        {   Id = device.Id,
            Nickname = device.Nickname,
            Icon = device.Icon,
            IsFavorite = device.IsFavorite,
            Color = device.Color,
        };  
    }

  private async Task SaveChanges()
{
    if (selected is null || editDevice is null) return;

    try
    {
        await DeviceService.UpdateUserDeviceAsync(editDevice);

        selected.Id = editDevice.Id;
        selected.Nickname = editDevice.Nickname;
        selected.Icon = editDevice.Icon;
        selected.Color = editDevice.Color;
        selected.IsFavorite = editDevice.IsFavorite;

        isError = false;
        message = "Device updated successfully!";
    }
    catch (Exception ex)
    {
        isError = true;
        message = $"Error updating device: {ex.Message}";
    }
}

    private void Cancel()
    {
        if (selected is not null)
        {
            Select(selected);   
        }
    }
    
}

<style>
    .header {
        align-items: center;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        width: 100%;
    }

    .heading h1 {
        color: #222;
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 0.6;
        margin: 0;
    }

    .heading p {
        color: #999;
        font-size: 0.70rem;
        line-height: 0.75;
        margin: 0;
    }

    .heading {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .header-actions {
        align-items: center;
        display: flex;
        flex-shrink: 0;
        gap: 0.5rem;
    }

    @@media (max-width: 640.98px) {
        .header {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.5rem;
        }

        .header-actions {
            width: 100%;
        }
    }

    .appliance-layout {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 1.5rem;
    align-items: start;
    }

    .device-list {
        background: #fff;
        border-radius: 1rem;
        border: 1px solid #e5e5e5;
        overflow: hidden;
    }

    .device-item {
        display: flex;
        gap: 1rem;
        align-items: center;
        width: 100%;
        padding: 1rem;
        background: none;
        border: 0;
        border-bottom: 1px solid #eee;
        text-align: left;
    }

    .device-item:hover { background: #f7f7fb; }

    .device-item.active {
        background: #e9e8fb;
        box-shadow: inset -3px 0 0 #7b6ee6;   
    }

    .device-icon {
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
    }

    .device-name { font-weight: 600; }
    .device-sub  { font-size: .85rem; color: #888; }

    .device-detail {    
        background: #fff;
        border-radius: 1rem;
        border: 1px solid #e5e5e5;
        padding: 2rem;
    }
    
    .icon-picker { display: flex; flex-wrap: wrap; gap: .5rem; }

    .icon-option {
        width: 44px; height: 44px;
        border-radius: 12px;
        border: 1px solid #ddd;
        background: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.25rem;
    }

    .icon-option:hover { background: #f7f7fb; }

    .icon-option.selected {
        border-color: #7b6ee6;
        background: #e9e8fb;
        color: #7b6ee6;
    }

    @@media (max-width: 991.98px) {
        .appliance-layout { grid-template-columns: 1fr; }
    }
    
</style>