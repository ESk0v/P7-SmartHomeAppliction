@page "/appliance"
@attribute [Authorize]
@inject SmartHomeApplication.Service.IDeviceService DeviceService
@using Utilities.Models

<PageTitle>Appliances</PageTitle>

<SectionContent SectionName="TopBarActions">
    <div class="header">
        <div class="heading">
            <h1>Appliance registry</h1>
            <p>@amount devices</p>
        </div>

        <div class="header-actions">
            <NavLink class="nav-link" href="addAppliance" Match="NavLinkMatch.All">
                <PrimaryButton>
                New device
                </PrimaryButton>
            </NavLink>
        </div>
    </div>
</SectionContent>

<h1>This is for seeing all appliances</h1>

@foreach (var device in userdevices)
{
    <div class="card shadow-sm border-0 rounded-4 p-4 bg-white h-100 mb-3">
        <h2 class="h5 mb-4">@device.Model</h2>
        <p>Nickname: @device.Nickname</p>
        <p>Category: @device.Category</p>
    </div>
}




@code {
    private int amount = 0;

    private List<UserDeviceDto> userdevices = new List<UserDeviceDto>();
    
    protected override async Task OnInitializedAsync()
    {
        userdevices = (await DeviceService.GetUserDevicesAsync()).ToList();
        amount = userdevices.Count;
    }
}

<style>
    .header {
        align-items: center;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        width: 100%;
    }

    .heading h1 {
        color: #222;
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 0.6;
        margin: 0;
    }

    .heading p {
        color: #999;
        font-size: 0.70rem;
        line-height: 0.75;
        margin: 0;
    }

    .heading {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .header-actions {
        align-items: center;
        display: flex;
        flex-shrink: 0;
        gap: 0.5rem;
    }

    @@media (max-width: 640.98px) {
        .header {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.5rem;
        }

        .header-actions {
            width: 100%;
        }

    }
</style>