@page "/device"
@attribute [Authorize]
@inject SmartHomeApplication.Service.IDeviceService DeviceService
@inject INotificationService NotificationService
@using Utilities.Models
@using global::Shared.Dashboard

<PageTitle>Devices</PageTitle>

<SectionContent SectionName="TopBarActions">
    <div class="header">
        <div class="heading">
            <h1>Device registry</h1>
            <p>@amount devices</p>
        </div>

        <div class="header-actions">
            <PrimaryButton Href="add-device">
                New device
                </PrimaryButton>
        </div>
    </div>

</SectionContent>

<div class="appliance-layout">

    <div class="device-list">
        @if (userdevices.Count == 0)
        {
            <p class="p-3 text-muted">No devices yet.</p>
        }
        @foreach (UserDeviceDto device in userdevices)
{
    bool isExpanded = expandedIds.Contains(device.Id);

    <div class="device-group">
        <div class="device-item @(selected?.Id == device.Id ? "active" : "")">
            <button type="button" class="device-main" aria-pressed="@(selected?.Id == device.Id ? "true" : "false")" @onclick="() => Select(device)">
                <div class="device-icon" style="color: @device.Color;">
                    <i aria-hidden="true" class="bi @ScheduleIcons.Get(device.Icon)"></i>
                </div>
                <div class="device-name">@device.Nickname</div>
            </button>

            @if (device.Category != "Interruptible")
            {
                <button type="button" class="device-expand" aria-label="@($"{device.Presets.Count} presets for {device.Nickname}")" aria-expanded="@(isExpanded ? "true" : "false")" aria-controls="@($"presets-{device.Id}")"
                        @onclick="() => ToggleExpand(device.Id)">
                    <span class="preset-count">@device.Presets.Count</span>
                    <i aria-hidden="true" class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>
            }
        </div>

        @if (isExpanded && device.Category != "Interruptible")
        {
            <div id="@($"presets-{device.Id}")" class="preset-list">
                @foreach (PresetDeviceDto preset in device.Presets)
                {
                    <button type="button"
                            aria-pressed="@(selected?.Id == device.Id && editPreset?.Id == preset.Id && !isAddingPreset ? "true" : "false")"
                            class="preset-item @(selected?.Id == device.Id && editPreset?.Id == preset.Id && !isAddingPreset ? "active" : "")"
                            @onclick="() => OpenPreset(device, preset)">
                        <span>@preset.PresetName</span>
                    </button>
                }
                <button type="button" class="preset-add" @onclick="() => OpenAddPreset(device)">
                    <i aria-hidden="true" class="bi bi-plus"></i> Add preset
                </button>
            </div>
        }
    </div>
}
    </div>

    <div class="device-detail">
        @if (selected is null || editDevice is null)
        {
            <p class="text-muted">Select a device to see its details.</p>
        }
        else if (editPreset is not null)
        {
            <h2 class="h5 mb-4">@(isAddingPreset ? "Add preset" : $"Edit {editPreset.PresetName} preset for {editDevice.Nickname}")</h2>
            <EditForm Model="editPreset" OnValidSubmit="SavePreset">
                <AntiforgeryToken />
                <DataAnnotationsValidator />
                <FormErrors FieldIds='@(new Dictionary<string, string> { [nameof(editPreset.PresetName)] = "presetName", [nameof(editPreset.ConsumptionInKwh)] = "presetConsumption", [nameof(editPreset.DurationInMinutes)] = "presetDuration" })' />

                <div class="mb-3">
                        <label class="form-label" for="presetName">Preset name</label>
                        <InputText readonly="@(!isAddingPreset)" id="presetName" aria-describedby="presetName-error" class="form-control" @bind-Value="editPreset.PresetName" />
                        <ValidationMessage For="() => editPreset.PresetName" class="text-danger" id="presetName-error" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="presetConsumption">Consumption (kWh)</label>
                    <InputNumber id="presetConsumption" aria-describedby="presetConsumption-error" class="form-control" @bind-Value="editPreset.ConsumptionInKwh" />
                    <ValidationMessage For="() => editPreset.ConsumptionInKwh" class="text-danger" id="presetConsumption-error" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="presetDuration">Duration (minutes)</label>
                    <InputNumber id="presetDuration" aria-describedby="presetDuration-error" class="form-control" @bind-Value="editPreset.DurationInMinutes" />
                    <ValidationMessage For="() => editPreset.DurationInMinutes" class="text-danger" id="presetDuration-error" />
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">@(isAddingPreset ? "Add preset" : "Save preset")</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelPreset">Cancel</button>
                </div>
            </EditForm>
        }
        else
        {
            <EditForm Model="editDevice" OnValidSubmit="SaveChanges">
                <AntiforgeryToken />
                <DataAnnotationsValidator />
                <FormErrors FieldIds='@(new Dictionary<string, string> { [nameof(editDevice.Nickname)] = "name", [nameof(editDevice.BatteryCapacityInKwh)] = "batteryCapacity", [nameof(editDevice.ConsumptionInKwh)] = "deviceConsumption", [nameof(editDevice.Color)] = "deviceColor", [nameof(editDevice.Icon)] = "deviceIcon" })' />
                    <div class="mb-3">
                        <label class="form-label" for="name">Nickname</label>
                        <InputText id="name" aria-describedby="name-error" class="form-control" @bind-Value="editDevice.Nickname" />
                        <ValidationMessage For="() => editDevice.Nickname" class="text-danger" id="name-error" />
                    </div>
                    <div class="row g-4 mb-3">
                        <div class="col-12 col-sm">
                            <span id="device-icon-label" class="form-label">Icon</span>
                            <div id="deviceIcon" class="icon-picker" role="group" aria-labelledby="device-icon-label">
                                @foreach (string name in iconOptions)
                                {
                                    <button type="button"
                                            class="icon-option @(editDevice.Icon == name ? "selected" : "")"
                                            aria-label="@name" aria-pressed="@(editDevice.Icon == name ? "true" : "false")" title="@name"
                                            @onclick="() => editDevice.Icon = name">
                                        <i aria-hidden="true" class="bi @ScheduleIcons.Get(name)"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="col-auto">
                            <label class="form-label d-block" for="deviceColor">Color</label>
                            <InputText id="deviceColor" aria-describedby="deviceColor-error" type="color" list="deviceColorSuggestions" class="form-control form-control-color" @bind-Value="editDevice.Color" />
                            <datalist id="deviceColorSuggestions">
                                <option value="#7569e8" label="Indigo"></option>
                                <option value="#3b82f6" label="Blue"></option>
                                <option value="#14b8a6" label="Teal"></option>
                                <option value="#22c55e" label="Green"></option>
                                <option value="#eab308" label="Yellow"></option>
                                <option value="#f97316" label="Orange"></option>
                                <option value="#ef4444" label="Red"></option>
                                <option value="#ec4899" label="Pink"></option>
                                <option value="#6b7280" label="Grey"></option>
                            </datalist>
                        </div>
                        <div class="col-auto">
                            <label class="form-label d-block" for="deviceFavorite">Favorite</label>
                            <input id="deviceFavorite" class="form-check-input" type="checkbox" @bind="editDevice.IsFavorite" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="readonlyModel">Model</label>
                        <input id="readonlyModel" class="form-control" value="@selected!.Model" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="readonlyCategory">Category</label>
                        <input id="readonlyCategory" class="form-control" value="@selected!.Category" disabled />
                    </div>
                    @if (selected.Category == "Interruptible")
                    {
                        <div class="mb-3">
                            <label class="form-label" for="batteryCapacity">Battery capacity (kWh)</label>
                            <InputNumber id="batteryCapacity" aria-describedby="batteryCapacity-error" class="form-control" @bind-Value="editDevice.BatteryCapacityInKwh" />
                            <ValidationMessage For="() => editDevice.BatteryCapacityInKwh" class="text-danger" id="batteryCapacity-error" />
                            <small class="text-muted">Shared by devices with the same model.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="deviceConsumption">Consumption (kWh)</label>
                            <InputNumber id="deviceConsumption" aria-describedby="deviceConsumption-error" class="form-control" @bind-Value="editDevice.ConsumptionInKwh" />
                            <ValidationMessage For="() => editDevice.ConsumptionInKwh" class="text-danger" id="deviceConsumption-error" />
                        </div>
                    }
                <div class="mt-4 d-flex align-items-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button> 
                    <button type="button" class="btn btn-outline-danger ms-auto" @onclick="() => DeleteUserDevice(selected.Id)" disabled="@isDeleting">Delete</button>
                </div>
            </EditForm>
        }
    </div>
</div>

<ConfirmationDialog @ref="deleteConfirmation" />

@code {
    private ConfirmationDialog deleteConfirmation = default!;
    private bool isDeleting;
    private static readonly string[] iconOptions =
            Enum.GetNames<DeviceIcon>()
                .ToArray();

    private int amount => userdevices.Count;

    private List<UserDeviceDto> userdevices = new();
    private UserDeviceDto? selected;
    private UpdateUserDeviceDto? editDevice;
    private PresetDeviceDto? editPreset;
    private bool isAddingPreset;
    private string previouslySelectedDeviceName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        userdevices = (await DeviceService.GetUserDevicesAsync()).ToList();
        if (userdevices.Count > 0) {
            Select(userdevices.First());
        }       
    }

    private HashSet<int> expandedIds = new();

    private void ToggleExpand(int deviceId)
    {
        if (!expandedIds.Remove(deviceId))
            expandedIds.Add(deviceId);
    }

    private void OpenPreset(UserDeviceDto device, PresetDeviceDto preset)
    {
        Select(device);         
        EditPreset(preset);     
    }

    private void OpenAddPreset(UserDeviceDto device)
    {
        Select(device);
        BeginAddPreset();
    }

    private void Select(UserDeviceDto device)
    {
        selected = device;
        editPreset = null;
        isAddingPreset = false;
        editDevice = new UpdateUserDeviceDto
        {   Id = device.Id,
            Category = device.Category,
            Nickname = device.Nickname,
            Icon = device.Icon,
            IsFavorite = device.IsFavorite,
            Color = device.Color,
            BatteryCapacityInKwh = device.BatteryCapacityInKwh,
            ConsumptionInKwh = device.ConsumptionInKwh,
        };  
    }

    private void EditPreset(PresetDeviceDto preset)
    {
        editPreset = new PresetDeviceDto
        {
            Id = preset.Id,
            PresetName = preset.PresetName,
            ConsumptionInKwh = preset.ConsumptionInKwh,
            DurationInMinutes = preset.DurationInMinutes,
            BatteryCapacityInKwh = preset.BatteryCapacityInKwh
        };
        isAddingPreset = false;
    }

    private void BeginAddPreset()
    {
        editPreset = new PresetDeviceDto();
        isAddingPreset = true;
    }

    private void CancelPreset()
    {
        editPreset = null;
        isAddingPreset = false;
    }

  private async Task SaveChanges()
{
    if (selected is null || editDevice is null) return;

    try
    {
        await DeviceService.UpdateUserDeviceAsync(editDevice);

        int selectedId = selected.Id;
        userdevices = (await DeviceService.GetUserDevicesAsync()).ToList();
        UserDeviceDto? updated = userdevices.FirstOrDefault(device => device.Id == selectedId);
        if (updated is not null)
            Select(updated);

        NotificationService.SuccessNotification($"Device: \"{updated?.Nickname}\" updated successfully.");
    }
    catch (Exception ex)
    {
        NotificationService.ErrorNotification($"Error updating device: {ex.Message}");
    }
}

    private async Task SavePreset()
    {
        if (selected is null || editPreset is null) return;

        try
        {
            if (isAddingPreset)
            {
                int selectedDeviceId = selected.Id;
                await DeviceService.CreatePresetAsync(selectedDeviceId, editPreset);
                userdevices = (await DeviceService.GetUserDevicesAsync()).ToList();
                selected = userdevices.FirstOrDefault(device => device.Id == selectedDeviceId);
                NotificationService.SuccessNotification($"Preset: \"{editPreset.PresetName}\" added successfully to device: \"{selected?.Nickname}\".");
            }
            else
            {
                await DeviceService.UpdatePresetAsync(selected.Id, editPreset);
                PresetDeviceDto? existingPreset = selected.Presets.First(preset => preset.Id == editPreset.Id);
                existingPreset.ConsumptionInKwh = editPreset.ConsumptionInKwh;
                existingPreset.DurationInMinutes = editPreset.DurationInMinutes;
                NotificationService.SuccessNotification($"Preset: \"{editPreset.PresetName}\" updated successfully for device: \"{selected.Nickname}\".");
            }

            editPreset = null;
        }
        catch (Exception ex)
        {
            NotificationService.ErrorNotification($"Error saving preset: {ex.Message}");
        }
    }

    private async Task DeleteUserDevice(int userDeviceId)
    {
        var device = userdevices.FirstOrDefault(item => item.Id == userDeviceId);
        if (device is null || isDeleting) return;
        if (!await deleteConfirmation.ShowAsync("Delete device?",
            $"Delete device \"{device.Nickname}\"? This cannot be undone.", "Delete device")) return;

        isDeleting = true;
        try
        {
            previouslySelectedDeviceName = device.Nickname;
            await DeviceService.DeleteUserDeviceAsync(userDeviceId);
            userdevices = (await DeviceService.GetUserDevicesAsync()).ToList();
            selected = userdevices.FirstOrDefault();
            editDevice = selected is not null ? new UpdateUserDeviceDto
            {
                Id = selected.Id,
                Nickname = selected.Nickname,
                Icon = selected.Icon,
                IsFavorite = selected.IsFavorite,
                Color = selected.Color,
                Category = selected.Category,
                BatteryCapacityInKwh = selected.BatteryCapacityInKwh,
                ConsumptionInKwh = selected.ConsumptionInKwh,
            } : null;
            NotificationService.SuccessNotification($"Device: \"{previouslySelectedDeviceName}\" deleted successfully.");   
        }
        catch (Exception ex)
        {   
            NotificationService.ErrorNotification($"Error deleting device: {ex.Message}");
        }
        finally { isDeleting = false; }
    }

    private void Cancel()
    {
        if (selected is not null)
        {
            Select(selected);   
        }
    }
    
}

<style>
    .header {
        align-items: center;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        width: 100%;
    }

    .heading h1 {
        color: #222;
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 0.6;
        margin: 0;
    }

    .heading p {
        color: var(--smarthome-muted);
        font-size: 0.70rem;
        line-height: 0.75;
        margin: 0;
    }

    .heading {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .header-actions {
        align-items: center;
        display: flex;
        flex-shrink: 0;
        gap: 0.5rem;
    }

    .appliance-layout {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    .device-list {
        background: #fff;
        border-radius: 1rem;
        border: 1px solid #e5e5e5;
        overflow: hidden;
    }

    .device-item:hover { background: #f5f9fd; }

    .device-item.active {
        background: #deedfc;
        box-shadow: inset -3px 0 0 #0a66c3;
    }

    .device-icon {
        width: 44px; height: 44px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .device-name { font-weight: 600; }

    .device-detail {
        background: #fff;
        border-radius: 1rem;
        border: 1px solid #e5e5e5;
        padding: 2rem;
    }

    .icon-picker { display: flex; flex-wrap: wrap; gap: .5rem; }

    .icon-option {
        width: 44px; height: 44px;
        border-radius: 12px;
        border: 1px solid #ddd;
        background: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.25rem;
    }

    .icon-option:hover { background: #f5f9fd; }

    .icon-option.selected {
        border-color: #0a66c3;
        background: #deedfc;
        color: #0a66c3;
    }

    @@media (max-width: 991.98px) {
        .appliance-layout { grid-template-columns: 1fr; }
    }

    .device-item {
        display: flex;
        align-items: stretch;
        border-bottom: 1px solid #eee;
    }

    .device-main {
        flex: 1;
        display: flex;
        gap: 1rem;
        align-items: center;
        padding: 1rem;
        background: none;
        border: 0;
        text-align: left;
    }

    .device-expand {
        display: flex;
        align-items: center;
        gap: .4rem;
        padding: 0 1rem;
        background: none;
        border: 0;
        color: var(--smarthome-muted);
    }
    .device-expand:hover { color: #0a66c3; }

    .preset-count {
        font-size: .75rem;
        background: #edf2f7;
        border-radius: 999px;
        padding: .1rem .5rem;
    }

    .preset-list { background: #f8fbfe; border-bottom: 1px solid #eee; }

    .preset-item, .preset-add {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: .55rem 1rem .55rem 4.25rem;
        background: none;
        border: 0;
        text-align: left;
        font-size: .9rem;
    }
    .preset-item:hover, .preset-add:hover { background: #edf5fd; }
    .preset-item.active { background: #deedfc; }
    .preset-add { color: #0a66c3; justify-content: flex-start; gap: .25rem; }

    @@media (min-width: 961px) {
        .appliance-layout .device-list {
            position: static;
            min-height: 0;
            overflow-y: auto;
            box-shadow: var(--smarthome-card-shadow);
        }

        .appliance-layout .device-detail {
            min-width: 0;
            min-height: 0;
            overflow-y: auto;
            padding: 1.25rem;
            box-shadow: var(--smarthome-card-shadow);
        }

        .appliance-layout .device-name {
            overflow-wrap: anywhere;
        }

        .appliance-layout .device-detail .form-control {
            background: #faf9f7;
            border-color: var(--smarthome-border);
        }

        .appliance-layout .device-detail .mt-4 {
            display: flex;
            flex-wrap: wrap;
            gap: 0.65rem;
            padding-top: 0.75rem;
            border-top: 1px solid #eeeae5;
        }

        .appliance-layout .device-detail .mt-4 .btn {
            min-width: 6rem;
        }

        .appliance-layout .device-detail small {
            display: block;
            margin-top: 0.45rem;
            font-size: 0.8rem;
        }
    }

    @@media (max-width: 640.98px), (max-width: 960px) and (max-height: 500px) and (pointer: coarse) {
        .appliance-layout {
            grid-template-columns: minmax(0, 1fr);
            gap: 1rem;
        }

        .appliance-layout .device-list,
        .appliance-layout .device-detail,
        .appliance-layout .device-main {
            min-width: 0;
        }

        .appliance-layout .device-detail {
            padding: 1rem;
            overflow-wrap: anywhere;
        }

        .appliance-layout .device-main {
            gap: 0.5rem;
            padding: 0.75rem;
        }

        .appliance-layout .device-name {
            min-width: 0;
            overflow-wrap: anywhere;
        }

        .appliance-layout .device-expand {
            min-width: 44px;
            padding: 0 0.75rem;
        }

        .appliance-layout .preset-item,
        .appliance-layout .preset-add {
            min-height: 44px;
            padding-left: 1rem;
            overflow-wrap: anywhere;
        }

        .appliance-layout .device-detail .mt-4 {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .appliance-layout .device-detail .mt-4 > .btn {
            flex: 1 1 auto;
        }

    }
</style>
