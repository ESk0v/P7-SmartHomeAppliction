@page "/device"
@attribute [Authorize]
@inject SmartHomeApplication.Service.IDeviceService DeviceService
@inject INotificationService NotificationService
@using Utilities.Models
@using global::Shared.Dashboard

<PageTitle>Devices</PageTitle>

<SectionContent SectionName="TopBarActions">
    <div class="header">
        <div class="heading">
            <h1>Device registry</h1>
            <p>@amount devices</p>
        </div>

        <div class="header-actions">
            <NavLink class="nav-link" href="add-device" Match="NavLinkMatch.All">
                <PrimaryButton>
                New device
                </PrimaryButton>
            </NavLink>
        </div>
    </div>

</SectionContent>

<div class="appliance-layout">

    <div class="device-list">
        @if (userdevices.Count == 0)
        {
            <p class="p-3 text-muted">No devices yet.</p>
        }
        @foreach (UserDeviceDto device in userdevices)
{
    bool isExpanded = expandedIds.Contains(device.Id);

    <div class="device-group">
        <div class="device-item @(selected?.Id == device.Id ? "active" : "")">
            <button type="button" class="device-main" @onclick="() => Select(device)">
                <div class="device-icon" style="color: @device.Color;">
                    <i class="bi @ScheduleIcons.Get(device.Icon)"></i>
                </div>
                <div class="device-name">@device.Nickname</div>
            </button>

            @if (device.Category != "Interruptible")
            {
                <button type="button" class="device-expand" title="Presets"
                        @onclick="() => ToggleExpand(device.Id)">
                    <span class="preset-count">@device.Presets.Count</span>
                    <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>
            }
        </div>

        @if (isExpanded && device.Category != "Interruptible")
        {
            <div class="preset-list">
                @foreach (PresetDeviceDto preset in device.Presets)
                {
                    <button type="button"
                            class="preset-item @(selected?.Id == device.Id && editPreset?.Id == preset.Id && !isAddingPreset ? "active" : "")"
                            @onclick="() => OpenPreset(device, preset)">
                        <span>@preset.PresetName</span>
                    </button>
                }
                <button type="button" class="preset-add" @onclick="() => OpenAddPreset(device)">
                    <i class="bi bi-plus"></i> Add preset
                </button>
            </div>
        }
    </div>
}
    </div>

    <div class="device-detail">
        @if (selected is null || editDevice is null)
        {
            <p class="text-muted">Select a device to see its details.</p>
        }
        else if (editPreset is not null)
        {
            <h2 class="h5 mb-4">@(isAddingPreset ? "Add preset" : $"Edit {editPreset.PresetName} preset for {editDevice.Nickname}")</h2>
            <EditForm Model="editPreset" OnValidSubmit="SavePreset">
                <AntiforgeryToken />
                <DataAnnotationsValidator />

                @if (isAddingPreset)
                {
                    <div class="mb-3">
                        <label class="form-label" for="presetName">Preset name</label>
                        <InputText id="presetName" class="form-control" @bind-Value="editPreset.PresetName" />
                        <ValidationMessage For="() => editPreset.PresetName" class="text-danger" />
                    </div>
                }
                else
                {
                    <p class="text-muted">Preset: @editPreset.PresetName</p>
                }
                <div class="mb-3">
                    <label class="form-label" for="presetConsumption">Consumption (kWh)</label>
                    <InputNumber id="presetConsumption" class="form-control" @bind-Value="editPreset.ConsumptionInKwh" />
                    <ValidationMessage For="() => editPreset.ConsumptionInKwh" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="presetDuration">Duration (minutes)</label>
                    <InputNumber id="presetDuration" class="form-control" @bind-Value="editPreset.DurationInMinutes" />
                    <ValidationMessage For="() => editPreset.DurationInMinutes" class="text-danger" />
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">@(isAddingPreset ? "Add preset" : "Save preset")</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelPreset">Cancel</button>
                </div>
            </EditForm>
        }
        else
        {
            <EditForm Model="editDevice" OnValidSubmit="SaveChanges">
                <AntiforgeryToken />
                <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label" for="name">Nickname</label>
                        <InputText id="name" class="form-control" @bind-Value="editDevice.Nickname" />
                        <ValidationMessage For="() => editDevice.Nickname" class="text-danger" />
                    </div>
                        <div class="mb-3">
                        <label class="form-label">Icon</label>
                        <div class="icon-picker">
                            @foreach (var name in iconOptions)
                            {
                                <button type="button"
                                        class="icon-option @(editDevice.Icon == name ? "selected" : "")"
                                        title="@name"
                                        @onclick="() => editDevice.Icon = name">
                                    <i class="bi @ScheduleIcons.Get(name)"></i>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="row g-5 mb-3">
                        <div class="col-auto">
                            <label class="form-label d-block" for="deviceColor">Color</label>
                            <InputText id="deviceColor" type="color" class="form-control form-control-color" @bind-Value="editDevice.Color" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label d-block" for="deviceFavorite">Favorite</label>
                            <input id="deviceFavorite" class="form-check-input" type="checkbox" @bind="editDevice.IsFavorite" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Model</label>
                        <input class="form-control" value="@selected!.Model" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <input class="form-control" value="@selected!.Category" disabled />
                    </div>
                    @if (selected.Category == "Interruptible")
                    {
                        <div class="mb-3">
                            <label class="form-label" for="batteryCapacity">Battery capacity (kWh)</label>
                            <InputNumber id="batteryCapacity" class="form-control" @bind-Value="editDevice.BatteryCapacityInKwh" />
                            <ValidationMessage For="() => editDevice.BatteryCapacityInKwh" class="text-danger" />
                            <small class="text-muted">Shared by devices with the same model.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="deviceConsumption">Consumption (kWh)</label>
                            <InputNumber id="deviceConsumption" class="form-control" @bind-Value="editDevice.ConsumptionInKwh" />
                            <ValidationMessage For="() => editDevice.ConsumptionInKwh" class="text-danger" />
                        </div>
                    }
                <div class="mt-4 d-flex align-items-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button> 
                    <button type="button" class="btn btn-outline-danger ms-auto" @onclick="() => DeleteUserDevice(selected.Id)">Delete</button>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    private static readonly string[] iconOptions =
            Enum.GetNames<DeviceIcon>()
                .Where(n => n != nameof(DeviceIcon.default_icon))
                .ToArray();

    private int amount => userdevices.Count;

    private List<UserDeviceDto> userdevices = new();
    private UserDeviceDto? selected;
    private UpdateUserDeviceDto? editDevice;
    private PresetDeviceDto? editPreset;
    private bool isAddingPreset;

    protected override async Task OnInitializedAsync()
    {
        userdevices = (await DeviceService.GetUserDevicesAsync()).ToList();
        if (userdevices.Count > 0) {
            Select(userdevices.First());
        }       
    }

    private HashSet<int> expandedIds = new();

    private void ToggleExpand(int deviceId)
    {
        if (!expandedIds.Remove(deviceId))
            expandedIds.Add(deviceId);
    }

    private void OpenPreset(UserDeviceDto device, PresetDeviceDto preset)
    {
        Select(device);         
        EditPreset(preset);     
    }

    private void OpenAddPreset(UserDeviceDto device)
    {
        Select(device);
        BeginAddPreset();
    }

    private void Select(UserDeviceDto device)
    {
        selected = device;
        editPreset = null;
        isAddingPreset = false;
        editDevice = new UpdateUserDeviceDto
        {   Id = device.Id,
            Category = device.Category,
            Nickname = device.Nickname,
            Icon = device.Icon,
            IsFavorite = device.IsFavorite,
            Color = device.Color,
            BatteryCapacityInKwh = device.BatteryCapacityInKwh,
            ConsumptionInKwh = device.ConsumptionInKwh,
        };  
    }

    private void EditPreset(PresetDeviceDto preset)
    {
        editPreset = new PresetDeviceDto
        {
            Id = preset.Id,
            PresetName = preset.PresetName,
            ConsumptionInKwh = preset.ConsumptionInKwh,
            DurationInMinutes = preset.DurationInMinutes,
            BatteryCapacityInKwh = preset.BatteryCapacityInKwh
        };
        isAddingPreset = false;
    }

    private void BeginAddPreset()
    {
        editPreset = new PresetDeviceDto();
        isAddingPreset = true;
    }

    private void CancelPreset()
    {
        editPreset = null;
        isAddingPreset = false;
    }

  private async Task SaveChanges()
{
    if (selected is null || editDevice is null) return;

    try
    {
        await DeviceService.UpdateUserDeviceAsync(editDevice);

        int selectedId = selected.Id;
        userdevices = (await DeviceService.GetUserDevicesAsync()).ToList();
        UserDeviceDto? updated = userdevices.FirstOrDefault(device => device.Id == selectedId);
        if (updated is not null)
            Select(updated);

        NotificationService.SuccessNotification($"Device: \"{updated?.Nickname}\" updated successfully.");
    }
    catch (Exception ex)
    {
        NotificationService.ErrorNotification($"Error updating device: {ex.Message}");
    }
}

    private async Task SavePreset()
    {
        if (selected is null || editPreset is null) return;

        try
        {
            if (isAddingPreset)
            {
                var selectedDeviceId = selected.Id;
                await DeviceService.CreatePresetAsync(selectedDeviceId, editPreset);
                userdevices = (await DeviceService.GetUserDevicesAsync()).ToList();
                selected = userdevices.FirstOrDefault(device => device.Id == selectedDeviceId);
                NotificationService.SuccessNotification($"Preset: \"{editPreset.PresetName}\" added successfully to device: \"{selected?.Nickname}\".");
            }
            else
            {
                await DeviceService.UpdatePresetAsync(selected.Id, editPreset);
                var existingPreset = selected.Presets.First(preset => preset.Id == editPreset.Id);
                existingPreset.ConsumptionInKwh = editPreset.ConsumptionInKwh;
                existingPreset.DurationInMinutes = editPreset.DurationInMinutes;
                NotificationService.SuccessNotification($"Preset: \"{editPreset.PresetName}\" updated successfully for device: \"{selected.Nickname}\".");
            }

            editPreset = null;
        }
        catch (Exception ex)
        {
            NotificationService.ErrorNotification($"Error saving preset: {ex.Message}");
        }
    }

    private async Task DeleteUserDevice(int userDeviceId)
    {
        try
        {
            await DeviceService.DeleteUserDeviceAsync(userDeviceId);
            userdevices = (await DeviceService.GetUserDevicesAsync()).ToList();
            selected = userdevices.FirstOrDefault();
            editDevice = selected is not null ? new UpdateUserDeviceDto
            {
                Id = selected.Id,
                Nickname = selected.Nickname,
                Icon = selected.Icon,
                IsFavorite = selected.IsFavorite,
                Color = selected.Color,
                Category = selected.Category,
                BatteryCapacityInKwh = selected.BatteryCapacityInKwh,
                ConsumptionInKwh = selected.ConsumptionInKwh,
            } : null;
            NotificationService.SuccessNotification($"Device: \"{selected?.Nickname}\" deleted successfully.");   
        }
        catch (Exception ex)
        {
            NotificationService.ErrorNotification($"Error deleting device: {ex.Message}");
        }
    }

    private void Cancel()
    {
        if (selected is not null)
        {
            Select(selected);   
        }
    }
    
}

<style>
    .header {
        align-items: center;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        width: 100%;
    }

    .heading h1 {
        color: #222;
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 0.6;
        margin: 0;
    }

    .heading p {
        color: #999;
        font-size: 0.70rem;
        line-height: 0.75;
        margin: 0;
    }

    .heading {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .header-actions {
        align-items: center;
        display: flex;
        flex-shrink: 0;
        gap: 0.5rem;
    }

    @@media (max-width: 640.98px) {
        .header {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.5rem;
        }

        .header-actions {
            width: 100%;
        }
    }

    .appliance-layout {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 1.5rem;
    align-items: start;
    }

    .device-list {
        background: #fff;
        border-radius: 1rem;
        border: 1px solid #e5e5e5;
        overflow: hidden;
    }

    .device-item:hover { background: #f7f7fb; }

    .device-item.active {
        background: #e9e8fb;
        box-shadow: inset -3px 0 0 #7b6ee6;   
    }

    .device-icon {
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
    }

    .device-name { font-weight: 600; }

    .device-detail {    
        background: #fff;
        border-radius: 1rem;
        border: 1px solid #e5e5e5;
        padding: 2rem;
    }
    
    .icon-picker { display: flex; flex-wrap: wrap; gap: .5rem; }

    .icon-option {
        width: 44px; height: 44px;
        border-radius: 12px;
        border: 1px solid #ddd;
        background: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.25rem;
    }

    .icon-option:hover { background: #f7f7fb; }

    .icon-option.selected {
        border-color: #7b6ee6;
        background: #e9e8fb;
        color: #7b6ee6;
    }

    @@media (max-width: 991.98px) {
        .appliance-layout { grid-template-columns: 1fr; }
    }
    
.device-item {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid #eee;
}

.device-main {
    flex: 1;
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
    background: none;
    border: 0;
    text-align: left;
}

.device-expand {
    display: flex;
    align-items: center;
    gap: .4rem;
    padding: 0 1rem;
    background: none;
    border: 0;
    color: #888;
}
.device-expand:hover { color: #7b6ee6; }

.preset-count {
    font-size: .75rem;
    background: #ececf2;
    border-radius: 999px;
    padding: .1rem .5rem;
}

.preset-list { background: #fafafd; border-bottom: 1px solid #eee; }

.preset-item, .preset-add {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: .55rem 1rem .55rem 4.25rem;
    background: none;
    border: 0;
    text-align: left;
    font-size: .9rem;
}
.preset-item:hover, .preset-add:hover { background: #f1f0fb; }
.preset-item.active { background: #e9e8fb; }
.preset-add { color: #7b6ee6; justify-content: flex-start; gap: .25rem; }
</style>
